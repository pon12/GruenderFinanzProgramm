/* Das abgedunkelte Overlay über den ganzen Bildschirm */
.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6); /* Schicker abgedunkelter Hintergrund */
    justify-content: center;
    align-items: center;
    display: none; /* Wird vom Skript auf Flex gesetzt */
}

/* Das eigentliche Fenster in der Mitte */
.popup-container {
    width: 450px;
    max-height: 80%; /* Verhindert, dass das Popup aus dem Screen fliegt */
    background-color: #ffffff; /* Nutze hier die Farbe deines Erstellen-Popups */
    border-radius: 12px;
    padding: 20px;
    border-width: 1px;
    border-color: #cccccc;
}

/* Der Header-Bereich für Titel und Schließen-Button */
.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-color: #e0e0e0;
    padding-bottom: 10px;
}

/* Der Titel im Popup */
.popup-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #333333;
}

/* Der Schließen/Zurück-Button oben rechts im Popup */
.btn-close {
    background-color: transparent;
    border-width: 0;
    font-size: 16px;
    color: #888888;
    cursor: link;
}

.btn-close:hover {
    color: #ff3333; /* Wird rot beim Hovern */
}

/* Bereich für die Scroll-Anzeige */
.detail-scroll-view {
    flex-grow: 1;
    margin-top: 5px;
}

/* --- DIESE KLASSEN WERDEN DYNAMISCH VOM CODE GENUTZT --- */

/* Eine Zeile in der Liste (Dokument + Minus-Button) */
.list-row-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-bottom-color: #f0f0f0;
}

/* Der kleine rote Minus-Button */
.btn-minus-delete {
    background-color: #ff4d4d;
    color: white;
    border-radius: 4px;
    border-width: 0;
    padding: 4px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    cursor: link;
}

.btn-minus-delete:hover {
    background-color: #ff1a1a;
}

/* Erweitere deine bestehende Klasse für das Label in der Liste */
.list-row-item Label {
    color: #ffffff; /* Macht die Schrift reinweiß */
    font-size: 13px;
    
    /* Zuweisung der Schriftart Poppins-Bold */
    /* Hinweis: Der Pfad muss auf dein Font-Asset (.ttf/.otf) oder das generierte Font Asset verweisen */
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf"); 
    -unity-font-style: bold;
}

/* Falls du das leere "Noch keine Dokumente erstellt"-Label auch weiß/Poppins haben willst: */
.list-empty-label {
    color: #ffffff;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf");
    -unity-font-style: bold;
    text-anchor: middle-center;
    margin-top: 20px;
}