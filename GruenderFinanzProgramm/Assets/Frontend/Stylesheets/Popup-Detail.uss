/* =========================================================================
   1. LAYOUT & BREITE FÜR DAS ZWEISPALTYGE LISTEN-POPUP (DETAIL)
   ========================================================================= */

/* Verdunkelter Vollbild-Hintergrund */
#Detail-Popup-Overlay, #Edit-Popup-Overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    display: none; 
}

/* Hauptfenster: Schön breit für zwei Spalten */
.detail-popup-box {
    width: 1050px; 
    height: 580px;
    background-color: #1a1a1a;
    border-radius: 12px;
    padding: 24px;
    justify-content: space-between;
    border-width: 1px;
    border-color: #2d2d2d;
}

/* Header-Zeile */
.popup-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d2d;
    padding-bottom: 12px;
}

.popup-title-text {
    font-size: 20px;
    color: #ffffff;
    -unity-font-style: bold;
}

.btn-close-style {
    background-color: transparent;
    color: #888888;
    border-width: 0;
    font-size: 18px;
    cursor: pointer;
}
.btn-close-style:hover {
    color: #ffffff;
}

/* Das zweispaltige Layout nebeneinander */
.split-body-layout {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 16px;
    margin-bottom: 16px;
}

.column-half {
    width: 50%;
    padding-left: 12px;
    padding-right: 12px;
}

.column-header-title {
    font-size: 14px;
    color: #aaaaaa;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

/* Die schwarzen Listen-Boxen (Mit automatischem Scrollen) */
.scroll-list-box {
    flex-grow: 1;
    background-color: #111111;
    border-radius: 8px;
    padding: 10px;
    border-width: 1px;
    border-color: #252525;
    overflow: scroll; 
}

/* Grüne Erstell-Schaltfläche ganz unten */
.btn-create-footer {
    background-color: #27ae60;
    color: #ffffff;
    border-radius: 6px;
    padding: 12px;
    font-size: 14px;
    border-width: 0;
    -unity-font-style: bold;
}
.btn-create-footer:hover {
    background-color: #2ecc71;
}

/* =========================================================================
   2. RECHTE SEITE: "HINZUFÜGEN"-BUTTON (DESIGN-TREU)
   ========================================================================= */

.btn-add-global {
    background-color: transparent;
    color: #2ecc71;             /* Grüner Text */
    border-color: #2ecc71;       /* Grüner Rahmen */
    border-width: 1px;
    border-radius: 15px;        /* Schön rundgelutschte Pillen-Form */
    padding: 4px 14px;
    font-size: 12px;
    -unity-font-style: bold;
    cursor: pointer;
    transition: background-color 0.1s ease;
}

.btn-add-global:hover {
    background-color: rgba(46, 204, 113, 0.15); /* Dezentes Aufleuchten beim Hover */
    color: #ffffff;
    border-color: #ffffff;
}

/* =========================================================================
   3. LINKE SEITE: GRAFIK-BUTTONS (STIFT & MÜLLTONNE)
   ========================================================================= */

.list-row-item {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #222222;
    padding: 8px 12px;
    margin-bottom: 8px;
    border-radius: 6px;
    height: 45px;               /* Feste Zeilenhöhe für Stabilität */
}
.list-row-item:hover {
    background-color: #2a2a2a;
}

.row-btn-group {
    flex-direction: row;
    align-items: center;
}

/* FIX: Echte quadratische Größe für die Icons im UI Toolkit */
.btn-action-icon {
    background-color: transparent;
    border-width: 0;
    width: 22px;               
    height: 22px;
    margin-left: 12px;
    padding: 0;
    cursor: pointer;
    -unity-background-scale-mode: scale-to-fit; /* Behebt das "Minus-Verzerrungs"-Problem! */
}

/* Der Stift-Button */
.btn-edit-pen {
    background-image: resource("icons/edit"); 
    -unity-background-image-tint-color: #ffffff;
}
.btn-edit-pen:hover {
    -unity-background-image-tint-color: #f1c40f; 
}

/* Die rote Mülltonne */
.btn-minus-delete {
    background-image: resource("icons/rot müll"); 
    -unity-background-image-tint-color: #ffffff;
}
.btn-minus-delete:hover {
    -unity-background-image-tint-color: #e74c3c; 
}

/* =========================================================================
   4. LAYOUT FÜR DAS BEARBEITEN-POPUP (EDIT) - EXTRA BREIT
   ========================================================================= */

.edit-popup-box {
    width: 900px;              
    height: 600px;             
    background-color: #1a1a1a;
    border-radius: 12px;
    padding: 24px;
    justify-content: space-between;
    border-width: 1px;
    border-color: #333333;
}

/* Das große Textfeld im Zentrum */
.input-field-style {
    flex-grow: 1;              
    margin-top: 16px;
    margin-bottom: 16px;
    min-height: 350px;         
}

/* Das innere Eingabefeld der Textbox stylen */
.input-field-style .unity-text-field__input {
    background-color: #0d0d0d; 
    border-color: #2a2a2a;
    border-radius: 6px;
    padding: 12px;
    color: #ffffff;
    font-size: 14px;
    -unity-text-align: upper-left; 
}

/* Zeile für die drei Vorlagen-Buttons */
.type-button-group {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 20px;
}

.type-btn {
    flex-grow: 1;
    background-color: #2a2a2a;
    color: #ffffff;
    margin: 0 4px;
    padding: 8px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #444444;
    -unity-font-style: bold;
}

/* Untere Button-Zeile für Abbrechen/Speichern */
.edit-footer-buttons {
    flex-direction: row;
    justify-content: flex-end; 
    margin-top: 12px;
}

.btn-action-submit {
    background-color: #27ae60; 
    color: white;
    padding: 10px 24px;
    border-radius: 6px;
    border-width: 0;
    -unity-font-style: bold;
    margin-left: 12px;
}
.btn-action-submit:hover {
    background-color: #2ecc71;
}

.btn-action-cancel {
    background-color: #333333; 
    color: #aaaaaa;
    padding: 10px 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #444444;
}
.btn-action-cancel:hover {
    color: #ffffff;
    background-color: #444444;
}