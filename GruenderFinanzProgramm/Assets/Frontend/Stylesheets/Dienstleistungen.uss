.page-title {
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin: 8px;
}

.add-btn {
    background-color: rgb(128, 207, 149);
    color: rgb(0, 0, 0);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    border-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    height: 44px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 16px;
    align-self: flex-end;
}

.add-btn:hover {
    background-color: rgb(179, 226, 196);
}

.add-btn:active {
    background-color: rgb(102, 165, 11);
}

.tabelle-wrapper {
    flex-grow: 1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(142, 141, 141);
    overflow: hidden;
}

.tabelle-header {
    flex-direction: row;
    background-color: rgb(0, 0, 0);
    padding-top: 16px;
    padding-bottom: 16px;
}

.tabelle-header-zelle {
    color: rgb(128, 207, 149);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    -unity-text-align: middle-left;
}

.tabelle-zeile {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-width: 2px;
    border-color: rgb(60, 60, 60);
    background-color: rgb(38, 38, 38);
    border-radius: 8px;
}

.tabelle-zeile:hover {
    background-color: rgb(50, 50, 50);
    border-width: 2px;
    border-color: rgb(128, 207, 149);
}

.tabelle-zelle {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    overflow: hidden;
    padding-right: 8px;
}

.col-titel {
    width: 20%;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding: 0;
}

.col-beschreibung {
    width: 35%;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    white-space: normal;
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding: 0;
}

.col-preismodell {
    width: 15%;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding: 0;
}

.col-betrag {
    width: 15%;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding: 0;
}

.col-aktionen {
    width: 15%;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 8px;
    margin-left: 0;
    padding: 0;
}

.zeile-btn-bearbeiten {
    flex-grow: 0;
    height: 32px;
    border-radius: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    color: rgb(0, 0, 0);
    background-color: rgb(128, 207, 149);
    margin-right: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

.zeile-btn-bearbeiten:hover {
    background-color: rgb(179, 226, 196);
}

.zeile-btn-loeschen {
    background-color: rgb(230, 57, 70);
    color: rgb(255, 255, 255);
    margin-right: 0;
}

.zeile-btn-loeschen:hover {
    background-color: rgb(229, 103, 112);
}

.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}

.popup-box {
    width: 600px;
    background-color: rgb(38, 38, 38);
    border-radius: 16px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: rgb(128, 207, 149);
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 36px;
    padding-right: 36px;
}

.popup-titel {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 20px;
}

.popup-label {
    font-size: 14px;
    color: rgb(160, 160, 160);
    margin-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
}

.popup-input {
    height: 40px;
    margin-bottom: 16px;
    border-radius: 6px;
    border-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.popup-input > .unity-base-field__input {
    background-color: rgb(55, 55, 55);
    border-color: rgb(80, 80, 80);
    border-radius: 6px;
    color: rgb(255, 255, 255);
}

.popup-dropdown {
    height: 40px;
    margin-bottom: 14px;
    border-radius: 6px;
    border-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    font-size: 15px;
}

.popup-dropdown > .unity-base-field__input {
    background-color: rgb(80, 80, 80);
    border-color: rgb(80, 80, 80);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    padding-left: 8px;
    margin-left: 0;
}

.popup-btn-fertig {
    background-color: #80CF95;
    color: rgb(0, 0, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    height: 50px;
    margin-top: 8px;
    width: 50%;
}

.popup-btn-fertig:hover {
    background-color: #B3E2C4;
}

.popup-btn-fertig:active {
    background-color: #66A577;
}

.popup-btn-abbrechen {
    background-color: #646464;
    color: rgb(0, 0, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    height: 50px;
    margin-top: 8px;
    width: 50%;
}

.popup-btn-abbrechen:hover {
    background-color: #8E8D8D
}

.popup-btn-abbrechen:active {
    background-color: #383636
}

.popup-box {
    position: relative;
}

.close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(100, 100, 100);
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.close-btn:hover {
    color: rgb(229, 103, 112);
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
}

/* =========================================================
   CONFIRM SPEICHERN POPUP  (basiert auf gespeichert.uxml)
   ========================================================= */

.confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.confirm-box {
    width: 340px;
    background-color: rgb(56, 56, 56);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    padding-top: 32px;
    padding-bottom: 28px;
    padding-left: 28px;
    padding-right: 28px;
    position: relative;
}

.confirm-titel {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 8px;
}

.confirm-text {
    font-size: 14px;
    color: rgb(200, 200, 200);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
    white-space: normal;
}

.confirm-btn-ja {
    flex-grow: 1;
    height: 44px;
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(128, 207, 149);
    color: rgb(0, 0, 0);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-left: 8px;
}

.confirm-btn-ja:hover {
    background-color: rgb(179, 226, 196);
}

.confirm-btn-ja:active {
    background-color: rgb(102, 165, 119);
}

.confirm-btn-nein {
    flex-grow: 1;
    height: 44px;
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(100, 100, 100);
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

.confirm-btn-nein:hover {
    background-color: rgb(142, 141, 141);
}

.confirm-btn-nein:active {
    background-color: rgb(56, 54, 54);
}
