.page-title {
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin: 8px;
}

.add-btn {
    background-color: rgb(128, 207, 149);
    color: rgb(0, 0, 0);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    border-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    height: 44px;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 16px;
    align-self: flex-end;
}

.tabelle-wrapper {
    flex-grow: 1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: rgb(60, 60, 60);
    overflow: hidden;
}

.tabelle-header {
    flex-direction: row;
    background-color: rgb(30, 30, 30);
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 8px;
    padding-right: 8px;
}

.tabelle-header-zelle {
    color: rgb(128, 207, 149);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    -unity-text-align: middle-left;
}

.tabelle-zeile {
    flex-direction: row;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-color: rgb(60, 60, 60);
    background-color: rgb(38, 38, 38);
}

.tabelle-zeile:hover {
    background-color: rgb(50, 50, 50);
}

.tabelle-zelle {
    color: rgb(220, 220, 220);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
}

.col-titel {
    width: 20%;
    flex-shrink: 0;
    -unity-text-align: upper-center;
}

.col-beschreibung {
    width: 35%;
    flex-shrink: 0;
    -unity-text-align: upper-center;
}

.col-preismodell {
    width: 15%;
    flex-shrink: 0;
}

.col-betrag {
    width: 15%;
    flex-shrink: 0;
}

.col-aktionen {
    width: 15%;
    flex-shrink: 0;
    flex-direction: row;
}

.zeile-btn {
    flex-grow: 1;
    height: 32px;
    border-radius: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    color: rgb(0, 0, 0);
    background-color: rgb(128, 207, 149);
    margin-right: 4px;
}

.zeile-btn-loeschen {
    background-color: rgb(207, 80, 80);
    color: rgb(255, 255, 255);
    margin-right: 0;
}

.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    align-items: center;
    justify-content: center;
}

.popup-box {
    width: 600px;
    background-color: rgb(38, 38, 38);
    border-radius: 16px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: rgb(128, 207, 149);
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 36px;
    padding-right: 36px;
}

.popup-titel {
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 20px;
}

.popup-label {
    font-size: 14px;
    color: rgb(160, 160, 160);
    margin-bottom: 4px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
}

.popup-input {
    height: 40px;
    margin-bottom: 14px;
    background-color: rgb(55, 55, 55);
    border-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.popup-dropdown {
    height: 40px;
    margin-bottom: 14px;
    background-color: rgb(55, 55, 55);
    border-radius: 6px;
    border-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    font-size: 15px;
}

.popup-btn-fertig {
    background-color: rgb(128, 207, 149);
    color: rgb(0, 0, 0);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    height: 50px;
    margin-top: 8px;
}
