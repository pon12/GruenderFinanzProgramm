/* Spalten-/Zeilen-Basisdesign kommt jetzt einheitlich aus Export.uss
   (.tabelle-zeile, .tabelle-zelle, .col-bezeichnung usw.) - hier nur noch
   die Export-spezifischen Steuerelemente (Dropdown, Ordner-Button). */

.format-dropdown {
    background-color: rgb(44, 44, 46);
    border-color: rgb(58, 58, 60);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    height: 32px;
}

.btn-folder {
    width: 36px;
    height: 36px;
    background-color: rgb(44, 44, 46);
    border-radius: 8px;
    margin-right: 12px;
    border-width: 0;
}

.btn-folder:hover {
    background-color: rgb(58, 58, 60);
}
