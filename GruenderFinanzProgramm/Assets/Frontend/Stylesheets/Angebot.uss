/* =============================================
   Angebot.uss
   Stylesheet für den Angebots-Screen
   ============================================= */

/* Karten-Grundstil */
.angebot-card {
    background-color: rgb(38, 38, 38);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(55, 55, 55);
    border-right-color: rgb(55, 55, 55);
    border-bottom-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    transition-property: border-color;
    transition-duration: 0.15s;
}

.angebot-card:hover {
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Adressboxen innerhalb der Partnerkarte */
.angebot-address-box {
    background-color: rgb(50, 50, 50);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(65, 65, 65);
    border-right-color: rgb(65, 65, 65);
    border-bottom-color: rgb(65, 65, 65);
    border-left-color: rgb(65, 65, 65);
}

/* Tabellenheader-Zeile */
.angebot-table-header {
    flex-direction: row;
    background-color: rgb(50, 50, 50);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 4px;
}

/* Positionszeilen */
.angebot-position-row {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(50, 50, 50);
}

.angebot-position-row:hover {
    background-color: rgb(44, 44, 44);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Tabellenspalten-Breiten */
.angebot-col-artikel {
    width: 140px;
    flex-shrink: 0;
}

.angebot-col-beschreibung {
    flex: 1;
    overflow: hidden;
}

.angebot-col-menge {
    width: 55px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.angebot-col-einheit {
    width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.angebot-col-preis {
    width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.angebot-col-gesamt {
    width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* Aktionsbuttons */
.angebot-btn-primary {
    background-color: rgb(128, 207, 149);
    color: rgb(20, 20, 20);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.angebot-btn-primary:hover {
    background-color: rgb(179, 226, 196);
}
.angebot-btn-primary:active {
    background-color: rgb(102, 165, 119);
}

.angebot-btn-secondary {
    background-color: rgb(100, 100, 100);
    color: rgb(20, 20, 20);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.angebot-btn-secondary:hover {
    background-color: rgb(142, 141, 141);
}
.angebot-btn-secondary:active {
    background-color: rgb(56, 54, 54);
}

.rechnung-btn-primary {
    background-color: rgb(75, 158, 102);
    color: rgb(20, 20, 20);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.rechnung-btn-primary:hover {
    background-color: rgb(110, 186, 134);
}

.rechnung-btn-primary:active {
    background-color: rgb(38, 140, 71);
}


.angebot-btn-danger {
    background-color: rgb(230, 57, 70);
    color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 14px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.angebot-btn-danger:hover {
    background-color: rgb(229, 103, 112);
}
.angebot-btn-danger:active {
    background-color: rgb(243, 6, 24);
}


/* TextField Eingabebereich */
.unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Dropdown Eingabebereich */
.unity-base-popup-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    color: rgb(255, 255, 255);
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Multiline TextField */
.unity-text-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    color: rgb(255, 255, 255);
    padding-left: 10px;
    padding-top: 8px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}