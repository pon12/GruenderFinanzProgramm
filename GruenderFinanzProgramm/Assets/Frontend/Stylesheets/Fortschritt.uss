/* =============================================
   Fortschritt.uss
   ============================================= */

#root-container, Label, Button {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.page-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 4px;
}
.page-subtitle {
    font-size: 14px;
    color: rgb(160, 160, 160);
}
.gesamt-prozent-label {
    font-size: 28px;
    color: rgb(128, 207, 149);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* SEGMENTIERTER BALKEN – identisch zu Dashboard */
.progress-section {
    margin-bottom: 24px;
    flex-grow: 0;
    flex-shrink: 0;
}
.progress-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}
.section-title {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.progress-percent {
    color: rgb(128, 207, 149);
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.progress-segments-row {
    flex-direction: row;
    justify-content: space-between;
}
.progress-segment-wrap {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    align-items: stretch;
}
.seg-bg {
    height: 10px;
    background-color: rgb(68, 68, 68);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 5px;
}
.seg-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 5px;
}
.seg-label {
    color: rgb(136, 136, 136);
    font-size: 10px;
    -unity-text-align: middle-center;
}

/* PANEL BOX – Hintergrundbox für mittlere Reihe und Erfolge */
.panel-box {
    background-color: rgb(44, 44, 44);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 18px 20px;
}
.panel-title {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* PHASEN-KARTE */
.phase-karte {
    background-color: rgb(38, 38, 38);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 12px 14px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}
.phase-karte:hover {
    border-color: rgb(128, 207, 149);
}
.phase-karte--komplett {
    border-color: rgb(128, 207, 149);
    background-color: rgba(128, 207, 149, 0.06);
}
.phase-icon {
    font-size: 18px;
    width: 34px;
    height: 34px;
    -unity-text-align: middle-center;
    background-color: rgb(55, 55, 55);
    border-radius: 8px;
    margin-right: 12px;
    flex-shrink: 0;
}
.phase-info {
    flex-grow: 1;
    flex-direction: column;
}
.phase-name {
    font-size: 13px;
    color: rgb(220, 220, 220);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 5px;
}
.phase-mini-bar-bg {
    height: 4px;
    background-color: rgb(60, 60, 60);
    border-radius: 2px;
    overflow: hidden;
}
.phase-mini-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 2px;
}
.phase-prozent {
    font-size: 12px;
    color: rgb(128, 207, 149);
    margin-left: 12px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* NÄCHSTE SCHRITTE */
.schritt-offen-row {
    background-color: rgb(38, 38, 38);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 12px 14px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}
.schritt-offen-bullet {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(128, 207, 149);
    flex-shrink: 0;
    margin-right: 12px;
}
.schritt-offen-text {
    flex-grow: 1;
    flex-direction: column;
}
.schritt-offen-titel {
    font-size: 13px;
    color: rgb(210, 210, 210);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.schritt-offen-phase {
    font-size: 11px;
    color: rgb(130, 130, 130);
    margin-top: 2px;
}

/* LETZTE ERFOLGE */
.erfolg-chip {
    background-color: rgb(38, 38, 38);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(128, 207, 149);
    padding: 12px 16px;
    margin-right: 12px;
    margin-bottom: 12px;
    flex-direction: row;
    align-items: center;
    min-width: 180px;
}
.erfolg-chip-icon {
    font-size: 20px;
    margin-right: 10px;
    flex-shrink: 0;
}
.erfolg-chip-text {
    flex-direction: column;
    flex-grow: 1;
}
.erfolg-chip-titel {
    font-size: 12px;
    color: rgb(220, 220, 220);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.erfolg-chip-kat {
    font-size: 10px;
    color: rgb(128, 207, 149);
    margin-top: 2px;
}
