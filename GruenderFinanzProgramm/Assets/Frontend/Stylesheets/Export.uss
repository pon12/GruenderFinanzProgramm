.content-area {
    flex-grow: 1;
    background-color: rgb(28, 28, 30);
    padding: 40px;
}

.screen-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
}

.table-header {
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.header-label {
    color: rgb(142, 142, 147);
    font-size: 14px;
    -unity-font-style: bold;
}

.col-bezeichnung {
    flex-basis: 28%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-art {
    flex-basis: 16%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-datum {
    flex-basis: 14%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-format {
    flex-basis: 12%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-pfad {
    flex-basis: 30%;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

/* ============================================
   EINHEITLICHES TABELLEN-DESIGN
   (identisch zu Dienstleistungen/Kassenbuch/Buchhaltung,
   damit alle Tabellen in der App gleich aussehen)
   ============================================ */
.tabelle-wrapper {
    flex-grow: 1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: #3c3c3c;
    overflow: hidden;
}

.tabelle-header {
    flex-direction: row;
    background-color: rgb(44, 44, 44);
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 20px;
    padding-right: 20px;
}

.tabelle-header-zelle {
    color: #80CF95;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.tabelle-zeile {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 20px;
    border-top-width: 2px;
    border-color: #3c3c3c;
    background-color: #262626;
}

.tabelle-zeile:hover {
    background-color: #313131;
    border-width: 2px;
    border-color: #80CF95;
}

.tabelle-zelle {
    color: #FFFFFF;
    font-size: 14px;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    overflow: hidden;
}

.zeile-btn-bearbeiten {
    flex-grow: 0;
    height: 32px;
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    background-color: #80CF95;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
}
.zeile-btn-bearbeiten:hover {
    background-color: #B3E2C4;
}

