/* Einstellungen.uss */

/* Eingabefelder – dunkler als Cards fuer Kontrast */
.dark-input .unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.dark-input .unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.dark-input .unity-text-field__input {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

/* Dropdown */
.dark-input .unity-base-dropdown__input {
    background-color: rgb(70, 70, 70);
    border-width: 0;
    color: rgb(255, 255, 255);
}

/* Toggle */
.unity-toggle__label {
    color: rgb(240, 240, 240);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.unity-toggle__checkmark {
    background-color: rgb(70, 70, 70);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
    border-left-color: rgb(50, 50, 50);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/* ScrollView transparent */
.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(90, 90, 90);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(80, 80, 80);
}

/* Alle Labels Poppins */
.unity-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}