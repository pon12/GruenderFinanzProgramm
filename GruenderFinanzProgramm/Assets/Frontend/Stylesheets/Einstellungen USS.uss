/* Einstellungen.uss */
/* Eingabefelder und Dropdowns */

.unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.unity-text-field__input {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

/* Hoehere Spezifitaet fuer dark-input Klasse */

.dark-input .unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.dark-input .unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.dark-input .unity-text-field__input {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

/* Dropdown Popup */

.unity-base-dropdown__item {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(90, 90, 90);
}

/* Toggle Label */

.unity-toggle__label {
    color: rgb(240, 240, 240);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Toggle Checkbox Basis */

.unity-toggle__checkmark {
    background-color: rgb(70, 70, 70);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(100, 100, 100);
    border-right-color: rgb(100, 100, 100);
    border-bottom-color: rgb(100, 100, 100);
    border-left-color: rgb(100, 100, 100);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

/* Toggle Hover */

.unity-toggle:hover .unity-toggle__checkmark {
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Toggle Checked */

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(128, 207, 149);
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ScrollView transparent */

.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(100, 100, 100);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(80, 80, 80);
}

/* Alle Labels Poppins */

.unity-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Textfelder – grüner Rahmen beim Hovern */

.unity-base-field:hover .unity-base-field__input {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    transition-property: border-color;
    transition-duration: 0.1s;
}

/* Graue Buttons – grün beim Hovern */

.unity-button:hover {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
}

/* Graue Buttons – leicht grüner Schimmer beim Hovern */

.unity-button:hover {
    background-color: rgb(90, 90, 90);
}

/* Aktiver Klick – Button etwas dunkler */

.unity-button:active {
    background-color: rgb(60, 60, 60);
    translate: 0 1px;
}

/* Grüne Buttons bleiben beim Hovern grün aber heller */

.unity-button:hover {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.05);
}