/* Einstellungen USS */

/* Eingabefelder und Dropdowns */

.unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.unity-text-field__input {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

/* Hoehere Spezifitaet fuer dark-input Klasse */

.dark-input .unity-base-field__input {
    background-color: rgb(70, 70, 70);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
}

.dark-input .unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.dark-input .unity-text-field__input {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

/* Dropdown Popup */

.unity-base-dropdown__item {
    background-color: rgb(70, 70, 70);
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(90, 90, 90);
}

/* ScrollView transparent */

.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(100, 100, 100);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(80, 80, 80);
}

/* Alle Labels Poppins */

.unity-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Textfelder – gruener Rahmen beim Hovern */

.unity-base-field:hover .unity-base-field__input {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    transition-property: border-color;
    transition-duration: 0.1s;
}

/* Graue Buttons – heller Hintergrund beim Hovern, kein Rahmen */

.btn-grey {
    background-color: rgb(100, 100, 100);
    color: rgb(200, 200, 200);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.btn-grey:hover {
    background-color: rgb(142, 141, 141);
}

.btn-orange {
    background-color: rgb(255, 165, 60);
    color: rgb(0, 0, 0);
    border-width: 0;
}

.btn-orange:hover {
    background-color: rgb(243, 192, 132);
}

.btn-red {
    background-color: rgb(230, 57, 70);
    color: rgb(255, 255, 255);
    border-width: 0;
}

.btn-red:hover {
    background-color: rgb(229, 103, 112);
}

.btn-steuer {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: border-color;
    transition-duration: 0.1s;
}

.btn-steuer:hover {
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}



/* Toggle – zweispaltige Zeile: Label links, Checkbox rechts */

.unity-toggle {
    flex-direction: row;
    align-items: center;
    background-color: rgb(50, 50, 50);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    margin-top: 0;
    margin-bottom: 8px;
    margin-left: 0;
    margin-right: 0;
    flex-grow: 1;
    border-width: 0;
}

/* Internes Input-Element – Klickflaeche ohne visuelles Styling */

.unity-toggle > .unity-toggle__input {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    flex-shrink: 0;
    flex-grow: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: auto;
    margin-right: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* Sichtbare Checkbox */

.unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgb(70, 70, 70);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(100, 100, 100);
    border-right-color: rgb(100, 100, 100);
    border-bottom-color: rgb(100, 100, 100);
    border-left-color: rgb(100, 100, 100);
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.unity-toggle:hover .unity-toggle__checkmark {
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(128, 207, 149);
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Toggle-Label */

.unity-toggle__label {
    flex-grow: 1;
    white-space: normal;
    color: rgb(240, 240, 240);
    font-size: 15px;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}
