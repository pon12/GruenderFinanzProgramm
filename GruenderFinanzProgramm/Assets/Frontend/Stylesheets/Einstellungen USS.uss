/* Einstellungen.uss */
/* Eingabefelder dunkel mit Poppins */

/* TextField und DropdownField Eingabebereich */
.unity-base-field__input {
    background-color: rgb(50, 50, 50);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
    padding-left: 10px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Fokus Rahmen gruen */
.unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Multiline TextField */
.unity-text-field__input {
    background-color: rgb(50, 50, 50);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(200, 200, 200);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Dropdown Pfeil Bereich */
.unity-base-dropdown__input {
    background-color: rgb(50, 50, 50);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(255, 255, 255);
}

/* Dropdown Popup Liste */
.unity-base-dropdown__item {
    background-color: rgb(50, 50, 50);
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.unity-base-dropdown__item:hover {
    background-color: rgb(70, 70, 70);
}

/* Toggle Checkbox */
.unity-toggle__checkmark {
    background-color: rgb(50, 50, 50);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(100, 100, 100);
    border-right-color: rgb(100, 100, 100);
    border-bottom-color: rgb(100, 100, 100);
    border-left-color: rgb(100, 100, 100);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(128, 207, 149);
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Toggle Label */
.unity-toggle__label {
    color: rgb(220, 220, 220);
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* Alle Labels Poppins */
.unity-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* ScrollView Hintergrund */
.unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgba(0, 0, 0, 0);
}

/* Scrollbar Styling */
.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(80, 80, 80);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(40, 40, 40);
}
