/* PopupDienstleistungen.uss */

/* Eingabefelder – Hintergrund grau, weisser Text */
.unity-text-field .unity-base-field__input,
.unity-base-text-field .unity-base-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

/* Multiline TextField */
.unity-text-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
}

/* Dropdown */
.unity-base-dropdown .unity-base-field__input,
.unity-base-field__input {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* Fokus – gruener Rand */
.unity-base-field__input:focus {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
}

/* Dropdown Popup Liste */
.unity-base-dropdown__item {
    background-color: rgb(56, 56, 56);
    color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(70, 70, 70);
}