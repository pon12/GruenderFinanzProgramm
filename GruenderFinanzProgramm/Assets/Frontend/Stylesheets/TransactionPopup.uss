/* =====================================================
   TransactionPopup.uss  –  Kassenbuch komplett neu
   ===================================================== */

/* Schriftart global */
#root, Label, Button, TextField, DropdownField, .unity-text-element {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* =====================================================
   TABELLE
   Aufbau: .table-wrapper > .row > .cell
   Jede .row ist eine flex-direction: row.
   Jede .cell ist ein festes proportionales Stück davon.
   ===================================================== */

.table-wrapper {
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(91, 91, 91);
    border-right-color: rgb(91, 91, 91);
    border-bottom-color: rgb(91, 91, 91);
    border-left-color: rgb(91, 91, 91);
    margin-top: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    flex-grow: 1;
}

/* Jede Zeile: horizontal, keine Umbrüche */
.row {
    flex-direction: row;
    flex-wrap: nowrap;
    width: 100%;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
    background-color: rgb(45, 45, 45);
}

.row-header {
    background-color: rgb(44, 44, 44);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(91, 91, 91);
}

/* Basis-Zelle: alle Zellen erben dies */
.cell {
    /* Text zentriert */
    -unity-text-align: middle-center;
    /* Vertikale Zentrierung im Parent */
    align-self: center;
    /* Keine Umbrüche – überlanger Text wird abgeschnitten */
    overflow: hidden;
    /* Einheitliches Padding */
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 6px;
    padding-right: 6px;
    /* Text-Größe */
    font-size: 15px;
    color: rgb(220, 220, 220);
}

/* Header-Zellen etwas heller/fetter */
.row-header .cell {
    font-size: 15px;
    color: rgb(255, 255, 255);
    padding-top: 12px;
    padding-bottom: 12px;
}

/* ---- Spaltenbreiten ---- 
   Summe flex-grow: 2 + 1.5 + 1 + 1.5 + 1.5 + 0(fix) = 7.5
   col-action ist fix 44px damit der Button immer passt */
.cell-name   { flex-grow: 2;   flex-shrink: 1; flex-basis: 0; }
.cell-datum  { flex-grow: 1;   flex-shrink: 1; flex-basis: 0; }
.cell-betrag { flex-grow: 1;   flex-shrink: 1; flex-basis: 0; }
.cell-art    { flex-grow: 1;   flex-shrink: 1; flex-basis: 0; }
.cell-typ    { flex-grow: 1;   flex-shrink: 1; flex-basis: 0; }
.cell-action { flex-grow: 0;   flex-shrink: 0; width: 44px;
               align-items: center; justify-content: center;
               padding-top: 0; padding-bottom: 0;
               padding-left: 0; padding-right: 4px; }

/* Betrag-Farbe wird per C# gesetzt, Standardfarbe grün */
.cell-betrag { color: rgb(128, 207, 149); }

/* Art-Zelle etwas gedimmter */
.cell-art { color: rgb(180, 180, 180); }

/* ---- Löschen-Button ---- */
.btn-delete {
    width: 26px;
    height: 26px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    background-color: rgba(230, 57, 70, 0.15);
    border-top-color: rgb(230, 57, 70);
    border-right-color: rgb(230, 57, 70);
    border-bottom-color: rgb(230, 57, 70);
    border-left-color: rgb(230, 57, 70);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    color: rgb(230, 57, 70);
    font-size: 18px;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
}
.btn-delete:hover {
    background-color: rgb(230, 57, 70);
    color: rgb(255, 255, 255);
}

.table-body {
    flex-grow: 1;
}

/* Datenzeilen: dezenter Hover + minimaler Rundung, damit es wie
   ein einheitliches System mit z.B. dem Dienstleistungen-Screen wirkt.
   Bewusst auf .table-body beschränkt, damit der Header (der ebenfalls
   die Klasse .row trägt) davon unberührt bleibt. */
.table-body .row {
    border-radius: 6px;
    margin-top: 2px;
    margin-bottom: 2px;
}
.table-body .row:hover {
    background-color: rgb(53, 53, 53);
}

/* Sortierbare Spaltenköpfe: Hover-Feedback, damit klar ist,
   dass man draufklicken kann. Aktive Sortierspalte wird per
   C# (KassenbuchController.AktualisiereSortPfeile) weiß eingefärbt. */
.row-header .cell {
    transition-property: color;
    transition-duration: 0.1s;
}
.row-header .cell:hover {
    color: rgb(255, 255, 255);
}

/* =====================================================
   POPUP-OVERLAY
   ===================================================== */
.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.popup-container {
    width: 380px;
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    background-color: rgb(38, 38, 38);
    flex-direction: column;
}

.popup-title {
    color: rgb(255, 255, 255);
    font-size: 28px;
    margin-bottom: 16px;
}

.field-group {
    flex-direction: column;
    margin-bottom: 16px;
}

.field-label {
    font-size: 18px;
    color: rgb(200, 200, 200);
    margin-bottom: 6px;
}

.field-input {
    height: 40px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(58, 58, 58);
    padding-left: 14px;
    padding-right: 14px;
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.field-input .unity-base-field__input {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(58, 58, 58);
    color: rgb(255, 255, 255);
    font-size: 16px;
    padding-left: 14px;
}

.popup-actions {
    flex-direction: row;
    margin-top: 8px;
}

.btn {
    flex: 1;
    height: 40px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 16px;
}

.btn-primary {
    background-color: rgb(128, 207, 149);
    color: rgb(28, 28, 28);
    margin-right: 8px;
}
.btn-primary:hover { background-color: rgb(179, 226, 196); }

.btn-secondary {
    background-color: rgb(100, 100, 100);
}
.btn-secondary:hover { background-color: rgb(142, 141, 141); }

.btn-popup-close:hover {
    background-color: rgba(230, 103, 112, 0.7);
    
}

/* =====================================================
   HEADER-ZEILE & JAHRES-DROPDOWN
   ===================================================== */
.header-row {
    margin-bottom: 8px;
}

.jahr-dropdown {
    height: 40px;
    width: 160px;
    margin-right: 12px;
    background-color: rgb(58, 58, 58);
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-text-align: middle-center;
}
.jahr-dropdown:hover { background-color: rgb(75, 75, 75); }
.jahr-dropdown .unity-base-popup-field__text { color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.jahr-dropdown .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(255, 255, 255); }
.jahr-dropdown .unity-base-field__input { background-color: transparent; border-width: 0; }
.jahr-dropdown .unity-base-field__label { display: none; }

/* =====================================================
   AKTIONS-BUTTONS (Ausgaben / Einnahmen / Export)
   ===================================================== */
.btn-action-3er {
    width: 220px;
    height: 44px;
    margin-left: 6px;
    margin-right: 6px;
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 15px;
    -unity-text-align: middle-center;
}
.btn-action-3er.btn-red  { background-color: rgb(230, 57, 70); color: rgb(255, 255, 255); }
.btn-action-3er.btn-red:hover { background-color: rgb(2229, 103, 112); }
.btn-action-3er.btn-green { background-color: rgb(128, 207, 149); color: rgb(28, 28, 28); }
.btn-action-3er.btn-green:hover { background-color: rgb(179, 226, 196); }
.btn-action-3er.btn-export-finanzamt { background-color: rgb(100, 100, 100); color: rgb(255,255,255); }
.btn-action-3er.btn-export-finanzamt:hover { background-color: rgb(142, 141, 141); }

/* =====================================================
   KALENDER-WIDGET
   ===================================================== */
.panel-half {
    background-color: rgb(40, 40, 40);
    border-radius: 10px;
    padding: 14px;
    margin-top: 8px;
    flex-direction: column;
}
.kalender-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}
.btn-cal-nav {
    width: 28px; height: 28px;
    border-radius: 14px;
    background-color: #383838;
    border-color: #555555;
    border-width: 1px;
    color: #80CF95;
    font-size: 18px;
    padding: 0;
    -unity-text-align: middle-center;
}
.btn-cal-nav:hover { background-color: #4A4A4A; border-color: #80CF95; }

.cal-dropdown {
    flex-grow: 1;
    margin: 0 6px;
    background-color: #646464;
    border-color: #646464;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 13px;
    height: 30px;
    -unity-text-align: middle-center;
}
.cal-dropdown:hover { background-color: #787878; border-color: #80CF95; }
.cal-dropdown > .unity-base-popup-field__text { color: #ffffff; -unity-text-align: middle-center; }
.cal-dropdown .unity-base-popup-field__arrow { -unity-background-image-tint-color: #ffffff; }
.cal-dropdown .unity-base-field__input { background-color: transparent; border-width: 0; }

.kalender-weekdays { flex-direction: row; margin-bottom: 4px; }
.cal-wd-label {
    flex-grow: 1; flex-basis: 0;
    color: #888888; font-size: 11px;
    -unity-text-align: middle-center;
}

.kalender-grid { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.cal-day {
    width: 13%; flex-grow: 1; flex-basis: 13%;
    margin: 2px; padding: 0;
    background-color: transparent;
    border-width: 0; border-radius: 6px;
    color: #cccccc; font-size: 13px;
    -unity-text-align: middle-center;
    min-height: 32px;
}
.cal-day:hover { background-color: #3A3A3A; color: #ffffff; }
.cal-day-today { background-color: #80CF95; color: #1E1E1E; border-radius: 6px; }
.cal-day-today:hover { background-color: #6BBF82; color: #1E1E1E; }
.cal-day-other-month { color: #3A3A3A; }
.cal-day-empty { background-color: transparent; color: transparent; }
.cal-day-empty:hover { background-color: transparent; }

/* =====================================================
   ART-DROPDOWN IM POPUP
   ===================================================== */
.art-dropdown {
    background-color: rgb(70, 70, 70);
    border-width: 0; border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 14px; height: 36px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
}
.art-dropdown:hover { background-color: rgb(85, 85, 85); }
.art-dropdown > .unity-base-popup-field__text { color: rgb(255, 255, 255); padding-left: 6px; }
.art-dropdown .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(255, 255, 255); }
.art-dropdown .unity-base-field__input { background-color: transparent; border-width: 0; }

/* =====================================================
   PFAD-BTN-PRIMARY (Gründungspfad-Style, grüner Button)
   Eingebunden im Finanzboard für den Kassenbuch-Button
   ===================================================== */
.pfad-btn-primary {
    background-color: rgb(128, 207, 149);
    color: rgb(20, 20, 20);
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    font-size: 14px;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.pfad-btn-primary:hover  { background-color: rgb(179, 226, 196); }
.pfad-btn-primary:active { background-color: rgb(102, 165, 119); }
