.content-area {
    flex-grow: 1;
    background-color: rgb(28, 28, 30);
    padding: 40px;
}

.screen-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
}

.table-header {
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.header-label {
    color: rgb(142, 142, 147);
    font-size: 14px;
    -unity-font-style: bold;
}

.col-bezeichnung {
    flex-basis: 35%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-erstellt {
    flex-basis: 20%;
    flex-grow: 0;
    flex-shrink: 0;
}

.col-faellig {
    flex-basis: 15%;
    flex-grow: 0;
    flex-shrink: 0;
    padding-right: 15px;
}

.col-status {
    flex-basis: 30%;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}