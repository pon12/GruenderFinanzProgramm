.content-area {
    flex-grow: 1;
    background-color: rgb(28, 28, 30);
    padding: 40px;
}

.screen-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
}

.buchhaltung-list-container{
    width: 100%;
}

/* ============================================
   EINHEITLICHES TABELLEN-DESIGN
   (identisch zu Dienstleistungen/Kassenbuch, damit alle
   Tabellen in der App gleich aussehen)
   ============================================ */
.tabelle-wrapper {
    flex-grow: 1;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-color: #3c3c3c;
    overflow: hidden;
}

.tabelle-header {
    flex-direction: row;
    background-color: rgb(44, 44, 44);
    padding-top: 16px;
    padding-bottom: 16px;
}

.tabelle-header-zelle {
    color: #80CF95;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.tabelle-zeile {
    flex-direction: row;
    align-items: center;
    width: 100%;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-width: 2px;
    border-color: #3c3c3c;
    background-color: #262626;
}

.tabelle-zeile:hover {
    background-color: #313131;
    border-width: 2px;
    border-color: #80CF95;
}

.tabelle-zelle {
    color: #FFFFFF;
    font-size: 14px;
    -unity-text-align: middle-left;
    text-overflow: ellipsis;
    overflow: hidden;
}

.zeile-btn-bearbeiten {
    flex-grow: 0;
    height: 32px;
    border-radius: 10px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    background-color: #80CF95;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
}
.zeile-btn-bearbeiten:hover {
    background-color: #B3E2C4;
}

.table-header {
    flex-direction: row;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 12px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
}

.header-label {
    color: rgb(200, 200, 200);
    font-size: 14px;
    -unity-font-style: bold;
}

/* Neu balanciertes Grid-Layout für 5 Spalten */
.col-bezeichnung {
    font-size: 14px;
    width: 45%;
    flex-grow: 0;
    flex-shrink: 1;
    box-sizing: border-box;
    padding-left: 12px;
}

.col-erstellt {
    font-size: 14px;
    width: 15%;
    flex-grow: 0;
    flex-shrink: 1;
    box-sizing: border-box;
}

.col-faellig {
    font-size: 14px;
    width: 15%;
    flex-grow: 0;
    flex-shrink: 1;
    box-sizing: border-box;
    padding-right: 15px;
}

.col-status {
    width: 15%;
    flex-grow: 0;
    flex-shrink: 1;
    box-sizing: border-box;
    align-items: flex-start;
}

.col-edit {
    width: 10%;
    flex-grow: 0;
    flex-shrink: 1;
    box-sizing: border-box;
    align-items: flex-end;
    justify-content: center;
    padding-right: 8px;
}

/* Popup Hintergrund-Schatten / Overlay */
.popup-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    left: 0;
    top: 0;
    z-index: 999;
}

/* Sichtbarkeits-Klassen */
.popup-hidden {
    display: none;
}

/* Das eigentliche Popup-Fenster */
.popup-window {
    width: 55%;
    max-height: 85%;
    background-color: rgb(45, 45, 45);
    border-radius: 12px;
    padding: 24px;
    border-width: 1px;
    border-color: rgb(65, 65, 65);
}

/* Header innerhalb des Popups */
.popup-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-color: rgb(65, 65, 65);
    padding-bottom: 12px;
}

.popup-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* Schließen-Button (X) */
.popup-close-btn {
    background-color: transparent;
    color: rgb(170, 170, 170);
    font-size: 18px;
    border-width: 0;
    padding: 4px 8px;
}

.popup-close-btn:hover {
    color: rgb(255, 255, 255);
}

/* Bereich für die Input-Felder */
.popup-content {
    flex-grow: 1;
}

/* Inputs im Popup optisch anpassen */
.popup-content TextField, .popup-content DropdownField {
    margin-bottom: 14px;
    color: white;
}

.popup-headline-sub {
    font-size: 15px;
    color: rgb(200, 200, 200);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 8px;
}

/* Styling für die Eingabefelder im Popup */
.popup-field {
    width: 100%;
    margin-bottom: 16px;
    color: white;
}

/* Erzwingt, dass die Texteingabeboxen im Feld sich ausdehnen */
.popup-field .unity-text-field__input, 
.popup-field .unity-base-dropdown__container {
    flex-grow: 1;
    background-color: rgb(35, 35, 35);
    border-color: rgb(70, 70, 70);
    color: white;
    padding: 6px;
    border-radius: 4px;
}

/* Breite des Labels links neben dem Input-Feld regulieren */
.popup-field .unity-label {
    min-width: 130px;
    color: rgb(210, 210, 210);
    -unity-font-style: bold;
}

/* Der Speichern-Button */
.popup-save-btn {
    margin-top: 20px;
    background-color: rgb(46, 139, 87); /* SeaGreen */
    color: white;
    padding: 10px;
    font-size: 14px;
    border-radius: 6px;
    border-width: 0;
    -unity-font-style: bold;
}

.popup-save-btn:hover {
    background-color: rgb(60, 179, 113);
}