.fullscreen-bg {
    /* Nimmt 100% der Breite und Höhe des Eltern-Elements (Bildschirm) ein */
    width: 100%;
    height: 100%;
    
    /* Hintergrundfarbe (hier ein dunkles Grau, passend zu deinem Logo) */
    background-color: rgb(45, 45, 45);
    
    /* Positionierung auf Absolut setzen, damit es ganz hinten liegt */
    position: absolute;
    top: 0;
    left: 0;
}