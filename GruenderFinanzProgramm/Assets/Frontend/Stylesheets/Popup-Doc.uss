.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.popup-window {
    width: 100%;
    max-width: 850px;
    background-color: #111111;
    border-radius: 20px;
    padding: 32px;
    flex-direction: column;
}

#Popup-Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

#Btn-Back {
    background-color: #242424;
    color: #ffffff;
    border-radius: 12px;
    padding: 10px 20px;
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
}

.popup-window Label {
    color: #888888;
    font-size: 14px;
    margin-bottom: 6px;
}

.popup-window .unity-text-field__input,
.popup-window .unity-base-field__input {
    background-color: #383838;
    color: #ffffff;
    border-radius: 12px;
    border-width: 0;
    padding: 14px 18px;
    font-size: 16px;
    margin-bottom: 24px;
}

.popup-window .unity-text-field__placeholder {
    color: #aaaaaa;
}

#Form-Group-3 > Label {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

#Template-Grid {
    flex-direction: row;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
}

#Template-Grid Button {
    flex-grow: 1;
    height: 120px;
    background-color: #242424;
    border-radius: 16px;
    border-width: 1px;
    border-color: #2c2c2c;
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
}

#Template-Grid Button:hover {
    background-color: #2e2e2e;
}

#Template-Grid .selected-template {
    border-color: #80CF95;
    border-width: 1.5px;
}

#Popup-Footer {
    flex-direction: row;
    justify-content: flex-end;
    gap: 16px;
}

#Btn-Cancel,
#Btn-Abbrechen {
    background-color: #242424;
    color: #ffffff;
    border-radius: 12px;
    padding: 14px 28px;
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

#Btn-Submit {
    background-color: #80CF95;
    color: #ffffff;
    border-radius: 12px;
    padding: 14px 32px;
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

#Btn-Cancel:hover,
#Btn-Abbrechen:hover { background-color: #2e2e2e; }
#Btn-Submit:hover { background-color: #6bbf81; }