/* ==========================================================================
   POPUP OVERLAY & WINDOW
   ========================================================================== */

/* Das dunkle Vollbild-Overlay im Hintergrund */
.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85); /* Schön dunkel abdunkeln */
    align-items: center;
    justify-content: center;
    padding: 40px;
}

/* Das Hauptfenster */
.popup-window {
    width: 100%;
    max-width: 850px;
    background-color: #111111; /* Sattes Schwarz/Anthrazit */
    border-radius: 20px;
    padding: 32px;
    flex-direction: column;
}

/* ==========================================================================
   HEADER SECTION
   ========================================================================== */

#Popup-Header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

/* "Zurück"-Button oben rechts */
#Btn-Back {
    background-color: #242424;
    color: #ffffff;
    border-radius: 12px;
    padding: 10px 20px;
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
}

/* ==========================================================================
   INPUT FIELDS (Eingabe & Dropdown)
   ========================================================================== */

/* Das Label über den Feldern (z.B. "Dokumentname") */
.popup-window Label {
    color: #888888;
    font-size: 14px;
    margin-bottom: 6px;
}

/* Styling für das Text-Eingabefeld UND das Dropdown */
.popup-window .unity-text-field__input, 
.popup-window .unity-base-field__input {
    background-color: #383838; /* Dein Figma-Grau! */
    color: #ffffff;
    border-radius: 12px;
    border-width: 0;
    padding: 14px 18px;
    font-size: 16px;
    margin-bottom: 24px;
}

/* Behebt den Unity-Bug, dass Placeholder-Text manchmal schwarz ist */
.popup-window .unity-text-field__placeholder {
    color: #aaaaaa;
}

/* ==========================================================================
   VORLAGEN GRID (Die 3 Kacheln in der Mitte)
   ========================================================================== */

/* Überschrift "Vorlage wählen" wieder weiß machen */
#Form-Group-3 > Label {
    color: #ffffff;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

/* Der Container für die 3 Buttons */
#Template-Grid {
    flex-direction: row;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
}

/* Styling für die 3 Vorlagen-Kacheln */
#Template-Grid Button {
    flex-grow: 1;
    height: 120px;
    background-color: #242424;
    border-radius: 16px;
    border-width: 1px;
    border-color: #2c2c2c;
    color: #ffffff;
    font-size: 16px;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
}

/* Hover-Effekt für die Vorlagen */
#Template-Grid Button:hover {
    background-color: #2e2e2e;
}

/* Highlight für den aktuell ausgewählten Button (z.B. Standard) */
#Template-Grid .selected-template {
    border-color: #80CF95; /* Dein Figma-Grün als Rand! */
    border-width: 1.5px;
}

/* ==========================================================================
   FOOTER BUTTONS (Unten rechts)
   ========================================================================== */

#Popup-Footer {
    flex-direction: row;
    justify-content: flex-end;
    gap: 16px;
}

/* Abbrechen Button */
#Btn-Cancel {
    background-color: #242424;
    color: #ffffff;
    border-radius: 12px;
    padding: 14px 28px;
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

/* Erstellen Button */
#Btn-Submit {
    background-color: #80CF95; /* Dein Figma-Grün! */
    color: #ffffff;
    border-radius: 12px;
    padding: 14px 32px;
    border-width: 0;
    font-size: 15px;
    -unity-font-style: bold;
}

/* Kleine Hover-Animationen für die Footer-Buttons */
#Btn-Cancel:hover { background-color: #2e2e2e; }
#Btn-Submit:hover { background-color: #6bbf81; }