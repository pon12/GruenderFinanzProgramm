/* 1. Der Haupt-Container der Sidebar */
#sidebar {
    width: 260px;
    height: 100%;
    background-color: #363636; /* Dunkelgrauer Hintergrund */
    padding: 24px 16px;
    flex-direction: column;
    justify-content: flex-start;
}

/* 2. Der Header (Logo + Text) */
#sidebar-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 40px;
    padding-left: 8px;
}

#logo-icon {
    width: 36px;
    height: 36px;
    background-color: #76D794; /* Das helle Grün */
    border-radius: 10px;
    margin-right: 12px;
}

#logo-text {
    color: #ffffff;
    font-size: 24px;
    -unity-font-style: bold;
}

/* 3. Die Navigations-Liste */
#sidebar-nav {
    flex-direction: column;
    flex-grow: 1; /* Nimmt den verfügbaren Platz ein */
}

/* Einzelnes Nav-Item (Inaktiv) */
.nav-item {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 8px;
    border-radius: 20px; /* Abgerundete Pillen-Form */
    transition: background-color 0.2s ease;
}

/* Hover-Effekt für inaktive Items */
.nav-item:hover {
    background-color: #2e2e2e;
}

/* Das Kreis-Icon vor dem Text */
.nav-icon {
    width: 12px;
    height: 12px;
    border-width: 2px;
    border-color: #aaaaaa;
    border-radius: 6px; /* Macht es zum Kreis */
    margin-right: 12px;
}

.nav-label {
    color: #aaaaaa; /* Leicht ausgegrauter Text */
    font-size: 14px;
}

/* AKTIVER ZUSTAND (z.B. für Dokumente) */
.nav-item-active {
    background-color: #76D794; /* Grüner Hintergrund */
}

.nav-item-active .nav-icon {
    border-color: #ffffff; /* Weißer Kreis bei aktivem Item */
    background-color: #ffffff; /* Ausgefüllter Kreis */
}

.nav-item-active .nav-label {
    color: #ffffff; /* Weiße Schrift bei aktivem Item */
    -unity-font-style: bold;
}

/* 4. Der Footer (User-Profil ganz unten) */
#sidebar-footer {
    flex-direction: row;
    align-items: center;
    padding: 12px 8px;
    border-top-width: 1px;
    border-top-color: #2e2e2e;
    /* Der magische Flexbox-Trick: Drückt das Element nach ganz unten */
    margin-top: auto; 
}

#user-avatar {
    width: 32px;
    height: 32px;
    background-color: #76D794;
    border-radius: 16px; /* Perfekter Kreis */
    margin-right: 12px;
}

#user-name {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
}