/* ── TutorialManager USS – Ventoriq Dark Theme ──────────────────────────── */

/* Unsichtbares Root-Element – kein Hintergrund, keine Pointer-Events außer Kinder */
.tutorial-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* ── StartDialog ────────────────────────────────────────────────────────── */

.start-dialog-wrapper {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

.dialog {
    background-color: rgb(28, 33, 38);
    border-radius: 12px;
    padding: 36px;
    width: 420px;
    align-items: center;
    border-width: 1px;
    border-color: rgb(50, 57, 65);
}

.dialog-headline {
    color: rgb(128, 207, 149);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.dialog-text {
    color: rgb(190, 195, 200);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

/* ── Tutorial-Modus ─────────────────────────────────────────────────────── */

/* Halbtransparenter Hintergrund, Erklärungsbox unten zentriert */
.tutorial-modus {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.52);
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 40px;
}

/* Highlight-Ring – Größe und Position werden per Script gesetzt */
.highlight-rahmen {
    position: absolute;
    border-width: 3px;
    border-color: rgb(128, 207, 149);
    border-radius: 8px;
    background-color: rgba(128, 207, 149, 0.07);
}

/* Erklärungsbox */
.erklaerung-box {
    width: 680px;
    background-color: rgb(22, 27, 32);
    border-radius: 12px;
    padding: 24px 28px;
    border-width: 1px;
    border-color: rgb(50, 57, 65);
}

.erklaerung-text {
    color: rgb(210, 215, 220);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 20px;
}

.nav-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.schritt-anzeige {
    color: rgb(130, 135, 145);
    font-size: 13px;
    -unity-text-align: middle-center;
}

/* Beenden-Button oben rechts */
.btn-beenden {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgb(44, 50, 58);
    color: rgb(190, 195, 200);
    border-width: 0;
    border-radius: 8px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 13px;
}

.btn-beenden:hover {
    background-color: rgb(60, 67, 77);
}

/* ── Buttons ────────────────────────────────────────────────────────────── */

.btn {
    border-radius: 6px;
    font-size: 14px;
    border-width: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
}

/* Primär */
.btn-primary {
    background-color: rgb(128, 207, 149);
    color: rgb(18, 22, 26);
    -unity-font-style: bold;
    margin-top: 10px;
    width: 100%;
}

.btn-primary:hover {
    background-color: rgb(148, 220, 167);
}

.btn-primary:active {
    background-color: rgb(108, 187, 130);
}

.btn-primary:disabled {
    opacity: 0.35;
}

/* Ghost / Outline */
.btn-ghost {
    background-color: transparent;
    color: rgb(128, 207, 149);
    border-width: 1px;
    border-color: rgb(128, 207, 149);
    margin-top: 0;
    width: auto;
}

.btn-ghost:hover {
    background-color: rgba(128, 207, 149, 0.1);
}

.btn-ghost:active {
    background-color: rgba(128, 207, 149, 0.2);
}

.btn-ghost:disabled {
    opacity: 0.35;
}

/* Weiter/Zurück in der Nav-Row: kein full-width */
.nav-row .btn-primary {
    width: auto;
    margin-top: 0;
}
