/* ── TutorialManager USS – Ventoriq Dark Theme ──────────────────────────── */

/* Unsichtbares Root-Element */
.tutorial-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ── StartDialog ────────────────────────────────────────────────────────── */

.start-dialog-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
    align-items: center;
    justify-content: center;
}

.dialog {
    background-color: #1C2126;
    border-radius: 10px;
    padding: 32px;
    width: 400px;
    align-items: center;
    border-width: 1px;
    border-color: #323941;
}

.dialog-headline {
    color: #80CF95;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.dialog-text {
    color: #BEC3C8;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

/* ── Tutorial-Modus ─────────────────────────────────────────────────────── */

.tutorial-modus {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.52);
    align-items: center;
    justify-content: flex-end;
}

/* Highlight-Ring */
.highlight-rahmen {
    position: absolute;
    border-width: 5px;
    border-color: #80CF95;
    border-radius: 10px;
}

/* Bottom Container – richtet Maskottchen & Erklärungsbox horizontal zentriert aus */
.tutorial-bottom-container {
    flex-direction: row;
    align-items: bottom;
    justify-content: left;
    padding-left: 240px;
    width: 100%;
}

/* Erklärungsbox */
.erklaerung-box {
    width: 680px;
    background-color: #161B20;
    border-radius: 10px;
    padding: 24px 32px;
    margin-bottom: 40px;
    border-width: 1px;
    border-color: #323941;
}

.erklaerung-text {
    color: #D2D7DC;
    font-size: 16px;
    white-space: normal;
    margin-bottom: 24px;
}

.nav-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.schritt-anzeige {
    color: #828791;
    font-size: 13px;
    -unity-text-align: middle-center;
}

/* ── Maskottchen ────────────────────────────────────────────────────────── */

.maskottchen {
    width: 400px;
    height: 400px;
    transform: translate(-100%, 0); /* Schiebt das Bild komplett links neben die Box */
    padding-right: 20px; /* Abstand zur Box */
    background-image: url("project://database/Assets/Resources/Begleiter 3.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Buttons (Basis & Beenden) ─────────────────────────────────────────── */

Button.btn {
    border-radius: 10px;
    font-size: 14px;
    border-width: 0;
    padding: 8px 24px;
    transition-duration: 0.1s;
}

Button.btn-beenden {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: #2C323A;
    color: #BEC3C8;
    border-width: 0;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
    transition-duration: 0.1s;
}

Button.btn-beenden:hover {
    background-color: #3C434D;
    color: #FFFFFF;
}

Button.btn-beenden:active {
    background-color: #1F242A;
}

/* Primär-Button */
Button.btn-primary {
    background-color: #80CF95;
    color: #12161A;
    -unity-font-style: bold;
    margin-top: 8px;
    width: 100%;
}

Button.btn-primary:hover {
    background-color: #94DCA7;
}

Button.btn-primary:active {
    background-color: #6CB782;
    color: #0E1215;
}

Button.btn-primary:disabled {
    opacity: 0.35;
}

/* Nav-Row Besonderheit für Primär-Buttons */
.nav-row Button.btn-primary {
    width: auto;
    margin-top: 0;
}

/* Ghost / Outline-Button */
Button.btn-ghost {
    background-color: transparent;
    color: #80CF95;
    border-width: 1px;
    border-color: #80CF95;
    margin-top: 8px;
    width: auto;
}

Button.btn-ghost:hover {
    background-color: rgba(128, 207, 149, 0.1);
    color: #94DCA7;
}

Button.btn-ghost:active {
    background-color: rgba(128, 207, 149, 0.2);
    color: #6CB782;
}