/* ============================================
   DASHBOARD STYLES — komplett überarbeitet
   Mintgrün CI: #80CF95 | Dunkel: #1E1E1E | Anthrazit: #2C2C2C / #383838
   ============================================ */

/* --- Root --- */
#dashboard-root {
    flex-grow: 1;
    padding: 20px 24px;
    background-color: #1E1E1E;
}

/* ============================================
   SEKTION 1: DOKUMENTEN-FORTSCHRITTSBALKEN
   ============================================ */
.progress-section {
    margin-bottom: 20px;
    flex-grow: 0;
    flex-shrink: 0;
}

/* Titelzeile mit Prozent rechts */
.progress-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}
.section-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
}
.progress-percent {
    color: #80CF95;
    font-size: 15px;
    font-weight: bold;
}

/* Die 5 Segmente nebeneinander */
.progress-segments-row {
    flex-direction: row;
    justify-content: space-between;
}
.progress-segment-wrap {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    align-items: stretch;
}
.progress-segment-wrap:first-child { margin-left: 0; }
.progress-segment-wrap:last-child  { margin-right: 0; }

/* Hintergrund-Schiene jedes Segments */
.seg-bg {
    height: 10px;
    background-color: #444444;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 5px;
}
/* Füllung des Segments */
.seg-fill {
    height: 100%;
    background-color: #80CF95;
    border-radius: 5px;
}
.seg-full    { width: 100%; }
.seg-partial { width: 40%; }
.seg-empty   { width: 0%; }

/* Label unterhalb des Segments */
.seg-label {
    color: #888888;
    font-size: 10px;
    -unity-text-align: middle-center;
}

/* ============================================
   SEKTION 2: STAT-KACHELN
   ============================================ */
#stats-grid {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-grow: 0;
    flex-shrink: 0;
}
.stat-card {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #2C2C2C;
    border-radius: 10px;
    padding: 14px 16px;
    margin: 0 5px;
    border-width: 1px;
    border-color: #444444;
}
.stat-card:first-child { margin-left: 0; }
.stat-card:last-child  { margin-right: 0; }

.stat-title {
    color: #888888;
    font-size: 12px;
    margin-bottom: 8px;
    white-space: normal;
}
.stat-value {
    color: #ffffff;
    font-size: 22px;
    font-weight: bold;
}
.stat-value-green {
    color: #80CF95;
}

/* ============================================
   SEKTION 3: UNTERE REIHE
   ============================================ */
#bottom-row {
    flex-direction: row;
    flex-grow: 1;
}
.panel-half {
    flex-grow: 1;
    flex-basis: 0;
    background-color: #2C2C2C;
    border-radius: 10px;
    padding: 16px;
    border-width: 1px;
    border-color: #444444;
}
#kassenbuch-statistik-panel { margin-right: 10px; }
#kalender-panel              { margin-left: 10px; }

.panel-title {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 12px;
    flex-grow: 0;
    flex-shrink: 0;
}

/* ============================================
   CHART
   ============================================ */
.chart-container {
    flex-grow: 1;
    flex-direction: row;
    min-height: 160px;
    margin-bottom: 4px;
}
.chart-y-axis {
    width: 36px;
    flex-shrink: 0;
    justify-content: space-between;
    padding: 4px 0;
}
.chart-axis-label {
    color: #666666;
    font-size: 10px;
    -unity-text-align: middle-right;
}
/* Zeichenfläche – ChartRenderer.cs zeichnet hier Linien/Punkte */
.chart-canvas {
    flex-grow: 1;
    background-color: #1A1A1A;
    border-radius: 6px;
}

/* X-Achse Monate */
.chart-x-axis {
    flex-direction: row;
    justify-content: space-around;
    padding-left: 40px;
    margin-bottom: 12px;
    flex-grow: 0;
    flex-shrink: 0;
}
.chart-month-label {
    color: #666666;
    font-size: 10px;
    flex-grow: 1;
    -unity-text-align: middle-center;
}

/* Navigations-Buttons */
.panel-navigation-buttons {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-nav {
    flex-grow: 1;
    margin: 0 4px;
    padding: 9px 4px;
    border-radius: 8px;
    border-width: 0;
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
    cursor: link;
}
.btn-nav:first-child { margin-left: 0; }
.btn-nav:last-child  { margin-right: 0; }
.btn-nav-orange {
    background-color: #E07A2F;
}
.btn-nav-orange:hover {
    background-color: #C96A22;
}
.btn-nav-dark {
    background-color: #383838;
    border-width: 1px;
    border-color: #555555;
}
.btn-nav-dark:hover {
    border-color: #80CF95;
    color: #80CF95;
}

/* ============================================
   KALENDER — vollständiges Monatsraster
   ============================================ */

/* Navigation: Pfeil | Dropdown Monat | Dropdown Jahr | Pfeil */
.kalender-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-cal-nav {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: #383838;
    border-color: #555555;
    border-width: 1px;
    color: #80CF95;
    font-size: 18px;
    padding: 0;
    -unity-text-align: middle-center;
    cursor: link;
}
.btn-cal-nav:hover {
    background-color: #4A4A4A;
}
.cal-dropdown {
    flex-grow: 1;
    margin: 0 6px;
    background-color: #383838;
    border-color: #555555;
    border-width: 1px;
    border-radius: 6px;
    color: #ffffff;
    font-size: 12px;
    height: 28px;
}

/* Wochentag-Header */
.kalender-weekdays {
    flex-direction: row;
    margin-bottom: 4px;
    flex-grow: 0;
    flex-shrink: 0;
}
.cal-wd-label {
    flex-grow: 1;
    flex-basis: 0;
    color: #888888;
    font-size: 11px;
    -unity-text-align: middle-center;
    font-weight: bold;
}

/* 7×6 Tages-Gitter – füllt den gesamten verfügbaren Platz */
.kalender-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    align-content: stretch;  /* Reihen dehnen sich vertikal aus */
}
.cal-day {
    /* 1/7 der Breite, minus je 2px Margin */
    width:      13%;
    flex-grow:  1;
    flex-basis: 13%;
    flex-shrink: 0;
    margin: 2px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 6px;
    color: #cccccc;
    font-size: 13px;
    font-weight: bold;
    -unity-text-align: middle-center;
    cursor: link;
    /* Mindesthöhe damit die Buttons nicht zu flach werden */
    min-height: 32px;
}
.cal-day:hover {
    background-color: #3A3A3A;
    color: #ffffff;
}
/* Heutiger Tag */
.cal-day-today {
    background-color: #80CF95;
    color: #1E1E1E;
    font-weight: bold;
    border-radius: 6px;
}
.cal-day-today:hover {
    background-color: #6BBF82;
    color: #1E1E1E;
}
/* Tage außerhalb des aktuellen Monats */
.cal-day-other-month {
    color: #3A3A3A;
    font-weight: normal;
}
