/* =============================================
   Gruendungspfad.uss
   Design: identisch zum Rest der App
   #80CF95 Primär / #646464 Sekundär / #1E1E1E Hintergrund
   ============================================= */

/* GLOBALE SCHRIFT */
#root-container, Label, Button, TextField, Toggle, DropdownField {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* SEITE */
.page-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
}
.page-subtitle {
    font-size: 14px;
    color: rgb(160, 160, 160);
}

/* GESAMTFORTSCHRITT-LEISTE */
.gesamt-fortschritt-box {
    background-color: rgb(38, 38, 38);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 18px 22px;
}
.fortschritt-header-label {
    font-size: 15px;
    color: rgb(255, 255, 255);
}
.fortschritt-prozent-label {
    font-size: 14px;
    color: rgb(128, 207, 149);
}
.fortschritt-balken-bg {
    height: 10px;
    background-color: rgb(55, 55, 55);
    border-radius: 5px;
    overflow: hidden;
}
.fortschritt-balken-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* PHASENKARTE */
.phase-card {
    background-color: rgb(38, 38, 38);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 22px;
    margin-bottom: 20px;
}

.phase-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.phase-icon {
    font-size: 28px;
    width: 44px;
    height: 44px;
    -unity-text-align: middle-center;
    background-color: rgb(50, 50, 50);
    border-radius: 10px;
    margin-right: 14px;
}
.phase-name {
    font-size: 20px;
    color: rgb(255, 255, 255);
}
.phase-progress-label {
    font-size: 12px;
    color: rgb(150, 150, 150);
    margin-top: 2px;
}

/* Kleiner Fortschrittsbalken pro Phase */
.phase-mini-bar-bg {
    height: 6px;
    background-color: rgb(55, 55, 55);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 16px;
}
.phase-mini-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* SCHRITTE */
.schritte-liste {
    flex-direction: column;
}

.schritt-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(50, 50, 50);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(65, 65, 65);
    padding: 12px 16px;
    margin-bottom: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}
.schritt-row:hover {
    background-color: rgb(55, 55, 55);
    border-color: rgb(80, 80, 80);
}
.schritt-erledigt {
    border-color: rgb(128, 207, 149);
    background-color: rgba(128, 207, 149, 0.08);
}

.schritt-titel {
    font-size: 14px;
    color: rgb(230, 230, 230);
    white-space: normal;
}
.schritt-titel-erledigt {
    color: rgb(130, 130, 130);
}
.schritt-beschreibung {
    font-size: 12px;
    color: rgb(140, 140, 140);
    white-space: normal;
    margin-top: 3px;
}

/* Checkbox-Styling */
.schritt-checkbox {
    margin: 0;
    flex-shrink: 0;
}
.schritt-checkbox > .unity-toggle__input {
    background-color: rgb(70, 70, 70);
    border-color: rgb(100, 100, 100);
    border-width: 1.5px;
    border-radius: 4px;
    width: 20px;
    height: 20px;
}
.schritt-checkbox > .unity-toggle__input:checked {
    background-color: rgb(128, 207, 149);
    border-color: rgb(128, 207, 149);
}
.schritt-checkbox .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(28, 28, 28);
}

/* Löschen-Button (nur bei eigenen Schritten) */
.schritt-delete-btn {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background-color: rgba(230, 57, 70, 0.12);
    border-width: 1px;
    border-color: rgba(230, 57, 70, 0.4);
    color: rgb(230, 57, 70);
    font-size: 18px;
    padding: 0;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    margin-left: 10px;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.schritt-delete-btn:hover {
    background-color: rgb(230, 57, 70);
    color: rgb(255, 255, 255);
    border-color: rgb(230, 57, 70);
}

/* BUTTONS */
.pfad-btn-primary {
    background-color: rgb(128, 207, 149);
    color: rgb(20, 20, 20);
    border-width: 0;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.pfad-btn-primary:hover { background-color: rgb(107, 191, 130); }
.pfad-btn-primary:active { background-color: rgb(90, 170, 112); }

.pfad-btn-secondary {
    background-color: rgb(100, 100, 100);
    color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
    transition-property: background-color;
    transition-duration: 0.1s;
}
.pfad-btn-secondary:hover { background-color: rgb(120, 120, 120); }

/* POPUP */
.popup-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding: 40px;
}
.pfad-popup-box {
    background-color: rgb(38, 38, 38);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 28px;
    width: 100%;
    max-width: 520px;
    flex-direction: column;
}
.pfad-popup-title {
    font-size: 20px;
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
}
.pfad-form-group {
    flex-direction: column;
    margin-bottom: 16px;
}
.pfad-field-label {
    font-size: 12px;
    color: rgb(180, 180, 180);
    margin-bottom: 6px;
}

/* Dropdown im Popup */
.pfad-dropdown {
    background-color: rgb(70, 70, 70);
    border-width: 0;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    height: 36px;
}
.pfad-dropdown > .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
    padding-left: 6px;
}
.pfad-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.pfad-dropdown .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
}

/* Textfeld-Stil */
.unity-base-field__input, .unity-text-field__input {
    background-color: rgb(70, 70, 70);
    border-width: 0;
    border-radius: 6px;
    color: rgb(255, 255, 255);
    padding-left: 10px;
}
.unity-base-field__input:focus {
    border-width: 1px;
    border-color: rgb(128, 207, 149);
}
.unity-base-field__label { display: none; }
