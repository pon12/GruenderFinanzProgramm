/* =============================================
   Erfolge.uss
   #80CF95 Primär / #2C2C2C Modul / #1E1E1E Hintergrund
   ============================================= */

/* GLOBALE SCHRIFT */
#main-content, Label, Button {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

/* SEITE */
.page-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 4px;
}
.page-subtitle {
    font-size: 14px;
    color: rgb(160, 160, 160);
}
.gesamt-prozent-label {
    font-size: 24px;
    color: rgb(128, 207, 149);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* GESAMTFORTSCHRITTSBALKEN */
.gesamt-fortschritt-box {
    background-color: rgb(44, 44, 44);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 20px;
    padding-right: 20px;
}
.fortschritt-header-label {
    font-size: 15px;
    color: rgb(255, 255, 255);
}
.fortschritt-prozent-label {
    font-size: 14px;
    color: rgb(128, 207, 149);
}
.fortschritt-balken-bg {
    height: 8px;
    background-color: rgb(55, 55, 55);
    border-radius: 4px;
    overflow: hidden;
}
.fortschritt-balken-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* GRID */
.erfolge-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* KATEGORIE-KARTE */
.kategorie-card {
    background-color: rgb(44, 44, 44);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 22px;
    margin-bottom: 20px;
    margin-right: 20px;
    width: 48%;
    min-width: 400px;
    flex-shrink: 0;
}
.kategorie-card:hover {
    border-color: rgb(128, 207, 149);
}

.kategorie-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}
.kategorie-icon {
    font-size: 24px;
    width: 40px;
    height: 40px;
    -unity-text-align: middle-center;
    background-color: rgb(55, 55, 55);
    border-radius: 8px;
    margin-right: 12px;
    flex-shrink: 0;
}
.kategorie-name {
    font-size: 18px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.kategorie-prozent {
    font-size: 14px;
    color: rgb(128, 207, 149);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* Mini-Balken pro Kategorie */
.kategorie-mini-bar-bg {
    height: 5px;
    background-color: rgb(55, 55, 55);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 16px;
}
.kategorie-mini-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 3px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* ERFOLGS-KACHELN GRID */
.erfolge-kacheln-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* EINZELNE KACHEL */
.erfolg-kachel {
    background-color: rgb(38, 38, 38);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    padding: 10px 14px;
    margin-bottom: 6px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}
.erfolg-kachel:hover {
    border-color: rgb(80, 80, 80);
    background-color: rgb(42, 42, 42);
}
.erfolg-kachel--erledigt {
    border-color: rgb(128, 207, 149);
    background-color: rgba(128, 207, 149, 0.07);
}
.erfolg-kachel--gesperrt {
    opacity: 0.45;
}

.erfolg-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background-color: rgb(55, 55, 55);
    -unity-text-align: middle-center;
    font-size: 22px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
}
.erfolg-icon-box--erledigt {
    background-color: rgba(128, 207, 149, 0.2);
}

.erfolg-text-block {
    flex-grow: 1;
    flex-direction: column;
}
.erfolg-titel {
    font-size: 13px;
    color: rgb(220, 220, 220);
    white-space: normal;
    margin-bottom: 3px;
}
.erfolg-titel--erledigt {
    color: rgb(128, 207, 149);
}
.erfolg-beschreibung {
    font-size: 11px;
    color: rgb(140, 140, 140);
    white-space: normal;
}

/* STACKABLE BADGE */
.erfolg-stackable-badge {
    background-color: rgb(128, 207, 149);
    color: rgb(20, 20, 20);
    font-size: 9px;
    border-radius: 4px;
    padding: 1px 5px;
    margin-left: 6px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 1px;
}

/* Stackable Fortschrittsbalken */
.stackable-bar-bg {
    height: 4px;
    background-color: rgb(60, 60, 60);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 6px;
}
.stackable-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 2px;
}
.stackable-count-label {
    font-size: 10px;
    color: rgb(128, 207, 149);
    margin-top: 3px;
}

/* Haken oben rechts bei erledigten */
.erfolg-check {
    font-size: 14px;
    color: rgb(128, 207, 149);
    flex-shrink: 0;
    margin-left: 6px;
    align-self: flex-start;
}
