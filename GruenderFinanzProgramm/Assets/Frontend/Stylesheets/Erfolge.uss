/* =============================================
   Erfolge.uss
   ============================================= */

#root-container, Label, Button {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
}

.page-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    margin-bottom: 4px;
}
.page-subtitle {
    font-size: 14px;
    color: rgb(160, 160, 160);
}
.gesamt-prozent-label {
    font-size: 22px;
    color: rgb(128, 207, 149);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

/* GESAMTFORTSCHRITT */
.gesamt-fortschritt-box {
    background-color: rgb(44, 44, 44);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 18px 22px;
}
.fortschritt-header-label {
    font-size: 15px;
    color: rgb(255, 255, 255);
}
.fortschritt-prozent-label {
    font-size: 14px;
    color: rgb(128, 207, 149);
}
.fortschritt-balken-bg {
    height: 10px;
    background-color: rgb(55, 55, 55);
    border-radius: 5px;
    overflow: hidden;
}
.fortschritt-balken-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 5px;
    transition-property: width;
    transition-duration: 0.3s;
}

/* GRID – 2 Spalten */
.erfolge-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* KATEGORIE-CARD */
.kategorie-card {
    background-color: rgb(44, 44, 44);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 55);
    padding: 20px;
    margin-bottom: 20px;
    margin-right: 20px;
    width: 48%;
}
.kategorie-card:hover {
    border-color: rgb(128, 207, 149);
}

.kategorie-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}
.kategorie-icon {
    font-size: 22px;
    width: 40px;
    height: 40px;
    -unity-text-align: middle-center;
    background-color: rgb(55, 55, 55);
    border-radius: 8px;
    margin-right: 12px;
    flex-shrink: 0;
}
.kategorie-name {
    font-size: 17px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.kategorie-prozent {
    font-size: 14px;
    color: rgb(128, 207, 149);
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}

.kategorie-mini-bar-bg {
    height: 5px;
    background-color: rgb(55, 55, 55);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 16px;
}
.kategorie-mini-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 3px;
}

/* KACHELN */
.kacheln-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.erfolg-kachel {
    background-color: rgb(38, 38, 38);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    padding: 12px;
    margin-right: 8px;
    margin-bottom: 8px;
    width: 47%;
    flex-direction: row;
    align-items: flex-start;
}
.erfolg-kachel:hover {
    border-color: rgb(90, 90, 90);
}
.erfolg-kachel--erledigt {
    border-color: rgb(128, 207, 149);
    background-color: rgba(128, 207, 149, 0.07);
}
.erfolg-kachel--offen {
    opacity: 0.5;
}

.erfolg-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background-color: rgb(55, 55, 55);
    -unity-text-align: middle-center;
    font-size: 16px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
}
.erfolg-icon-box--erledigt {
    background-color: rgba(128, 207, 149, 0.2);
}

.erfolg-text-block {
    flex-grow: 1;
    flex-direction: column;
}
.erfolg-titel {
    font-size: 12px;
    color: rgb(210, 210, 210);
    white-space: normal;
    margin-bottom: 2px;
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
}
.erfolg-titel--erledigt {
    color: rgb(128, 207, 149);
}
.erfolg-beschreibung {
    font-size: 10px;
    color: rgb(130, 130, 130);
    white-space: normal;
}

/* STACKABLE */
.stackable-badge {
    background-color: rgb(128, 207, 149);
    color: rgb(20, 20, 20);
    font-size: 9px;
    border-radius: 4px;
    padding: 1px 4px;
    -unity-text-align: middle-center;
    align-self: flex-start;
    margin-top: 2px;
}
.stackable-bar-bg {
    height: 3px;
    background-color: rgb(60, 60, 60);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 5px;
}
.stackable-bar-fill {
    height: 100%;
    background-color: rgb(128, 207, 149);
    border-radius: 2px;
}
.stackable-count {
    font-size: 10px;
    color: rgb(128, 207, 149);
    margin-top: 2px;
}

/* HAKEN */
.erfolg-check {
    font-size: 14px;
    color: rgb(128, 207, 149);
    flex-shrink: 0;
    margin-left: 4px;
    align-self: flex-start;
}
