        <!-- Popup root unveraendert -->
        <ui:VisualElement name="popup-root" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.75); align-items: center; justify-content: center; display: none;"/>

