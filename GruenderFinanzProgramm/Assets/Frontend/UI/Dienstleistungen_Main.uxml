                        <ui:Button name="btn-del-3" text="Löschen" style="background-color: rgb(128, 207, 149); border-width: 0; border-radius: 8px; color: rgb(0, 0, 0); font-size: 14px; -unity-font-style: bold; height: 38px; flex-grow: 1; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=8cf7aafec04adfb46bae3114f5129d41&amp;type=3#Poppins-SemiBold&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Karte 4 Logo -->
                <ui:VisualElement name="card-4" class="service-card grid-item col-4" style="background-color: rgb(0, 0, 0);">
