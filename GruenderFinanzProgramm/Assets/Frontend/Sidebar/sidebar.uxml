        </ui:ScrollView>
        <ui:VisualElement name="footer" style="position: absolute; height: 120px; width: 100%; bottom: 0; left: 0; flex-direction: row; align-items: center; border-top-color: rgb(145, 145, 145); border-top-width: 2px; overflow: hidden; padding-left: 16px;">
            <ui:VisualElement name="Avatar" style="width: 50px; height: 50px; background-color: rgb(128, 207, 149); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-right-radius: 100px; border-bottom-left-radius: 100px; flex-shrink: 0;"/>
            <ui:Label name="footer-name" text="Max Krause" style="color: rgb(255, 255, 255); font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=1020e25b429ea8440abbfff09d2eaa66&amp;type=3#Poppins-Bold&quot;); margin-left: 16px; white-space: nowrap; overflow: hidden;"/>
