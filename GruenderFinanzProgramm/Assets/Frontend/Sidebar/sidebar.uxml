            </ui:VisualElement>
            <ui:VisualElement name="nav-item-export" class="nav-item" style="height: 52px; flex-direction: row; align-items: center; margin-top: 4px; margin-bottom: 4px; margin-left: 8px; margin-right: 8px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; overflow: hidden; padding-left: 0; padding-right: 0;">
                <ui:RadioButton name="radio-export" value="false" style="width: 52px; height: 52px; flex-shrink: 0; justify-content: center; align-items: center; margin-left: 0; margin-right: 0; padding-left: 0; left: 5px;"/>
