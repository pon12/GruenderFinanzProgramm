                <ui:Label text="Kostenrechner" class="nav-label" style="font-size: 24px; color: rgb(255, 255, 255); white-space: nowrap; overflow: hidden; left: 10px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="nav-item-statistik" class="nav-item" style="height: 52px; flex-direction: row; align-items: center; margin-top: 4px; margin-bottom: 4px; margin-left: 8px; margin-right: 8px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; overflow: hidden; padding-left: 0; padding-right: 0;">
                <ui:RadioButton name="radio-statistik" value="false" style="width: 52px; height: 52px; flex-shrink: 0; justify-content: center; align-items: center; margin-left: 0; margin-right: 0; padding-left: 0; left: 5px;"/>
                <ui:Label text="Statistik" class="nav-label" style="font-size: 24px; color: rgb(255, 255, 255); white-space: nowrap; overflow: hidden; left: 10px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="nav-item-rechnung" class="nav-item" style="height: 52px; flex-direction: row; align-items: center; margin-top: 4px; margin-bottom: 4px; margin-left: 8px; margin-right: 8px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; overflow: hidden; padding-left: 0; padding-right: 0;">
                <ui:RadioButton name="radio-rechnung" value="false" style="width: 52px; height: 52px; flex-shrink: 0; justify-content: center; align-items: center; margin-left: 0; margin-right: 0; padding-left: 0; left: 5px;"/>
