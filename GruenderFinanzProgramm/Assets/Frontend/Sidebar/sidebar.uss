/* ── NAV ITEMS – Basis ─────────────────────── */
.nav-item {
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

/* ── Hover ─────────────────────────────────── */
.nav-item:hover {
    background-color: rgba(128, 207, 149, 0.15);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(128, 207, 149, 0.5);
    border-right-color: rgba(128, 207, 149, 0.5);
    border-top-color: rgba(128, 207, 149, 0.5);
    border-bottom-color: rgba(128, 207, 149, 0.5);
}

.nav-item:hover .unity-radio-button__checkmark-background {
    border-color: rgb(128, 207, 149);
    background-color: rgba(128, 207, 149, 0.25);
}

/* ── Aktiv ─────────────────────────────────── */
.nav-item--active {
    background-color: rgba(128, 207, 149, 0.18);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-top-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
}

/* Grün ausgefüllter Kreis */
.nav-item--active .unity-radio-button__checkmark-background {
    background-color: rgb(128, 207, 149);
    border-color: rgb(80, 180, 110);
}

/* Weißer Punkt in der Mitte */
.nav-item--active .unity-radio-button__checkmark {
    background-color: rgb(255, 255, 255);
    width: 10px;
    height: 10px;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
}

.nav-item--active:hover {
    background-color: rgba(128, 207, 149, 0.28);
}

/* ── RadioButton Zentrierung ───────────────── */

/* Das äußere RadioButton-Element zentrieren */
.unity-radio-button {
    justify-content: center;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

/* Den Kreis selbst horizontal zentrieren */
.unity-radio-button__checkmark-background {
    margin-left: auto;
    margin-right: auto;
}

/* Den Label-Teil des RadioButtons ausblenden (wir nutzen eigene Labels) */
.unity-radio-button > .unity-label {
    display: none;
}
