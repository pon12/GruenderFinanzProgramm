:root {
}

.Anmelden-button {
    background-color: rgb(128, 207, 149);
    font-size: 30px;
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    padding: 10px 20px;
}

.Konto-button {
    background-color: rgb(100, 100, 100);
    font-size: 30px;
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    padding: 10px 20px;
}

.btn-beenden{
    background-color: rgb(230, 57, 70);
    font-size: 30px;
    color: white;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 0;
    padding: 10px 20px;
}

.text2 {
    color: rgb(174, 174, 174);
    -unity-text-align: middle-center;
    font-size: 39px;
    -unity-font-definition: url("project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=bd89cb14730400b4bbcff7e0926565fc&type=3#Poppins-Bold");
}

.text {
    color: rgb(174, 174, 174);
    -unity-text-align: middle-center;
    font-size: 49px;
    -unity-font-definition: url("project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=bd89cb14730400b4bbcff7e0926565fc&type=3#Poppins-Bold");
}

.ueberschrift {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 90px;
    -unity-font-definition: url("project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=bd89cb14730400b4bbcff7e0926565fc&type=3#Poppins-Bold");
}

/* ── Grüner Button (Anmelden) ─────────────────────── */

.Anmelden-button {
    transition-property: background-color, border-width;
    transition-duration: 0.12s;
    transition-timing-function: ease;
    border-width: 0;
}

.Anmelden-button:hover {
    background-color: rgb(179, 226, 196);
}

.Anmelden-button:active {
    background-color: rgb(95, 170, 115);
    border-width: 0;
    translate: 0 2px;
}


/* ── Grauer Button (Konto erstellen) ──────────────── */

.Konto-button {
    transition-property: background-color, border-color, border-width;
    transition-duration: 0.12s;
    transition-timing-function: ease;
    border-width: 0;
}

.Konto-button:hover {
    background-color: rgb(142, 141, 141);
}

.Konto-button:active {
    background-color: rgb(55, 55, 55);
    border-color: rgb(100, 180, 125);
    border-width: 3px;
    translate: 0 2px;
}


/* -- Roter button /software beenden) ---------------------- */
.btn-beenden:hover {
    background-color: rgb(229, 103, 112);
}


/* ── Zahlenpad Buttons (Passkey Popup) ────────────── */

.passkey-num-btn {
    transition-property: background-color, border-width;
    transition-duration: 0.08s;
    transition-timing-function: ease;
    border-width: 0;
}

.passkey-num-btn:hover {
    background-color: rgb(55, 55, 55);
    border-color: rgb(128, 207, 149);
    border-width: 2px;
}

.passkey-num-btn:active {
    background-color: rgb(128, 207, 149);
    border-width: 0;
    translate: 0 2px;
}

/* ── Grüner Button im Popup (Erstellen / Anmelden) ─── */

.popup-btn-green {
    background-color: rgb(128, 207, 149);
    transition-property: background-color, border-width;
    transition-duration: 0.12s;
    transition-timing-function: ease;
}

.popup-btn-green:hover {
    background-color: rgb(179, 226, 196);
}

.popup-btn-green:active {
    background-color: rgb(95, 170, 115);
    border-width: 0;
    translate: 0 2px;
}


/* ── Zahlenpad Buttons ──────────────────────────────── */

.passkey-num-btn {
    transition-property: background-color, border-color, border-width;
    transition-duration: 0.08s;
    transition-timing-function: ease;
}

.passkey-num-btn:hover {
    background-color: rgb(55, 55, 55);
    border-color: rgb(128, 207, 149);
    border-width: 2px;
}

.passkey-num-btn:active {
    background-color: rgb(128, 207, 149);
    color: rgb(0, 0, 0);
    border-width: 0;
    translate: 0 2px;
}


/* ── X Schließen Button ─────────────────────────────── */

.popup-close-btn {
    transition-property: color, background-color;
    transition-duration: 0.1s;
}

.popup-close-btn:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
}

.popup-close-btn:active {
    background-color: rgba(255, 255, 255, 0.2);
}