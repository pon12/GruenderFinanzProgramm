                <ui:Label text="0" name="lbl-kunden" class="stat-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="stat-angebote" class="stat-card" style="flex-grow: 1;">
                <ui:Label text="Angebote erstellt" class="stat-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                <ui:Label text="0" name="lbl-angebote" class="stat-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="stat-rechnungen" class="stat-card" style="flex-grow: 1;">
                <ui:Label text="Rechnungen gestellt" class="stat-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                <ui:Label text="0" name="lbl-rechnungen" class="stat-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="stat-kassenbuch" class="stat-card" style="flex-grow: 1;">
                <ui:Label text="Kassenbuch-Umsatz Jahr" class="stat-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                <ui:Label text="€0" name="lbl-kassenbuch" class="stat-value" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="stat-kontostand" class="stat-card" style="flex-grow: 1;">
