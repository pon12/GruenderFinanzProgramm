<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/DashboardStyles.uss?fileID=7433441132597879392&amp;guid=fe9c9a54b138ecc469e247e562306177&amp;type=3#DashboardStyles"/>
    <ui:VisualElement name="dashboard-root" style="flex-grow: 1; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 430px;">
        <ui:VisualElement name="progress-section" class="progress-section">
            <ui:VisualElement name="progress-header" class="progress-header">
                <ui:Label text="Dokumenten-Vollständigkeit" name="section-title" class="section-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                <ui:Label text="45%" name="lbl-progress-percent" class="progress-percent" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="progress-segments-row" class="progress-segments-row">
                <ui:VisualElement name="seg-stammdaten" class="progress-segment-wrap">
                    <ui:VisualElement name="seg-bg-stammdaten" class="seg-bg">
                        <ui:VisualElement name="seg-fill-stammdaten" class="seg-fill seg-full"/>
                    </ui:VisualElement>
                    <ui:Label text="Stammdaten" class="seg-label" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="seg-vertraege" class="progress-segment-wrap">
                    <ui:VisualElement name="seg-bg-vertraege" class="seg-bg">
                        <ui:VisualElement name="seg-fill-vertraege" class="seg-fill seg-full"/>
                    </ui:VisualElement>
                    <ui:Label text="Verträge" class="seg-label" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="seg-steuer" class="progress-segment-wrap">
                    <ui:VisualElement name="seg-bg-steuer" class="seg-bg">
                        <ui:VisualElement name="seg-fill-steuer" class="seg-fill seg-partial"/>
                    </ui:VisualElement>
                    <ui:Label text="Steuerunterlagen" class="seg-label" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="seg-rechnungen" class="progress-segment-wrap">
                    <ui:VisualElement name="seg-bg-rechnungen" class="seg-bg">
                        <ui:VisualElement name="seg-fill-rechnungen" class="seg-fill seg-empty"/>
                    </ui:VisualElement>
                    <ui:Label text="Rechnungen" class="seg-label" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="seg-sonstiges" class="progress-segment-wrap">
                    <ui:VisualElement name="seg-bg-sonstiges" class="seg-bg">
