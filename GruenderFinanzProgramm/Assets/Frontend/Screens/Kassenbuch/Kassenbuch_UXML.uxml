        <ui:VisualElement name="confirm-overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); align-items: center; justify-content: center; padding: 40px;">
            <ui:VisualElement style="width: 100%; max-width: 480px; padding: 28px; flex-direction: column; background-color: rgb(38, 38, 38); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                    <ui:Label text="⚠ Eintrag löschen?" style="font-size: 20px; color: rgb(255,255,255); -unity-font-style: bold; flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:Label text="Möchtest du diesen Eintrag wirklich löschen?" style="font-size: 14px; color: rgb(200,200,200); margin-bottom: 6px;"/>
                <ui:Label text="Diese Aktion kann nicht widerrufen werden." style="font-size: 13px; color: rgb(150,150,150); margin-bottom: 20px;"/>
