                    <ui:Button name="btn-confirm-ja" text="Endgültig löschen" style="height: 38px; padding-left: 20px; padding-right: 20px; background-color: rgba(230,57,70,0); color: rgb(230,57,70); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(230,57,70); border-right-color: rgb(230,57,70); border-bottom-color: rgb(230,57,70); border-left-color: rgb(230,57,70); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
