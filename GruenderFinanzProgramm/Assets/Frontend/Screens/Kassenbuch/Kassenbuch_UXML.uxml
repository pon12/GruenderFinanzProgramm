                    <ui:VisualElement name="btn-help-popup" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 8px; width: 36px; height: 36px; min-width: 36px; min-height: 36px;"/>
