    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/TransactionPopup.uss?fileID=7433441132597879392&amp;guid=701f9ef6a140abe468ef02fb200ea930&amp;type=3#TransactionPopup"/>
    <ui:VisualElement name="root" class="root fullscreen-bg grid-container" style="flex-direction: row; flex-wrap: nowrap; align-items: stretch; justify-content: flex-start; align-self: flex-start; width: 100%; -unity-text-align: upper-left; background-position-x: center; flex-grow: 0; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" class="main grid-item" style="flex-grow: 1; padding-left: 430px; padding-right: 46px; height: 100%;">
            <ui:VisualElement name="Export" class="header-row" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between; height: auto; max-height: 70px; width: 100%;">
                <ui:VisualElement style="flex-direction: row; align-items: center;">
                    <ui:Label text="Kassenbuch" name="Label" style="font-size: 46px; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:VisualElement name="btn-help-seitentitel" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 8px; width: 36px; height: 36px; min-width: 36px; min-height: 36px; top: 10px;"/>
                </ui:VisualElement>
                <ui:DropdownField label="Jahr:" name="dropJahr" class="jahr-dropdown"/>
            </ui:VisualElement>
            <ui:VisualElement name="Kontostand" class="kontostand-section" style="margin-top: 8px; margin-right: 8px; margin-bottom: 8px; margin-left: 8px; flex-direction: column;">
                <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: center;">
                    <ui:Label text="Kontostand" class="kontostand-label h2" style="font-size: 36px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="btn-help-kontostand" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 8px; width: 36px; height: 36px; min-width: 36px; min-height: 36px; top: 10px;"/>
                </ui:VisualElement>
                <ui:Label text="8€" name="balanceLabel" class="balance" style="color: rgb(128, 207, 149); font-size: 48px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); -unity-text-align: upper-center;"/>
                <ui:Label text="Letzte Aktualisierung: 02.02.2222" name="letzteAktual" class="update-label" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); -unity-text-align: upper-center;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Buttons" class="button-row-3" style="flex-direction: row; justify-content: center; align-items: center; margin-top: 16px; margin-right: 16px; margin-bottom: 16px; margin-left: 16px; height: auto; max-height: 50px;">
                <ui:Button text="Ausgaben hinzufügen" name="btnAusgaben" double-click-selects-word="false" triple-click-selects-line="false" icon-image="" class="btn-action-3er btn-red"/>
                <ui:VisualElement name="btn-help-ausgaben" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 0; width: 28px; height: 28px; min-width: 28px; min-height: 28px;"/>
                <ui:Button text="Einnahmen hinzufügen" name="btnEinnahmen" double-click-selects-word="false" triple-click-selects-line="false" class="btn-action-3er btn-green"/>
                <ui:VisualElement name="btn-help-einnahmen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 0; width: 28px; height: 28px; min-width: 28px; min-height: 28px;"/>
                <ui:Button text="Für Finanzamt exportieren" name="FinanzExport" class="btn-action-3er btn-export-finanzamt"/>
                <ui:VisualElement name="btn-help-finanzexport" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); flex-shrink: 0; margin-left: 0; width: 28px; height: 28px; min-width: 28px; min-height: 28px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="Tabelle" class="table-wrapper">
                <ui:VisualElement name="Table-Header" class="row row-header">
                    <ui:Label text="Name &amp; Verwendungszweck" class="cell cell-name"/>
                    <ui:Label text="Buchungstag"                 class="cell cell-datum"/>
                    <ui:Label text="Betrag"                      class="cell cell-betrag"/>
                    <ui:Label text="Art"                         class="cell cell-art"/>
                    <ui:Label text="Einnahme / Ausgabe"          class="cell cell-typ"/>
                    <ui:VisualElement name="btn-help-tabelle" class="cell cell-action" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); -unity-background-scale-mode: scale-to-fit;"/>
                </ui:VisualElement>
                <ui:ScrollView name="tableBody" class="table-body" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-overlay" class="popup-overlay" style="display: none; top: 2px; left: -2px;">
            <ui:VisualElement name="popup-container" class="popup-container card" style="display: flex;">
