<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Fortschritt.uss"/>
    <ui:VisualElement name="root-container" style="flex-grow: 1; background-color: rgb(30, 30, 30);">
        <ui:ScrollView name="main-content" style="flex: 1; flex-direction: column; padding: 30px 40px 20px 430px;">

            <!-- Header -->
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <ui:VisualElement>
                    <ui:Label text="Fortschritt" class="page-title"/>
                    <ui:Label text="Dein Überblick über den gesamten Gründungsfortschritt" class="page-subtitle"/>
                </ui:VisualElement>
                <ui:Label name="lbl-gesamt-prozent" text="0%" class="gesamt-prozent-label"/>
            </ui:VisualElement>

            <!-- Segmentierter Fortschrittsbalken wie Dashboard -->
            <ui:VisualElement class="progress-section">
                <ui:VisualElement class="progress-header">
                    <ui:Label text="Gesamtfortschritt Gründung" class="section-title"/>
                    <ui:Label name="lbl-gesamt-text" text="0 von 0 Schritten" class="progress-percent"/>
                </ui:VisualElement>
                <ui:VisualElement name="progress-segments-row" class="progress-segments-row">
                    <ui:VisualElement name="seg-vorbereitung" class="progress-segment-wrap">
                        <ui:VisualElement class="seg-bg">
                            <ui:VisualElement name="seg-fill-vorbereitung" class="seg-fill" style="width: 0%;"/>
                        </ui:VisualElement>
                        <ui:Label text="Vorbereitung" class="seg-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="seg-anmeldung" class="progress-segment-wrap">
                        <ui:VisualElement class="seg-bg">
                            <ui:VisualElement name="seg-fill-anmeldung" class="seg-fill" style="width: 0%;"/>
                        </ui:VisualElement>
                        <ui:Label text="Anmeldung" class="seg-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="seg-finanzen" class="progress-segment-wrap">
                        <ui:VisualElement class="seg-bg">
                            <ui:VisualElement name="seg-fill-finanzen" class="seg-fill" style="width: 0%;"/>
                        </ui:VisualElement>
                        <ui:Label text="Finanzen" class="seg-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="seg-betrieb" class="progress-segment-wrap">
                        <ui:VisualElement class="seg-bg">
                            <ui:VisualElement name="seg-fill-betrieb" class="seg-fill" style="width: 0%;"/>
                        </ui:VisualElement>
                        <ui:Label text="Betrieb" class="seg-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="seg-sonstiges" class="progress-segment-wrap">
                        <ui:VisualElement class="seg-bg">
                            <ui:VisualElement name="seg-fill-sonstiges" class="seg-fill" style="width: 0%;"/>
                        </ui:VisualElement>
                        <ui:Label text="Sonstiges" class="seg-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Mittlere Reihe mit gleicher Höhe -->
            <ui:VisualElement style="flex-direction: row; margin-bottom: 24px; align-items: stretch;">

                <!-- Gründerpfad Phasen -->
                <ui:VisualElement class="panel-box" style="flex-grow: 1; margin-right: 16px;">
                    <ui:Label text="Gründerpfad" class="panel-title" style="margin-bottom: 12px;"/>
                    <ui:VisualElement name="phasen-container" style="flex-direction: column; flex-grow: 1;"/>
                </ui:VisualElement>

                <!-- Nächste Schritte -->
                <ui:VisualElement class="panel-box" style="flex-grow: 1;">
                    <ui:Label text="Nächste Schritte" class="panel-title" style="margin-bottom: 12px;"/>
                    <ui:VisualElement name="naechste-schritte-container" style="flex-direction: column; flex-grow: 1;"/>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Letzte Erfolge -->
            <ui:VisualElement class="panel-box" style="margin-bottom: 24px;">
                <ui:Label text="Letzte Erfolge" class="panel-title" style="margin-bottom: 12px;"/>
                <ui:VisualElement name="letzte-erfolge-container" style="flex-direction: row; flex-wrap: wrap;"/>
            </ui:VisualElement>

        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
