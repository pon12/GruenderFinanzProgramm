                                <ui:Button text="Mitwirkende" name="btn-open-mitwirkende" class="btn-grey" style="flex: 1; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 40px; font-size: 14px;"/>
