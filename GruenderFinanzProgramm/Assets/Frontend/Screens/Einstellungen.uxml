                                <ui:Label text="Handelsregisternummer" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 6px;"/>
                                <ui:TextField name="input-handelsreg" class="dark-input" style="height: 40px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="margin-bottom: 14px;">
                                <ui:Label text="Straße und Hausnummer" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 6px;"/>
                                <ui:TextField name="input-strasse" class="dark-input" style="height: 40px;"/>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row;">
                                <ui:VisualElement style="flex: 1; margin-right: 8px;">
                                    <ui:Label text="Postleitzahl" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 6px;"/>
                                    <ui:TextField name="input-plz" class="dark-input" style="height: 40px;"/>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex: 2;">
                                    <ui:Label text="Stadt" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 6px;"/>
                                    <ui:TextField name="input-stadt" class="dark-input" style="height: 40px;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-pdf" style="background-color: rgb(38, 38, 38); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                                <ui:VisualElement style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(100, 149, 237); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="PDF Export und Layout" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                            </ui:VisualElement>
                            <ui:Toggle name="toggle-logo" label="Logo auf der Rechnung anzeigen" style="font-size: 16px; margin-bottom: 12px;"/>
                            <ui:Toggle name="toggle-seitenzahl" label="Seitenzahl im Fußbereich" style="font-size: 16px; margin-bottom: 12px;"/>
                            <ui:Toggle name="toggle-exportpfad" label="Letzten Exportpfad merken" style="font-size: 16px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-steuersaetze" style="background-color: rgb(38, 38, 38); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                                <ui:VisualElement style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(255, 165, 60); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="Steuersätze" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                            </ui:VisualElement>
                            <ui:Label text="Standardsteuersatz für Dienstleistungen" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 10px;"/>
                            <ui:VisualElement style="flex-direction: row;">
                                <ui:Button text="7 %" name="btn-steuer-7" style="flex: 1; margin-right: 8px; background-color: rgb(50, 50, 50); color: rgb(200, 200, 200); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-width: 0; height: 44px; font-size: 16px;"/>
                                <ui:Button text="10 %" name="btn-steuer-10" style="flex: 1; margin-right: 8px; background-color: rgb(50, 50, 50); color: rgb(200, 200, 200); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-width: 0; height: 44px; font-size: 16px;"/>
                                <ui:Button text="19 %" name="btn-steuer-19" style="flex: 1; background-color: rgb(128, 207, 149); color: rgb(0, 0, 0); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-width: 0; height: 44px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-layout" style="background-color: rgb(38, 38, 38); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                                <ui:VisualElement style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(180, 100, 220); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="Layout und Design" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                            </ui:VisualElement>
                            <ui:Label text="Anzeigemodus" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 10px;"/>
                            <ui:VisualElement style="flex-direction: row; margin-bottom: 16px;">
