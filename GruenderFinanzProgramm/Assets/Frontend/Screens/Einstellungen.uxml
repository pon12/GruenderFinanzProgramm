                            <ui:VisualElement name="row-anzeigemodus-buttons" style="flex-direction: row; margin-bottom: 16px;">
                                <ui:Button text="Hell" name="btn-light-mode" class="btn-modus" style="flex: 1; margin-right: 8px; background-color: rgb(50, 50, 50); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 44px; font-size: 16px;"/>
