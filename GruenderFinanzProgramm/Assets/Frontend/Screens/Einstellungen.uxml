                                <ui:Label text="Steuersätze" name="label-titel-steuersaetze" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                                <ui:VisualElement name="spacer-titel-steuersaetze" style="flex-grow: 1;"/>
                                <ui:VisualElement name="btn-help-steuersaetze" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                            </ui:VisualElement>
                            <ui:Label text="Standardsteuersatz für Dienstleistungen" name="label-beschreibung-steuersaetze" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 10px;"/>
                            <ui:VisualElement name="row-steuer-buttons" style="flex-direction: row; margin-bottom: 12px;">
                                <ui:Button text="7 %" name="btn-steuer-7" class="btn-steuer" style="flex: 1; margin-right: 8px; background-color: rgb(50, 50, 50); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 44px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                                <ui:Button text="10 %" name="btn-steuer-10" class="btn-steuer" style="flex: 1; margin-right: 8px; background-color: rgb(50, 50, 50); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 44px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                                <ui:Button text="19 %" name="btn-steuer-19" class="btn-steuer" style="flex: 1; margin-right: 8px; background-color: rgb(128, 207, 149); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 44px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                                <ui:Button text="Eigener" name="btn-steuer-custom" class="btn-steuer" style="flex: 1; background-color: rgb(50, 50, 50); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; height: 44px; font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="container-steuer-custom" style="display: none; flex-direction: row; align-items: center;">
                                <ui:Label text="Eigener Steuersatz (%):" name="label-eigener-steuersatz" style="font-size: 13px; color: rgb(160, 160, 160); margin-right: 12px; flex-shrink: 0;"/>
                                <ui:TextField name="input-steuer-custom" value="0" class="dark-input" style="width: 100px; height: 40px;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-layout" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement name="row-titel-layout" style="flex-direction: row; align-items: center; margin-bottom: 20px;">
