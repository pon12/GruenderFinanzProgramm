                                <ui:Label text="Rechnungsformat" name="label-titel-rechnungsformat" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                                <ui:VisualElement name="spacer-titel-rechnungsformat" style="flex-grow: 1;"/>
                                <ui:VisualElement name="btn-help-rechnungsformat" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                            </ui:VisualElement>
                            <ui:Label text="Nummernkreis, Zahlungsziel, Währung und Standardtexte" name="label-beschreibung-rechnungsformat" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 16px;"/>
                            <ui:Button text="Rechnungsformat bearbeiten" name="btn-open-rechnung" class="btn-grey" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; height: 44px; font-size: 15px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-bezahlweise" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement name="row-titel-bezahlweise" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                                <ui:VisualElement name="dot-bezahlweise" style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(128, 207, 149); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="Bezahlweise" name="label-titel-bezahlweise" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                                <ui:VisualElement name="spacer-titel-bezahlweise" style="flex-grow: 1;"/>
                                <ui:VisualElement name="btn-help-bezahlweise" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                            </ui:VisualElement>
                            <ui:Label text="AGB, Disclaimer, Barzahlung und Überweisungshinweis" name="label-beschreibung-bezahlweise" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 16px;"/>
                            <ui:Button text="Dokumente verwalten" name="btn-open-bezahlweise" class="btn-grey" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; height: 44px; font-size: 15px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-version" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px;">
                            <ui:VisualElement name="row-titel-version" style="flex-direction: row; align-items: center; margin-bottom: 16px;">
