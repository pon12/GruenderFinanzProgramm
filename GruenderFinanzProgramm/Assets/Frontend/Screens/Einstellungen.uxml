<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <Style src="project://database/Assets/Frontend/Sidebar/sidebar.uss?fileID=7433441132597879392&amp;guid=75a81b0b36c221f47b38dc27c4b347a9&amp;type=3#sidebar"/>
    <Style src="project://database/Assets/Frontend/Sidebar/Background.uss?fileID=7433441132597879392&amp;guid=e9732cc7f93bcd84490af24dc10b4fbb&amp;type=3#Background"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Einstellungen%20USS.uss?fileID=7433441132597879392&amp;guid=c4a9726888d324748923be9caf3a73ab&amp;type=3#Einstellungen USS"/>
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <ui:VisualElement name="root" class="root fullscreen-bg" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" style="flex-grow: 1; padding-left: 430px; padding-right: 32px; padding-top: 24px; padding-bottom: 24px; flex-direction: column;">
            <ui:VisualElement name="header" style="flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-shrink: 0;">
                <ui:Label text="Einstellungen" name="label-seitentitel" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 48px; color: rgb(255, 255, 255);"/>
                <ui:VisualElement name="btn-help-seitentitel" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                <ui:VisualElement name="spacer-kopfzeile" style="flex-grow: 1;"/>
                <ui:VisualElement name="header-buttons" style="flex-direction: row;">
                    <ui:Button text="zurücksetzen" name="btn-reset" class="btn-red" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 24px; padding-right: 24px; font-size: 18px; margin-right: 12px;"/>                    <ui:Button text="speichern" name="btn-save" style="background-color: rgb(128, 207, 149); color: rgb(0, 0, 0); border-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 24px; padding-right: 24px; font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="settings-scroll" style="flex-grow: 1;">
                <ui:VisualElement name="columns" style="flex-direction: row; flex-wrap: nowrap; align-items: flex-start;">
                    <ui:VisualElement name="col-left" style="flex: 1; margin-right: 16px; flex-direction: column;">
                        <ui:VisualElement name="card-unternehmen" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement name="row-titel-unternehmen" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                                <ui:VisualElement name="dot-unternehmen" style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(128, 207, 149); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="Unternehmen" name="label-titel-unternehmen" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                                <ui:VisualElement name="spacer-titel-unternehmen" style="flex-grow: 1;"/>
                                <ui:VisualElement name="btn-help-unternehmen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                            </ui:VisualElement>
                            <ui:Label text="Firmenname, Rechtsform, Adresse und Steuerdaten" name="label-beschreibung-unternehmen" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 16px;"/>
                            <ui:Button text="Unternehmensdaten bearbeiten" name="btn-open-unternehmen" class="btn-grey" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; height: 44px; font-size: 15px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-bank" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement name="row-titel-bank" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                                <ui:VisualElement name="dot-bank" style="width: 14px; height: 14px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; background-color: rgb(100, 149, 237); margin-right: 10px; flex-shrink: 0;"/>
                                <ui:Label text="Bankverbindung" name="label-titel-bank" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); font-size: 20px; color: rgb(255, 255, 255);"/>
                                <ui:VisualElement name="spacer-titel-bank" style="flex-grow: 1;"/>
                                <ui:VisualElement name="btn-help-bank" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                            </ui:VisualElement>
                            <ui:Label text="IBAN, BIC, Kontoinhaber und Kreditinstitut" name="label-beschreibung-bank" style="font-size: 13px; color: rgb(160, 160, 160); margin-bottom: 16px;"/>
                            <ui:Button text="Bankdaten bearbeiten" name="btn-open-bank" class="btn-grey" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; height: 44px; font-size: 15px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="card-rechnung-btn" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
                            <ui:VisualElement name="row-titel-rechnungsformat" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
