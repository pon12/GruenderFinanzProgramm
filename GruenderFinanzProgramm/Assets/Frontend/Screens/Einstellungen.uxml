                <ui:Label text="Bitte notiere deinen neuen Passkey. Er wird nur einmal angezeigt." style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&amp;guid=208850aa048ae4a4a897f2e5fb1d9380&amp;type=3#Poppins-Regular&quot;); font-size: 15px; color: rgb(160, 160, 160); -unity-text-align: upper-center; white-space: normal; margin-bottom: 32px;"/>
                <ui:VisualElement style="background-color: rgb(28, 28, 28); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; padding-top: 20px; padding-bottom: 20px; padding-left: 40px; padding-right: 40px; margin-bottom: 12px; border-top-color: rgb(128, 207, 149); border-right-color: rgb(128, 207, 149); border-bottom-color: rgb(128, 207, 149); border-left-color: rgb(128, 207, 149); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
