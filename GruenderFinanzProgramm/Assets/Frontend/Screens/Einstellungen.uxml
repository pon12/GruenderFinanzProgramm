                                <ui:Label name="label-version" text="Version 1.0.0" style="font-size: 16px; color: rgb(160, 160, 160);"/>
                                <ui:VisualElement name="row-version-aktionen" style="flex-direction: row; align-items: center;">
                                    <ui:Button text="Backup erstellen" name="btn-create-backup" class="btn-grey" style="border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; font-size: 13px; margin-right: 8px;"/>
                                    <ui:Button text="Neuestes Backup laden" name="btn-restore-backup" class="btn-grey" style="border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; padding-top: 8px; padding-bottom: 8px; padding-left: 12px; padding-right: 12px; font-size: 13px; margin-right: 8px;"/>
                                    <ui:Button text="Nach Updates suchen" name="btn-update" class="btn-grey" style="border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; padding-top: 8px; padding-bottom: 8px; padding-left: 20px; padding-right: 20px; font-size: 14px;"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="row-credits-buttons" style="flex-direction: row;">
