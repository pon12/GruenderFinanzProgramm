                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; background-color: rgb(50, 50, 50); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding: 16px;">
                                <ui:VisualElement style="flex-direction: column;">
