                    <ui:VisualElement name="col-right" style="flex: 1; flex-direction: column;">
                        <ui:VisualElement name="card-steuersaetze" style="background-color: rgb(44, 44, 44); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px; margin-bottom: 16px;">
