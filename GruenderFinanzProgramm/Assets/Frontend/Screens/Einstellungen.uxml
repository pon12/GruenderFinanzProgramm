                        <ui:VisualElement name="card-version" style="background-color: rgb(38, 38, 38); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; padding: 24px;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
