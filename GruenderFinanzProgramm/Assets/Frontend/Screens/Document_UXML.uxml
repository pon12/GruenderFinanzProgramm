<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Doc-Screen.uss?fileID=7433441132597879392&amp;guid=7f80ac4667a2566429f65c50cc73fc61&amp;type=3#Doc-Screen"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Helptooltip.uss?fileID=7433441132597879392&amp;guid=93ae44093179d5b4abba4a8128fdc6da&amp;type=3#Helptooltip"/>
    <ui:VisualElement name="root-container" class="screen-root" style="width: 100%; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" style="flex: 1; flex-direction: column; padding: 30px 40px 0 430px; overflow: hidden;">
            <ui:VisualElement name="page-header-row" style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <ui:VisualElement name="row-titel-gruppe" style="flex-direction: row; align-items: center;">
                    <ui:VisualElement name="container-titel-text">
                        <ui:Label text="Dokumente" name="page-title" class="page-title"/>
                        <ui:Label text="Zentrale Dokumentablage – feste und individuelle Kategorien" name="label-untertitel" class="page-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="btn-help-seitentitel" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px; right: 195px; bottom: 14px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="row-alle-loeschen" style="flex-direction: row; align-items: center;">
                    <ui:VisualElement name="btn-help-hinzufuegen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-right: 8px;"/>
                    <ui:Button text="+ Dokument hinzufügen" name="Btn-Add-Document" class="doc-btn-primary" style="margin-right: 16px;"/>
                    <ui:VisualElement name="btn-help-alle-loeschen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                    <ui:Button text="Alle löschen" name="Delete-Button" class="doc-btn-danger-outline" style="margin-left: 8px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="Main-Scroll-View" style="flex-grow: 1;">
                <ui:VisualElement name="Grid-Container" class="grid-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Popup-Window" class="doc-card popup-window">
                <ui:VisualElement name="Popup-Header" class="popup-header-row">
                    <ui:VisualElement name="container-popup-erstellen-titel">
                        <ui:Label text="Neues Dokument" name="label-popup-erstellen-titel" class="card-title"/>
                        <ui:Label text="Titel und Kategorie wählen" name="label-popup-erstellen-untertitel" class="card-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-popup-erstellen-buttons" style="flex-direction: row; align-items: center;">
                        <ui:VisualElement name="btn-help-popup-erstellen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                        <ui:Button text="← Zurück" name="Btn-Cancel" class="doc-btn-secondary" style="margin-left: 8px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-1" class="form-group">
                    <ui:Label text="Dokumenttitel *" name="label-feld-titel" class="field-label"/>
                    <ui:TextField label="" placeholder-text="z.B. Businessplan Q3" name="Doc-Name-Input"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-2" class="form-group">
                    <ui:Label text="Kategorie" name="label-feld-kategorie" class="field-label"/>
                    <ui:DropdownField label="" name="dropKategorie"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-3" class="form-group">
                    <ui:VisualElement name="row-vorlage-titel" style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                        <ui:Label text="Vorlage wählen" name="label-vorlage-titel" class="field-label" style="margin-bottom: 0;"/>
                        <ui:VisualElement name="btn-help-vorlage" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Template-Grid" class="template-grid">
                        <ui:Button text="Standard" name="Btn-Type-Standard" class="template-btn"/>
                        <ui:Button text="Diagramm" name="Btn-Type-Diagramm" class="template-btn"/>
                        <ui:Button text="Checklist" name="Btn-Type-Checklist" class="template-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Popup-Footer" class="popup-footer-row">
                    <ui:Button text="Abbrechen" name="Btn-Abbrechen" class="doc-btn-secondary"/>
                    <ui:Button text="Erstellen" name="Btn-Submit" class="doc-btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Detail-Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Detail-Menu-Container" class="doc-card detail-popup-box">
                <ui:VisualElement name="Detail-Header" class="popup-header-row">
                    <ui:Label text="Dokumenten-Liste" name="Detail-Popup-Title" class="card-title" style="flex-grow: 1;"/>
                    <ui:VisualElement name="row-detail-buttons" style="flex-direction: row; align-items: center;">
                        <ui:VisualElement name="btn-help-detail-liste" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                        <ui:Button text="Schließen" name="Btn-Detail-Close" class="doc-btn-secondary" style="margin-left: 8px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Detail-Split-Body" class="split-body-layout">
                    <ui:VisualElement name="Detail-Left-Column" class="column-half">
                        <ui:Label text="Kategorie-Dokumente" name="label-spalte-kategorie" class="column-header-title"/>
                        <ui:ScrollView name="Detail-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Detail-Right-Column" class="column-half">
                        <ui:Label text="Globale Dokumenten-Liste" name="label-spalte-global" class="column-header-title"/>
                        <ui:ScrollView name="Global-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="+ Neues Dokument erstellen" name="Btn-List-Create-New" class="doc-btn-primary" style="margin-top: 16px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Edit-Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Edit-Popup-Container" class="doc-card edit-popup-box">
                <ui:VisualElement name="row-popup-bearbeiten-titel" style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                    <ui:Label text="Dokument bearbeiten" name="label-popup-bearbeiten-titel" class="card-title" style="margin-bottom: 0;"/>
                    <ui:VisualElement name="btn-help-popup-bearbeiten" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                </ui:VisualElement>
                <ui:Label text="🔒 Pflichtdokument – Werte änderbar, aber nicht löschbar" name="Edit-Locked-Hint" class="locked-hint" style="display: none;"/>
                <ui:VisualElement name="feld-gruppe-edit-titel" class="form-group" style="margin-top: 12px;">
                    <ui:Label text="Titel" name="label-feld-edit-titel" class="field-label"/>
                    <ui:TextField label="" placeholder-text="Dokumenttitel" name="Edit-Doc-Name-Input"/>
                </ui:VisualElement>
                <ui:VisualElement name="row-strukturfelder-titel" style="flex-direction: row; align-items: center; margin-top: 8px; margin-bottom: 4px;">
                    <ui:Label text="Strukturfelder" name="label-strukturfelder-titel" style="font-size: 13px; color: rgb(160, 160, 160); flex-grow: 1;"/>
                    <ui:VisualElement name="btn-help-strukturfelder" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Edit-Struktur-Felder-Box" style="display: none;"/>
                <ui:VisualElement name="feld-gruppe-inhalt" class="form-group">
                    <ui:VisualElement name="feld-gruppe-standard-titel" style="margin-bottom: 10px;">
                        <ui:Label text="Titel" name="label-feld-standard-titel" class="field-label"/>
                        <ui:TextField label="" name="Edit-Standard-Titel-Input"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="feld-gruppe-standard-datum" style="margin-bottom: 10px;">
                        <ui:Label text="Datum" name="label-feld-standard-datum" class="field-label"/>
                        <ui:TextField label="" name="Edit-Standard-Datum-Input"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="feld-gruppe-standard-inhalt">
                        <ui:Label text="Inhalt" name="label-feld-inhalt" class="field-label"/>
                        <ui:TextField label="" name="Edit-Inhalt-Input" multiline="true" class="edit-textarea"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="feld-gruppe-checkliste" class="form-group" style="display: none;">
                    <ui:Label text="Checkliste" name="label-feld-checkliste" class="field-label"/>
                    <ui:ScrollView name="Edit-Checkliste-Box" style="max-height: 260px; background-color: rgb(30, 30, 30); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 8px;"/>
                    <ui:Button text="+ Punkt hinzufügen" name="Btn-Checkliste-Hinzufuegen" class="doc-btn-secondary" style="margin-top: 8px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="feld-gruppe-diagramm" class="form-group" style="display: none;">
                    <ui:Label text="Diagramm-Daten" name="label-feld-diagramm" class="field-label"/>
                    <ui:Label text="Trag hier Zeile für Zeile eine Bezeichnung und den dazugehörigen Zahlenwert ein - z.B. &quot;Januar&quot; und &quot;120&quot;. Jede Zeile wird unten als ein Balken angezeigt." name="hinweis-diagramm" style="font-size: 11px; color: rgb(150, 150, 150); white-space: normal; margin-bottom: 6px;"/>
                    <ui:VisualElement name="row-diagramm-spaltentitel" style="flex-direction: row; margin-bottom: 4px;">
                        <ui:Label text="Bezeichnung" name="label-diagramm-spalte-bezeichnung" style="flex-grow: 1; font-size: 11px; color: rgb(150, 150, 150);"/>
                        <ui:Label text="Wert" name="label-diagramm-spalte-wert" style="width: 80px; margin-right: 34px; font-size: 11px; color: rgb(150, 150, 150);"/>
                    </ui:VisualElement>
                    <ui:ScrollView name="Edit-Diagramm-Daten-Box" style="max-height: 220px; background-color: rgb(30, 30, 30); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding: 8px;"/>
                    <ui:Button text="+ Wert hinzufügen" name="Btn-Diagramm-Hinzufuegen" class="doc-btn-secondary" style="margin-top: 8px;"/>
                    <ui:Label text="Vorschau:" name="label-diagramm-vorschau-titel" style="font-size: 11px; color: rgb(150, 150, 150); margin-top: 10px;"/>
                    <ui:VisualElement name="Edit-Diagramm-Vorschau" style="height: 180px; margin-top: 4px; background-color: rgb(30, 30, 30); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="row-dokumenttyp-titel" style="flex-direction: row; align-items: center; margin-top: 12px; margin-bottom: 6px;">
                    <ui:Label text="Dokumenttyp" name="label-dokumenttyp-titel" style="font-size: 13px; color: rgb(160, 160, 160); flex-grow: 1;"/>
                    <ui:VisualElement name="btn-help-vorlagen-edit" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Edit-Buttons-Type-Group" class="template-grid">
                    <ui:Button text="Standard" name="Btn-Edit-Type-Standard" class="template-btn"/>
                    <ui:Button text="Diagramm" name="Btn-Edit-Type-Diagramm" class="template-btn"/>
                    <ui:Button text="Checklist" name="Btn-Edit-Type-Checklist" class="template-btn"/>
                </ui:VisualElement>
                <ui:VisualElement name="row-edit-footer" class="popup-footer-row" style="margin-top: 18px;">
                    <ui:Button text="Abbrechen" name="Btn-Edit-Cancel" class="doc-btn-secondary"/>
                    <ui:Button text="Fertig" name="Btn-Edit-Submit" class="doc-btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Delete-Confirm-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Delete-Confirm-Container" class="doc-card delete-confirm-box">
                <ui:VisualElement name="row-delete-confirm-titel" style="flex-direction: row; align-items: center; margin-bottom: 4px;">
                    <ui:Label text="⚠ Alle Dokumente löschen?" name="label-delete-confirm-titel" class="card-title" style="margin-bottom: 0;"/>
                    <ui:VisualElement name="btn-help-popup-loeschen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                </ui:VisualElement>
                <ui:Label text="" name="Delete-Confirm-Hint" class="delete-confirm-hint" style="margin-top: 10px; margin-bottom: 4px;"/>
                <ui:Label text="Diese Aktion kann nicht widerrufen werden." name="label-delete-confirm-hinweis" class="card-subtitle" style="margin-bottom: 16px;"/>
                <ui:VisualElement name="row-delete-confirm-footer" class="popup-footer-row">
                    <ui:Button text="Abbrechen" name="Btn-Delete-Confirm-Cancel" class="doc-btn-secondary"/>
                    <ui:Button text="Endgültig löschen" name="Btn-Delete-Confirm-Yes" class="doc-btn-danger-outline"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
