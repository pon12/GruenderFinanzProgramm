<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/Doc-Screen.uss?fileID=7433441132597879392&amp;guid=7f80ac4667a2566429f65c50cc73fc61&amp;type=3#Doc-Screen"/>
    <ui:VisualElement name="root-container" class="screen-root" style="width: 100%; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" style="flex: 1; flex-direction: column; padding: 30px 40px 0 430px; overflow: hidden;">
            <ui:VisualElement name="page-header-row" style="flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
                <ui:VisualElement>
                    <ui:Label text="Dokumente" name="page-title" class="page-title"/>
                    <ui:Label text="Zentrale Dokumentablage – feste und individuelle Kategorien" class="page-subtitle"/>
                </ui:VisualElement>
                <ui:Button text="Alle löschen" name="Delete-Button" class="doc-btn-danger-outline"/>
            </ui:VisualElement>
            <ui:ScrollView name="Main-Scroll-View" style="flex-grow: 1;">
                <ui:VisualElement name="Grid-Container" class="grid-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Popup-Window" class="doc-card popup-window">
                <ui:VisualElement name="Popup-Header" class="popup-header-row">
                    <ui:VisualElement>
                        <ui:Label text="Neues Dokument" class="card-title"/>
                        <ui:Label text="Titel und Kategorie wählen" class="card-subtitle"/>
                    </ui:VisualElement>
                    <ui:Button text="← Zurück" name="Btn-Cancel" class="doc-btn-secondary"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-1" class="form-group">
                    <ui:Label text="Dokumenttitel *" class="field-label"/>
                    <ui:TextField label="" placeholder-text="z.B. Businessplan Q3" name="Doc-Name-Input"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-2" class="form-group">
                    <ui:Label text="Kategorie" class="field-label"/>
                    <ui:DropdownField label="" name="dropKategorie"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-3" class="form-group">
                    <ui:Label text="Vorlage wählen" class="field-label" style="margin-bottom: 12px;"/>
                    <ui:VisualElement name="Template-Grid" class="template-grid">
                        <ui:Button text="Standard" name="Btn-Type-Standard" class="template-btn"/>
                        <ui:Button text="Diagramm" name="Btn-Type-Diagramm" class="template-btn"/>
                        <ui:Button text="Checklist" name="Btn-Type-Checklist" class="template-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Popup-Footer" class="popup-footer-row">
                    <ui:Button text="Abbrechen" name="Btn-Abbrechen" class="doc-btn-secondary"/>
                    <ui:Button text="Erstellen" name="Btn-Submit" class="doc-btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Detail-Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Detail-Menu-Container" class="doc-card detail-popup-box">
                <ui:VisualElement name="Detail-Header" class="popup-header-row">
                    <ui:Label text="Dokumenten-Liste" name="Detail-Popup-Title" class="card-title" style="flex-grow: 1;"/>
                    <ui:Button text="Schließen" name="Btn-Detail-Close" class="doc-btn-secondary"/>
                </ui:VisualElement>
                <ui:VisualElement name="Detail-Split-Body" class="split-body-layout">
                    <ui:VisualElement name="Detail-Left-Column" class="column-half">
                        <ui:Label text="Kategorie-Dokumente" class="column-header-title"/>
                        <ui:ScrollView name="Detail-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Detail-Right-Column" class="column-half">
                        <ui:Label text="Globale Dokumenten-Liste" class="column-header-title"/>
                        <ui:ScrollView name="Global-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="+ Neues Dokument erstellen" name="Btn-List-Create-New" class="doc-btn-primary" style="margin-top: 16px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Edit-Popup-Overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="Edit-Popup-Container" class="doc-card edit-popup-box">
                <ui:Label text="Dokument bearbeiten" class="card-title"/>
                <ui:Label text="🔒 Pflichtdokument – Titel &amp; Inhalt änderbar, aber nicht löschbar" name="Edit-Locked-Hint" class="locked-hint" style="display: none;"/>
                <ui:VisualElement class="form-group" style="margin-top: 12px;">
                    <ui:Label text="Titel" class="field-label"/>
                    <ui:TextField label="" placeholder-text="Dokumenttitel" name="Edit-Doc-Name-Input"/>
                </ui:VisualElement>
                <ui:VisualElement class="form-group">
                    <ui:Label text="Inhalt" class="field-label"/>
                    <ui:TextField label="" placeholder-text="z.B. IBAN, Notizen, Beschreibung..." name="Edit-Inhalt-Input" multiline="true" class="edit-textarea"/>
                </ui:VisualElement>
                <ui:VisualElement name="Edit-Buttons-Type-Group" class="template-grid" style="margin-top: 12px;">
                    <ui:Button text="Standard" name="Btn-Edit-Type-Standard" class="template-btn"/>
                    <ui:Button text="Diagramm" name="Btn-Edit-Type-Diagramm" class="template-btn"/>
                    <ui:Button text="Checklist" name="Btn-Edit-Type-Checklist" class="template-btn"/>
                </ui:VisualElement>
                <ui:VisualElement class="popup-footer-row" style="margin-top: 18px;">
                    <ui:Button text="Abbrechen" name="Btn-Edit-Cancel" class="doc-btn-secondary"/>
                    <ui:Button text="Fertig" name="Btn-Edit-Submit" class="doc-btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
