                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="card-grunddaten" class="angebot-card" style="flex: 1; flex-direction: column; padding: 14px 18px; gap: 10px; background-color: rgb(44, 44, 44); padding-bottom: 14px;">
                    <ui:VisualElement name="row-titel-grunddaten" style="flex-direction: row; align-items: center;">
                        <ui:Label text="Grunddaten &amp; Status" name="label-titel-grunddaten" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:VisualElement name="spacer-titel-grunddaten" style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-grunddaten" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="feld-gruppe-nummer" style="flex-direction: column; gap: 4px;">
                        <ui:Label text="Rechnungsnummer" name="label-feld-nummer" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:TextField name="input-nummer" style="width: 100%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="feld-gruppe-status" style="flex-direction: column; gap: 4px;">
                        <ui:Label text="Status" name="label-feld-status" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:DropdownField name="dropdown-status" style="width: 100%; height: 36px; margin-left: 0;"/>
