                    <ui:ScrollView name="positionen-liste" style="flex: 1; margin-top: 4px;"/>
                    <ui:VisualElement name="summen-bereich" style="border-top-width: 1px; border-top-color: rgb(70, 70, 70); padding-top: 12px; margin-top: 8px; gap: 6px;">
                        <ui:VisualElement name="row-summen-netto-zeile" style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Netto (EUR)" name="label-summen-netto-titel" style="font-size: 13px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
