                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="action-bar" style="flex-direction: row; align-items: center; padding-top: 14px; padding-bottom: 14px; border-top-width: 1px; border-top-color: rgb(60, 60, 60); margin-top: 8px; gap: 12px;">
                <ui:Button name="btn-angenommen" text="Versendet" class="angebot-btn-primary"/>
                <ui:Button name="btn-bezahlt" text="Bezahlt" class="rechnung-btn-primary"/>
                <ui:Button name="btn-abgelehnt" text="Storniert" class="angebot-btn-danger"/>
                <ui:VisualElement name="spacer-action-bar" style="flex: 1;"/>
                <ui:Button name="btn-export" text="Als PDF exportieren" class="angebot-btn-secondary"/>
                <ui:Button name="btn-speichern" text="Speichern" class="angebot-btn-primary"/>
