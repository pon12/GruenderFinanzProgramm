    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Angebot.uss?fileID=7433441132597879392&amp;guid=4b488f833bdc4bf43ac3915e80664efc&amp;type=3#Angebot"/>
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <ui:VisualElement name="root-container" class="screen-root" style="width: 100%; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" style="flex: 1; flex-direction: column; padding: 30px 40px 0 430px; overflow: hidden;">
            <ui:VisualElement name="row-kopfzeile" style="flex-direction: row; align-items: center; margin-bottom: 20px;">
                <ui:Label text="Rechnung erstellen" name="page-title" style="font-size: 32px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                <ui:VisualElement name="spacer-kopfzeile" style="flex-grow: 1;"/>
                <ui:Button name="btn-zuruecksetzen" text="Zurücksetzen" class="angebot-btn-zuruecksetzen" style="left: 42px;"/>
                <ui:VisualElement name="btn-help-zuruecksetzen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-right: 12px; left: 36px;"/>
                <ui:VisualElement name="btn-help-seitentitel" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px; right: 1045px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="top-row" style="flex-direction: row; gap: 16px; flex-shrink: 0; margin-bottom: 16px;">
                <ui:VisualElement name="card-partner" class="angebot-card" style="flex: 1; flex-direction: column; padding: 14px 18px; gap: 8px; background-color: rgb(44, 44, 44); margin-right: 8px; padding-bottom: 14px;">
                    <ui:VisualElement name="row-titel-partner" style="flex-direction: row; align-items: center;">
                        <ui:Label text="Rechnungspartner" name="label-titel-partner" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:VisualElement name="spacer-titel-partner" style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-partner" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="feld-gruppe-kundensuche" style="flex-direction: column; gap: 4px;">
                        <ui:Label text="Kunde suchen" name="label-feld-kundensuche" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:TextField name="input-kundensuche" style="width: 100%; margin-left: 0; margin-bottom: 8px; padding-left: 4px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-adressboxen" style="flex-direction: row; gap: 10px;">
                        <ui:VisualElement name="adresse-box-rechnung" class="angebot-address-box" style="flex: 1; padding: 8px 12px; margin-left: 4px;">
                            <ui:Label text="Rechnungsempfänger" name="label-adresse-empfaenger-titel" style="font-size: 12px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 2px;"/>
                            <ui:Label text="Kunde auswählen" name="label-adresse-empfaenger-inhalt" style="font-size: 11px; color: rgb(150, 150, 150); white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="adresse-box-versand" class="angebot-address-box" style="flex: 1; padding: 8px 12px; margin-left: 4px;">
                            <ui:Label text="Rechnungssteller" name="label-adresse-steller-titel" style="font-size: 12px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 2px;"/>
                            <ui:Label name="label-absender" text="" style="font-size: 11px; color: rgb(200, 200, 200); white-space: normal;"/>
