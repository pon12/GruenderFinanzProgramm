                            <ui:Label name="label-steuer" text="0,00 EUR" style="font-size: 13px; color: rgb(220, 220, 220);"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="row-summen-gesamt-zeile" style="flex-direction: row; justify-content: space-between; border-top-width: 1px; border-top-color: rgb(128, 207, 149); padding-top: 8px; margin-top: 4px;">
                            <ui:Label text="Gesamtpreis (EUR)" name="label-summen-gesamt-titel" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                            <ui:Label name="label-gesamt-total" text="0,00 EUR" style="font-size: 14px; -unity-font-style: bold; color: rgb(128, 207, 149); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
