                            <ui:Label name="label-rabatt" text="0,00 EUR" style="font-size: 13px; color: rgb(220, 220, 220);"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="row-summen-skonto-zeile" style="flex-direction: row; justify-content: space-between;">
