                    </ui:VisualElement>
                    <ui:VisualElement name="positionen-header" style="flex-direction: row; align-items: center; padding: 6px 8px 6px 18px; border-bottom-width: 1px; border-bottom-color: rgb(70, 70, 70); margin-bottom: 4px;">
                        <ui:Label text="Artikel" name="label-spalte-1-artikel" style="flex-grow: 1; min-width: 120px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:Label text="Beschreibung" name="label-spalte-2-beschreibung" style="width: 220px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:Label text="Menge" name="label-spalte-3-menge" style="width: 75px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:Label text="Einheit" name="label-spalte-4-einheit" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:Label text="Preis (EUR)" name="label-spalte-5-preis-eur" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                        <ui:Label text="Netto (EUR)" name="label-spalte-6-netto-eur" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
