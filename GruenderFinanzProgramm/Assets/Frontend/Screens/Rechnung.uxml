                            <ui:Label text="Rabatt-Typ" name="label-feld-rabatt-typ" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                            <ui:DropdownField name="dropdown-rabatt-typ" style="width: 100%; margin-left: 0;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="feld-gruppe-rabatt-wert" style="flex-direction: column; gap: 4px;">
                            <ui:Label name="label-rabatt-wert-bezeichnung" text="Rabatt (Wert in %)" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                            <ui:TextField name="input-rabatt-wert" style="width: 100%; padding-right: 3px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="feld-gruppe-skonto-wert" style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Skonto (Wert in %)" name="label-feld-skonto-wert" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                            <ui:TextField name="input-skonto-wert" style="width: 100%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="feld-gruppe-notizen" style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Notiz (max. 150 Zeichen)" name="label-feld-notizen" style="font-size: 11px; color: rgb(180, 180, 180); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-SemiBold.ttf?fileID=12800000&amp;guid=cf0fdeb33f1d7be4886321d0c79cbfb5&amp;type=3#Poppins-SemiBold&quot;);"/>
                            <ui:TextField name="input-notizen" multiline="true" max-length="150" style="width: 100%; min-height: 120px; max-height: 200px; height: 154px;"/>
