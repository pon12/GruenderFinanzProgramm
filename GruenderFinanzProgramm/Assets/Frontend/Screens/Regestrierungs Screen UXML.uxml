            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; justify-content: center; align-items: center; flex-direction: row;">
                <ui:Label text="&#10;" name="lblPasskey" style="-unity-text-align: upper-left; width: 600px; height: 80px; margin-right: 15px; font-size: 36px; color: rgb(255, 255, 255);"/>
                <ui:Button text="Entschlüsseln" name="btnEntschluesseln" style="border-left-width: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; -unity-text-align: upper-center; justify-content: center; align-items: center;">
