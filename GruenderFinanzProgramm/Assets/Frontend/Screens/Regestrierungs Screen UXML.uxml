<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Sidebar/Register-Screen.uss?fileID=7433441132597879392&amp;guid=305c4b953cf207248af3018763fed611&amp;type=3#Register-Screen"/>
    <Style src="project://database/Assets/Frontend/Sidebar/Background.uss?fileID=7433441132597879392&amp;guid=e9732cc7f93bcd84490af24dc10b4fbb&amp;type=3#Background"/>
    <ui:VisualElement name="Background" class="fullscreen-bg" style="background-color: rgb(30, 30, 30);"/>
    <ui:VisualElement name="container-inhalt" class="container-main">
        <ui:VisualElement name="row-kopf" class="header-row">
            <ui:Button text="Zurück" name="btnclose" class="btn-back"/>
            <ui:Image name="Logo" source="project://database/Assets/Frontend/Bilder/logo_o_bg.png?fileID=2800000&amp;guid=7fbf2c99bf70f7a4eb47bbcd95b5e7a5&amp;type=3#logo_o_bg" class="header-logo"/>
        </ui:VisualElement>
        <ui:VisualElement name="container-ueberschrift" class="centered-container">
            <ui:Label text="Konto erstellen" name="Ueberschrift" class="ueberschrift"/>
        </ui:VisualElement>
        <ui:VisualElement name="container-profilname" class="centered-container">
            <ui:Label text="Profilname" name="Profilname" class="Profilname"/>
            <ui:TextField label="" placeholder-text="" name="Profileingabe" class="input-profile"/>
        </ui:VisualElement>
        <ui:VisualElement name="container-ueberschrift2" class="container-subheading">
            <ui:Label text="Sicher mit Passkey" name="Ueberschrift2" class="Ueberschrift2"/>
        </ui:VisualElement>
        <ui:VisualElement name="container-passkey-generieren" class="container-passkey-gen">
            <ui:Label text="Kein Passwort nötig - Gib deine PIN ein oder lass dir eine starke PIN erstellen" name="text" class="text"/>
            <ui:Button text="Power-Passkey-generieren" name="btnKeyGenerieren" class="Key-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="container-fehler" class="container-error">
            <ui:Label text="" name="lblError" class="lbl-error"/>
        </ui:VisualElement>
        <ui:VisualElement name="row-agb-datenschutz" class="row-agb">
            <ui:Toggle label="" name="Toggle" class="toggle-agb"/>
            <ui:Label text="Ich akzeptiere die " name="normalerText" class="text2"/>
            <ui:Label text="AGB" name="text2" selectable="true" focusable="true" class="text2 link-text"/>
            <ui:Label text=" und die " name="normalerText2" class="text2"/>
            <ui:Label text="Datenschutzrichtlinie" name="textDatenschutz" selectable="true" focusable="true" class="text2 link-text"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement picking-mode="Position" name="popuppasskey" class="popup-overlay" style="display: flex;">
        <ui:VisualElement name="container-popup-passkey" class="popup-card">
            <ui:VisualElement name="row-popup-passkey-header" class="popup-header-row">
                <ui:Label text="Dein Power-Passkey" name="label-popup-passkey-titel" class="popup-title"/>
                <ui:Button text="✕" name="btnpopupclose" class="btn-popup-close"/>
            </ui:VisualElement>
            <ui:VisualElement name="container-passkey-anzeige" class="popup-passkey-display">
                <ui:VisualElement name="row-passkey" class="popup-row-item">
                    <ui:Label text="" name="lblPasskey" class="lbl-key-display"/>
                    <ui:Button text="Copy" name="btnCopyPasskey" class="btn-copy"/>
                </ui:VisualElement>
                <ui:VisualElement name="row-recovery" class="popup-row-item popup-row-item-last">
                    <ui:Label text="" name="lblRecoveryKey" class="lbl-key-display"/>
                    <ui:Button text="Copy" name="btnCopyRecovery" class="btn-copy"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Entschlüsseln" name="btnEntschluesseln" class="btn-decrypt"/>
            <ui:Label text="Bitte notiere deinen Passkey und Recovery-Key sicher." name="label-popup-passkey-hinweis" class="popup-hint"/>
            <ui:Button text="Zur Anmeldung" name="btnZurAnmeldung" class="btn-submit"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PopUpAGB" class="popup-overlay" style="display: none;">
        <ui:VisualElement name="container-popup-agb" class="popup-doc-card">
            <ui:VisualElement name="row-popup-agb-header" class="popup-doc-header">
                <ui:Label text="AGB" name="label-popup-agb-titel" class="popup-doc-title"/>
                <ui:Button text="" name="btnAGBclose" class="btn-doc-close"/>
            </ui:VisualElement>
            <ui:VisualElement name="container-popup-agb-inhalt" class="popup-doc-content">
                <ui:Label text="§ 1 Geltungsbereich&#10;Diese Nutzungsbedingungen gelten für die Nutzung der Software Ventoriq durch registrierte Nutzerinnen und Nutzer. Mit der Registrierung erkennst du diese Bedingungen an.&#10;&#10;§ 2 Leistungsbeschreibung&#10;Ventoriq unterstützt Gründerinnen und Gründer bei der Verwaltung von Kunden, Angeboten, Rechnungen, Kassenbuch und Gründungsdokumenten. Die Software befindet sich im Status eines Prototypen (Minimum Viable Product). Die Nutzung erfolgt auf eigenes Risiko.&#10;&#10;§ 3 Haftungsausschluss&#10;Eine Haftung für Schäden, die aus der Nutzung der bereitgestellten Kalkulationen, Vorlagen oder generierten Dokumente resultieren, wird im gesetzlich zulässigen Rahmen ausgeschlossen. Die von Ventoriq erzeugten Dokumente (z. B. Verträge, Rechnungen, Formulare) ersetzen keine rechtliche oder steuerliche Beratung.&#10;&#10;§ 4 Nutzerkonto &amp; Zugangsdaten&#10;Du bist verpflichtet, deinen Passkey vertraulich zu behandeln und vor dem Zugriff Dritter zu schützen. Für Aktivitäten, die unter deinem Konto stattfinden, bist du verantwortlich.&#10;&#10;§ 5 Datenspeicherung&#10;Alle innerhalb von Ventoriq erfassten Daten werden ausschließlich lokal in einer verschlüsselten SQLite-Instanz auf deinem Endgerät gespeichert. Es findet keine Übertragung an Cloud-Dienste oder externe Server statt.&#10;&#10;§ 6 Änderungen&#10;Diese Bedingungen können bei Weiterentwicklung der Software angepasst werden. Wesentliche Änderungen werden in der Anwendung kenntlich gemacht.&#10;&#10;§ 7 Schlussbestimmungen&#10;Sollten einzelne Bestimmungen unwirksam sein, bleibt die Wirksamkeit der übrigen Bestimmungen unberührt." name="label-popup-agb-text" enable-rich-text="true" class="popup-doc-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PopUpDatenschutz" class="popup-overlay">
        <ui:VisualElement name="container-popup-datenschutz" class="popup-doc-card">
            <ui:VisualElement name="row-popup-datenschutz-header" class="popup-doc-header">
                <ui:Label text="Datenschutzrichtlinie" name="label-popup-datenschutz-titel" class="popup-doc-title"/>
                <ui:Button text="" name="btnDatenschutzclose" class="btn-doc-close"/>
            </ui:VisualElement>
            <ui:VisualElement name="container-popup-datenschutz-inhalt" class="popup-doc-content">
                <ui:Label text="§ 1 Verantwortliche Stelle&#10;Verantwortlich für die Datenverarbeitung im Rahmen der Nutzung von Ventoriq bist du selbst als Nutzer bzw. Betreiber der Software auf deinem eigenen Endgerät.&#10;&#10;§ 2 Welche Daten werden erfasst&#10;Bei der Registrierung werden dein gewählter Profilname sowie ein sicherer Hash deines Passkeys gespeichert (kein Klartext-Passwort). Zusätzlich erfasst die Software im laufenden Betrieb die von dir eingegebenen Geschäftsdaten (Kunden, Rechnungen, Angebote, Kassenbuch, Dokumente).&#10;&#10;§ 3 Lokale Datenverarbeitung&#10;Sämtliche Daten werden ausschließlich lokal in einer verschlüsselten SQLite-Datenbank auf deinem Endgerät gespeichert. Es findet keine Übertragung an Ventoriq, an Cloud-Dienste oder an sonstige Dritte statt.&#10;&#10;§ 4 Sicherheit&#10;Zugangsdaten werden mittels moderner Hashing-Verfahren (SHA-256) gesichert. Für den Schutz deines Geräts und deiner Zugangsdaten bist du selbst verantwortlich.&#10;&#10;§ 5 Weitergabe an Dritte&#10;Eine Weitergabe deiner Daten an Dritte findet nicht statt, da keine Datenübertragung außerhalb deines Endgeräts erfolgt.&#10;&#10;§ 6 Deine Rechte&#10;Da alle Daten lokal bei dir liegen, hast du jederzeit vollen Zugriff, kannst sie einsehen, exportieren, korrigieren oder vollständig löschen (z. B. über die Backup- und Löschfunktionen in den Einstellungen).&#10;&#10;§ 7 Änderungen dieser Erklärung&#10;Diese Datenschutzerklärung kann bei Weiterentwicklung der Software angepasst werden." name="label-popup-datenschutz-text" enable-rich-text="true" class="popup-doc-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
