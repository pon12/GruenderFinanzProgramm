        <ui:VisualElement style="flex-grow: 1; align-items: center; height: auto; justify-content: center;">
            <ui:Label text="Konto erstellen" name="Ueberschrift" class="ueberschrift" style="top: auto; left: auto; width: 573px; height: 91px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; align-items: center; height: auto; justify-content: center;">
