    <ui:VisualElement picking-mode="Position" name="popuppasskey" style="flex-grow: 1; position: absolute; width: 1920px; height: 1080px; align-items: center; justify-content: center; display: none; top: 0; left: 1px;">
        <ui:VisualElement style="flex-grow: 1; width: 892px; height: 338px; position: absolute; justify-content: flex-start; align-items: stretch; background-color: rgb(56, 56, 56); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; border-left-color: rgb(179, 226, 196); border-right-color: rgb(179, 226, 196); border-top-color: rgb(179, 226, 196); border-bottom-color: rgb(179, 226, 196); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px;">
