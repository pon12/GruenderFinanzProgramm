            <ui:TextField label="" placeholder-text="" name="Profileingabe" style="top: auto; left: auto; width: 984px; height: 102px; font-size: 36px; color: rgb(26, 26, 26);"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; align-items: center; height: auto; justify-content: space-around; top: -30px;">
            <ui:Label text="Sicher mit Passkey&#10;" name="Ueberschrift2" class="Ueberschrift2" style="top: auto; left: auto; align-items: auto;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: column; align-items: center; height: auto; -unity-text-align: upper-left; justify-content: center; top: -50px;">
            <ui:Label text="Kein Passwort nötig - Gib deine PIN ein oder las dir eine starke PIN erstellen" name="text" class="text" style="top: auto; left: auto; align-items: auto;"/>
            <ui:Button text="Power-Passkey-generieren" name="btnKeyGenerieren" enabled="true" class="Key-button" style="top: auto; left: auto; width: 476px; height: 98px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; display: flex; align-items: center; justify-content: center; right: -3px; bottom: 124px; left: 4px; top: 909px; position: absolute;">
            <ui:Label text="" name="lblError" style="font-size: 26px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-items: center; align-self: stretch; justify-content: center;">
            <ui:Toggle label="" name="Toggle" style="top: auto; left: auto; width: 50px; height: 50px;"/>
            <ui:Label text="Ich akzeptiere die " name="normalerText" selectable="true" focusable="true" class="text2" style="top: auto; left: auto;"/>
            <ui:Label text="AGB" name="text2" selectable="true" focusable="true" class="text2" style="top: auto; left: auto;"/>
            <ui:Label text="und die" name="normalerText" selectable="true" focusable="true" class="text2" style="top: auto; left: auto;"/>
