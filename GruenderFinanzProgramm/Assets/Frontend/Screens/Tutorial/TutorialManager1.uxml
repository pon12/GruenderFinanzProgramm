<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/TutorialManager.uss?fileID=7433441132597879392&amp;guid=8a7fe86fb8542e848b8b68cca5a4a18f&amp;type=3#TutorialManager"/>
    <ui:VisualElement name="TutorialOverlay" class="tutorial-overlay">
        <ui:VisualElement name="StartDialogWrapper" class="start-dialog-wrapper">
            <ui:VisualElement name="StartDialog" class="dialog">
                <ui:Label text="Tutorial" class="dialog-headline"/>
                <ui:Label text="Möchtest du eine Einführung in die App erhalten?" class="dialog-text"/>
                <ui:Button name="LangButton" text="Ausführliche Einführung" class="btn btn-primary"/>
                <ui:Button name="KurzButton" text="Kurze Übersicht" class="btn btn-primary"/>
                <ui:Button name="KeinTutorialButton" text="Schließen" class="btn btn-ghost"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TutorialModus" class="tutorial-modus">
            <ui:VisualElement name="HighlightRahmen" class="highlight-rahmen"/>
            <ui:VisualElement name="ErklaerungsBox" class="erklaerung-box">
                <ui:Label name="ErklaerungsText" class="erklaerung-text"/>
                <ui:VisualElement class="nav-row">
                    <ui:Button name="ZurueckButton" text="‹ Zurück" class="btn btn-ghost"/>
                    <ui:Label name="SchrittAnzeige" text="1 / 1" class="schritt-anzeige"/>
                    <ui:Button name="WeiterButton" text="Weiter ›" class="btn btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="BeendenButton" text="✕ Beenden" class="btn-beenden"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
