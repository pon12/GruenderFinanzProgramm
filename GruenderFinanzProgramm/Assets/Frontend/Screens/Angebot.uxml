<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Angebot.uss?fileID=7433441132597879392&amp;guid=4b488f833bdc4bf43ac3915e80664efc&amp;type=3#Angebot"/>
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <ui:VisualElement name="root-container" class="screen-root" style="width: 100%; height: 100%; background-color: rgb(40, 40, 40);">
        <ui:VisualElement name="main-content" style="flex: 1; flex-direction: column; padding: 30px 40px 0 430px; overflow: hidden;">
            <ui:Label text="Angebot erstellen" name="page-title" style="font-size: 32px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 20px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
            <ui:VisualElement name="top-row" style="flex-direction: row; gap: 16px; flex-shrink: 0; margin-bottom: 16px;">
                <ui:VisualElement name="card-partner" class="angebot-card" style="flex: 1; flex-direction: column; padding: 14px 18px; gap: 8px;">
                    <ui:Label text="Angebotspartner" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:VisualElement style="flex-direction: column; gap: 4px;">
                        <ui:Label text="Kunde suchen" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                        <ui:TextField name="input-kundensuche" style="width: 100%; margin-bottom: 8px; margin-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; gap: 10px;">
                        <ui:VisualElement name="adresse-box-rechnung" class="angebot-address-box" style="flex: 1; padding: 8px 12px;">
                            <ui:Label text="Rechnungsempfänger:" style="font-size: 12px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 2px;"/>
                            <ui:Label text="Kunde auswählen" style="font-size: 11px; color: rgb(150, 150, 150); white-space: normal;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="adresse-box-versand" class="angebot-address-box" style="flex: 1; padding: 8px 12px;">
                            <ui:Label text="Rechnungssender:" style="font-size: 12px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 2px;"/>
                            <ui:Label name="label-absender" text="" style="font-size: 11px; color: rgb(200, 200, 200); white-space: normal;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="card-grunddaten" class="angebot-card" style="flex: 1; flex-direction: column; padding: 14px 18px; gap: 10px; margin-left: 8px;">
                    <ui:Label text="Grunddaten &amp; Status" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:VisualElement style="flex-direction: row; gap: 10px;">
                        <ui:VisualElement style="flex: 1; flex-direction: column; gap: 4px;">
                            <ui:Label text="Angebotsnummer" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:TextField name="input-nummer" style="width: 100%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex: 1; flex-direction: column; gap: 4px;">
                            <ui:Label text="Status" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:DropdownField name="dropdown-status" style="width: 100%; height: 36px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; gap: 10px;">
                        <ui:VisualElement style="flex: 1; flex-direction: column; gap: 4px;">
                            <ui:Label text="Datum" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:VisualElement name="datum-wrapper" style="flex-direction: row; align-items: center;">
                                <ui:TextField name="input-datum" style="flex: 1;"/>
                                <ui:Button name="btn-kalender-datum" text="📅" style="width: 30px; height: 30px; flex-shrink: 0; margin-left: 4px; background-color: rgb(70, 70, 70); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; -unity-font-style: bold; font-size: 14px; color: rgb(255, 255, 255);"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex: 1; flex-direction: column; gap: 4px;">
                            <ui:Label text="Gültig bis" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:VisualElement name="frist-wrapper" style="flex-direction: row; align-items: center;">
                                <ui:TextField name="input-frist" style="flex: 1;"/>
                                <ui:Button name="btn-kalender-frist" text="📅" style="width: 30px; height: 30px; flex-shrink: 0; margin-left: 4px; background-color: rgb(70, 70, 70); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; -unity-font-style: bold; font-size: 14px; color: rgb(255, 255, 255);"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex: 1; flex-direction: column; gap: 4px;">
                            <ui:Label text="Referenz #" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:TextField name="input-referenz" max-length="10" style="width: 100%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex: 0; flex-direction: column; gap: 4px; min-width: 60px;">
                            <ui:Label text="Währung" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:Label text="EUR" style="font-size: 12px; color: rgb(255, 255, 255); background-color: rgb(70, 70, 70); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; padding-top: 10px; padding-bottom: 5px; padding-left: 10px; padding-right: 10px; height: 36px; margin-left: 8px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-row" style="flex-direction: row; flex: 1; gap: 16px; overflow: hidden;">
                <ui:VisualElement name="card-positionen" class="angebot-card" style="flex: 1; flex-direction: column; padding: 20px 24px; overflow: hidden;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 12px;">
                        <ui:Label text="Positionen" style="font-size: 16px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-right: 10px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:Button name="btn-position-hinzufuegen" text="+" style="width: 24px; height: 24px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; background-color: rgb(128, 207, 149); color: rgb(30, 30, 30); font-size: 16px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 0; padding-bottom: 0; padding-left: 0; padding-right: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="positionen-header" style="flex-direction: row; align-items: center; padding: 6px 8px 6px 18px; border-bottom-width: 1px; border-bottom-color: rgb(70, 70, 70); margin-bottom: 4px;">
                        <ui:Label text="Artikel" style="flex-grow: 1; min-width: 120px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:Label text="Beschreibung" style="width: 220px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:Label text="Menge" style="width: 75px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:Label text="Einheit" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:Label text="Preis (EUR)" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:Label text="Netto (EUR)" style="width: 110px; font-size: 12px; color: rgb(180, 180, 180);"/>
                        <ui:VisualElement style="width: 34px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:ScrollView name="positionen-liste" style="flex: 1; margin-top: 4px;"/>
                    <ui:VisualElement name="summen-bereich" style="border-top-width: 1px; border-top-color: rgb(70, 70, 70); padding-top: 12px; margin-top: 8px; gap: 6px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Netto (EUR)" style="font-size: 13px; color: rgb(180, 180, 180);"/>
                            <ui:Label name="label-netto" text="0,00 EUR" style="font-size: 13px; color: rgb(128, 207, 149); -unity-font-style: bold;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Rabatt" style="font-size: 13px; color: rgb(180, 180, 180);"/>
                            <ui:Label name="label-rabatt" text="0,00 EUR" style="font-size: 13px; color: rgb(220, 220, 220);"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Skonto" style="font-size: 13px; color: rgb(180, 180, 180);"/>
                            <ui:Label name="label-skonto" text="0,00 EUR" style="font-size: 13px; color: rgb(220, 220, 220);"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; border-top-width: 1px; border-top-color: rgb(128, 207, 149); padding-top: 8px; margin-top: 4px;">
                            <ui:Label text="Gesamtpreis (EUR)" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                            <ui:Label name="label-gesamt-total" text="0,00 EUR" style="font-size: 14px; -unity-font-style: bold; color: rgb(128, 207, 149); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="col-right" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" style="width: 290px; flex-shrink: 0;">
                    <ui:VisualElement name="card-details" class="angebot-card" style="flex-direction: column; padding: 16px 20px; gap: 12px; margin-left: 8px; margin-bottom: 8px;">
                        <ui:Label text="Details &amp; Notizen" style="font-size: 14px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:VisualElement style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Rabatt-Typ" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:DropdownField name="dropdown-rabatt-typ" style="width: 100%; margin-left: 0;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Rabatt (Wert in %)" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:TextField name="input-rabatt-wert" style="width: 100%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Skonto (Wert in %)" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:TextField name="input-skonto-wert" style="width: 100%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: column; gap: 4px;">
                            <ui:Label text="Notiz (max. 150 Zeichen)" style="font-size: 11px; color: rgb(180, 180, 180);"/>
                            <ui:TextField name="input-notizen" multiline="true" max-length="150" style="width: 100%; min-height: 60px; max-height: 100px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="card-anhaenge" class="angebot-card" style="flex-direction: column; padding: 14px 16px; flex-shrink: 0; margin-left: 8px;"/>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="action-bar" style="flex-direction: row; align-items: center; padding-top: 14px; padding-bottom: 14px; border-top-width: 1px; border-top-color: rgb(60, 60, 60); margin-top: 8px; gap: 12px;">
                <ui:Button name="btn-umwandeln" text="Angebot in Rechnung umwandeln" style="height: 40px; padding-left: 18px; padding-right: 18px; background-color: rgb(70, 70, 70); color: rgb(180, 180, 180); font-size: 13px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:Button name="btn-angenommen" text="Angenommen" style="height: 40px; padding-left: 18px; padding-right: 18px; background-color: rgb(128, 207, 149); color: rgb(30, 30, 30); font-size: 13px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:Button name="btn-abgelehnt" text="Abgelehnt" style="height: 40px; padding-left: 18px; padding-right: 18px; background-color: rgb(230, 57, 70); color: rgb(255, 255, 255); font-size: 13px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:VisualElement style="flex: 1;"/>
                <ui:Button name="btn-export" text="Als PDF exportieren" style="height: 40px; padding-left: 18px; padding-right: 18px; background-color: rgb(70, 70, 70); color: rgb(255, 255, 255); font-size: 13px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
                <ui:Button name="btn-speichern" text="Speichern" style="height: 40px; padding-left: 24px; padding-right: 24px; background-color: rgb(128, 207, 149); color: rgb(30, 30, 30); font-size: 13px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
