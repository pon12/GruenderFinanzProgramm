<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/doc-main.uss?fileID=7433441132597879392&amp;guid=a0d03a3f5149e1d448b98d3e66e7b5de&amp;type=3#doc-main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Popup-Doc.uss?fileID=7433441132597879392&amp;guid=e656db98336718542b51da1d22a7e1e2&amp;type=3#Popup-Doc"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Popup-Detail.uss?fileID=7433441132597879392&amp;guid=f1ccce897aa4df049a497a132a86c8e2&amp;type=3#Popup-Detail"/>
    <ui:VisualElement name="root" style="flex-grow: 1; flex-direction: row; background-color: rgb(45, 45, 45); width: 100%; height: 100%;">
        <ui:VisualElement name="main-content" class="main grid-item" style="flex-grow: 1; background-color: rgb(45, 45, 45); height: 100%; width: auto; padding-left: 430px;">
            <ui:VisualElement name="Header-Container" class="header-container" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: stretch; align-self: center;">
                <ui:VisualElement name="Left-Text-Group" class="left-text-group" style="flex-grow: 1; align-items: stretch;">
                    <ui:Label text="Dokument&#10;" class="header-title" style="-unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:Label text="Dokumentablage" class="header-subtitle" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="Main-Scroll-View" style="flex-grow: 1;">
                <ui:VisualElement name="Grid-Container" class="grid-container" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; background-size: 100% 100%; padding-top: 0; padding-bottom: 0; padding-left: 20px; padding-right: 20px;"/>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="Popup-Overlay" class="popup-overlay" style="flex-grow: 1; display: none;">
            <ui:VisualElement name="Popup-Window" class="popup-window" style="flex-grow: 1; display: flex;">
                <ui:VisualElement name="Popup-Header" style="flex-grow: 1;">
                    <ui:VisualElement name="Header-Left" style="flex-grow: 1;">
                        <ui:Label text="Neus Dokument" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:Label text="Kategorie und Vorlage wählen" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    </ui:VisualElement>
                    <ui:Button text="&lt;- Zurück" name="Btn-Cancel" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-1" style="flex-grow: 1;">
                    <ui:Label text="Dokumentname" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:TextField label="" placeholder-text="z.B. Buisnessplan Q3" name="Doc-Name-Input" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-2" style="flex-grow: 1;">
                    <ui:Label text="Kategorie" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:DropdownField label="" name="dropKategorie" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement name="Form-Group-3" style="flex-grow: 1;">
                    <ui:Label text="Vorlage wählen" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:VisualElement name="Template-Grid" style="flex-grow: 1;">
                        <ui:Button text="Standard" name="Btn-Type-Standard" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:Button text="Diagramm" name="Btn-Type-Diagramm" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                        <ui:Button text="Checklist" name="Btn-Type-Checklist" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Popup-Footer" style="flex-grow: 1;">
                    <ui:Button text="Abbrechen" name="Btn-Abbrechen" style="-unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;);"/>
                    <ui:Button text="erstellen" name="Btn-Submit" style="-unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;);"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Detail-Popup-Overlay" class="popup-overlay" style="flex-grow: 1; display: none;">
            <ui:VisualElement name="Detail-Menu-Container" class="popup-container detail-popup-box" style="flex-grow: 1; display: flex; background-color: rgb(17, 17, 17);">
                <ui:VisualElement name="Detail-Header" class="popup-header popup-header-row" style="flex-grow: 0; flex-direction: row;">
                    <ui:Label text="Dokumenten-List" name="Detail-Popup-Title" class="popup-title popup-title-text" style="color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;); flex-grow: 1;"/>
                    <ui:Button text="Close" name="Btn-Detail-Close" class="btn-close btn-close-style" style="-unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255); border-left-color: rgb(128, 207, 149); border-right-color: rgb(128, 207, 149); border-top-color: rgb(128, 207, 149); border-bottom-color: rgb(128, 207, 149); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(128, 207, 149); justify-content: flex-start; flex-grow: 0; flex-shrink: 0; align-self: auto;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Detail-Split-Body" class="split-body-layout" style="flex-grow: 1;">
                    <ui:VisualElement name="Detail-Left-Column" class="column-half" style="flex-grow: 1;">
                        <ui:Label text="Kategorie Dokumente" class="column-header-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255);"/>
                        <ui:ScrollView name="Detail-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Detail-Right-Column" class="column-half" style="flex-grow: 1;">
                        <ui:Label text="Globale Dokumenten Liste" class="column-header-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255);"/>
                        <ui:ScrollView name="Global-List-Container" class="scroll-list-box"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button text="+ Neues Dokument erstellen" name="Btn-List-Create-New" class="btn-create-footer" style="-unity-font-definition: url(&quot;project://database/Assets/Frontend/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=bd89cb14730400b4bbcff7e0926565fc&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(129, 207, 149); border-right-color: rgb(129, 207, 149); border-top-color: rgb(129, 207, 149); border-bottom-color: rgb(129, 207, 149); background-color: rgb(129, 207, 149);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Edit-Popup-Overlay" style="flex-grow: 1; display: none;">
            <ui:VisualElement name="Edit-Popup-Container" class="edit-popup-box" style="flex-grow: 1;">
                <ui:Label text="Dokument Bearbeiten" class="popup-title-text" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&amp;guid=3621564315749d341aeb8593daa0ea7f&amp;type=3#Poppins-Bold&quot;); color: rgb(255, 255, 255);"/>
                <ui:TextField label="" placeholder-text="" name="Edit-Doc-Name-Input" class="input-field-style" multiline="true" style="flex-grow: 1; white-space: normal;"/>
                <ui:VisualElement name="Edit-Buttons-Type-Group" class="type-button-group" style="flex-grow: 0;">
                    <ui:Button text="Standard" name="Btn-Edit-Type-Diagramm" class="type-btn"/>
                    <ui:Button text="Diagramm" name="Btn-Edit-Type-Standard" class="type-btn"/>
                    <ui:Button text="Checklist" name="Btn-Edit-Type-Checklist" class="type-btn"/>
                </ui:VisualElement>
                <ui:Button text="Fertig" name="Btn-Edit-Submit" class="btn-action-submit"/>
                <ui:Button text="Abbrechen&#10;" name="Btn-Edit-Cancel" class="btn-action-cancel"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>