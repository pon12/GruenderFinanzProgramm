    <ui:VisualElement name="nav-item-finanzdashboard" class="root fullscreen-bg grid-container" style="flex-direction: row; flex-wrap: nowrap; align-items: stretch; justify-content: flex-start; align-self: flex-start; width: 100%; -unity-text-align: upper-left; background-position-x: center; height: 100%;">
        <ui:VisualElement name="spacer-sidebar" style="flex-grow: 0; width: 388px;"/>
        <ui:VisualElement name="container-inhalt" style="flex-grow: 1; background-color: rgb(30, 30, 30); margin-left: 5px; padding-bottom: 5px; padding-right: 5px;">
            <ui:VisualElement name="Finanzdashboard" style="flex-grow: 1; flex-direction: row; align-items: flex-start; align-self: auto; justify-content: flex-start; height: auto; position: relative; min-height: 0; align-content: auto; flex-wrap: nowrap; top: auto; -unity-text-auto-size: none; -unity-text-generator: standard; -unity-background-scale-mode: stretch-to-fill; -unity-text-align: upper-left; opacity: 1; min-width: 0; max-width: 1920px; max-height: 70px; width: 1489px; padding-left: 20px;">
                <ui:Label text="Renatbilität&#10;" name="Label" style="font-size: 46px; color: rgb(255, 255, 255); flex-direction: row; align-items: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="row-kennzahlen-karten" style="flex-grow: 0; flex-direction: row; margin-right: 10px; padding-right: 15px; margin-left: 10px; padding-left: 15px;">
                <ui:VisualElement name="Umsatz" style="flex-grow: 1; justify-content: flex-start; height: auto; background-color: rgb(44, 44, 44); margin-right: 10px; margin-left: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-bottom: 10px;">
                    <ui:Label text="Privatentnahemn " name="label-karte-privatentnahme-titel" style="color: rgb(255, 255, 255); font-size: 26px; -unity-text-align: upper-center;"/>
                    <ui:Label text="0 €" name="Umsatzwert" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; font-size: 20px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Auftragsquote" style="flex-grow: 1; height: auto; background-color: rgb(44, 44, 44); margin-right: 10px; margin-left: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-bottom: 10px;">
                    <ui:Label text="Überschüssiges Kapital" name="label-karte-kapital-titel" style="font-size: 26px; color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
                    <ui:Label text="0 €" name="WertAq" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); font-size: 20px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Gewinn" style="flex-grow: 1; height: auto; background-color: rgb(44, 44, 44); margin-left: 10px; margin-right: 10px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; margin-bottom: 10px;">
                    <ui:Label text="SUmme Fremdkapitalk" name="label-karte-fremdkapital-titel" style="font-size: 26px; color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
                    <ui:Label text="0 €" name="gewinnWert" style="font-size: 20px; -unity-text-align: upper-center; color: rgb(255, 255, 255);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="container-charts" style="flex-grow: 1; flex-direction: column; border-left-width: 5px; border-right-width: 1px; padding-left: 20px; padding-right: 20px; padding-bottom: 20px;">
                <ui:VisualElement name="row-kosten-kapitalbedarf" style="flex-grow: 1; flex-direction: row; justify-content: flex-start;">
                    <ui:VisualElement name="card-kosten" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-bottom: 10px; margin-right: 10px; padding-left: 15px; padding-bottom: 15px; padding-right: 15px; background-color: rgb(44, 44, 44); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 577px; padding-top: 15px; margin-top: 10px; margin-left: 10px;">
                        <ui:Label text="Kosten" name="label-karte-kosten-titel" style="color: rgb(255, 255, 255); font-size: 26px;"/>
                        <ui:VisualElement name="Inhalt" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="row-kapitalbedarf-wrapper" style="flex-grow: 1; flex-direction: row; justify-content: flex-start;">
                        <ui:VisualElement name="card-kapitalbedarf" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-bottom: 10px; margin-right: 10px; padding-left: 15px; padding-bottom: 15px; padding-right: 15px; background-color: rgb(44, 44, 44); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; width: 577px; padding-top: 15px; margin-top: 10px; margin-left: 10px;">
                            <ui:Label text="Kapitalbedarf" name="label-karte-kapitalbedarf-titel" style="color: rgb(255, 255, 255); font-size: 26px;"/>
                            <ui:VisualElement name="Diagramm" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                        </ui:VisualElement>
