                        <ui:Label text="Rohgewinn" name="label-karte-rohgewinn-titel" style="color: rgb(255, 255, 255); font-size: 26px;"/>
                        <ui:VisualElement name="tblEInnahemn" style="flex-grow: 1; justify-content: flex-end;">
                            <ui:VisualElement name="chart-container" class="chart-container" style="justify-content: center; flex-direction: row; align-items: stretch; flex-grow: 1;">
                                <ui:VisualElement name="chart-y-axis" class="chart-y-axis" style="align-items: flex-start; justify-content: space-between;">
                                    <ui:Label text="€0" name="label-chart-achse-1" class="chart-axis-label"/>
                                    <ui:Label text="€0" name="label-chart-achse-2" class="chart-axis-label"/>
                                    <ui:Label text="€0" name="label-chart-achse-3" class="chart-axis-label"/>
                                    <ui:Label text="€0" name="label-chart-achse-4" class="chart-axis-label"/>
                                    <ui:Label text="€0" name="label-chart-achse-5" class="chart-axis-label"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="diagramm" class="chart-canvas" style="height: 100%; width: 100%; flex-shrink: 1; flex-grow: 1; justify-content: center; align-items: flex-start; flex-direction: column;"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="chart-x-axis" class="chart-x-axis" style="flex-direction: row; justify-content: space-around; align-items: auto;">
                                <ui:Label text="Jan" name="label-chart-monat-jan" class="chart-month-label"/>
                                <ui:Label text="Feb" name="label-chart-monat-feb" class="chart-month-label"/>
                                <ui:Label text="Mär" name="label-chart-monat-mar" class="chart-month-label"/>
                                <ui:Label text="Apr" name="label-chart-monat-apr" class="chart-month-label"/>
                                <ui:Label text="Mai" name="label-chart-monat-mai" class="chart-month-label"/>
                                <ui:Label text="Jun" name="label-chart-monat-jun" class="chart-month-label"/>
                                <ui:Label text="Jul" name="label-chart-monat-jul" class="chart-month-label"/>
                                <ui:Label text="Aug" name="label-chart-monat-aug" class="chart-month-label"/>
                                <ui:Label text="Sep" name="label-chart-monat-sep" class="chart-month-label"/>
                                <ui:Label text="Okt" name="label-chart-monat-okt" class="chart-month-label"/>
                                <ui:Label text="Nov" name="label-chart-monat-nov" class="chart-month-label"/>
                                <ui:Label text="Dez" name="label-chart-monat-dez" class="chart-month-label"/>
                            </ui:VisualElement>
