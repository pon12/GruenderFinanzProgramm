<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <Style src="project://database/Assets/Frontend/Sidebar/sidebar.uss?fileID=7433441132597879392&amp;guid=75a81b0b36c221f47b38dc27c4b347a9&amp;type=3#sidebar"/>
    <Style src="project://database/Assets/Frontend/Sidebar/Background.uss?fileID=7433441132597879392&amp;guid=e9732cc7f93bcd84490af24dc10b4fbb&amp;type=3#Background"/>
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/DashboardStyles.uss?fileID=7433441132597879392&amp;guid=fe9c9a54b138ecc469e247e562306177&amp;type=3#DashboardStyles"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/TransactionPopup.uss?fileID=7433441132597879392&amp;guid=701f9ef6a140abe468ef02fb200ea930&amp;type=3#TransactionPopup"/>

    <ui:VisualElement name="root" class="root fullscreen-bg grid-container"
        style="flex-direction: row; width: 100%; height: 100%; background-color: rgb(30, 30, 30);">

        <ui:VisualElement style="flex-grow: 0; width: 388px;"/>

        <ui:VisualElement name="hauptbereich"
            style="flex-grow: 1; padding-top: 40px; padding-right: 40px; padding-bottom: 20px; padding-left: 20px; flex-direction: column;">

            <!-- Titel -->
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                <ui:Label text="Wichtige Kennzahlen" style="font-size: 32px; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>

            <!-- Jahr-Anzeige -->
            <ui:Label name="lbl-jahr" text="Auswertung 2026"
                style="font-size: 16px; color: rgb(160, 160, 160); margin-bottom: 16px;"/>

            <!-- Obere Zeile: Rentabilität + Liquidität Gründung -->
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-bottom: 16px; min-height: 220px;">

                <!-- Rentabilität -->
                <ui:VisualElement class="panel-half" style="flex-grow: 3; flex-basis: 0; margin-right: 12px; flex-direction: column;">
                    <ui:Label text="Rentabilität" class="panel-title"/>
                    <ui:Label name="lbl-rentabilitaet-jahr" text="Aktuelles Jahr"
                        style="font-size: 12px; color: rgb(128, 207, 149); margin-bottom: 8px;"/>
                    <ui:VisualElement name="Rentabilitaet" style="flex-grow: 1;"/>
                </ui:VisualElement>

                <!-- Liquidität Gründung -->
                <ui:VisualElement class="panel-half" style="flex-grow: 2; flex-basis: 0; flex-direction: column;">
                    <ui:Label text="Liquidität zum Geschäftsbeginn" class="panel-title"/>
                    <ui:Label text="Startkapital &amp; Finanzierung"
                        style="font-size: 12px; color: rgb(128, 207, 149); margin-bottom: 8px;"/>
                    <ui:VisualElement name="Liquiditaet" style="flex-grow: 1;"/>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Chart: Einnahmen vs Ausgaben -->
            <ui:VisualElement class="panel-half" style="flex-grow: 1;">
                <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                    <ui:Label text="Einnahmen &amp; Ausgaben im Jahresverlauf" class="panel-title"/>
                </ui:VisualElement>
                <!-- Legende -->
                <ui:VisualElement style="flex-direction: row; margin-bottom: 8px;">
                    <ui:VisualElement style="width: 12px; height: 12px; background-color: rgb(128, 207, 149); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; margin-right: 6px; align-self: center;"/>
                    <ui:Label text="Einnahmen" style="font-size: 12px; color: rgb(200, 200, 200); margin-right: 16px;"/>
                    <ui:VisualElement style="width: 12px; height: 12px; background-color: rgb(230, 57, 70); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; margin-right: 6px; align-self: center;"/>
                    <ui:Label text="Ausgaben" style="font-size: 12px; color: rgb(200, 200, 200);"/>
                </ui:VisualElement>
                <ui:VisualElement name="chart-container" style="flex-grow: 1; position: relative; min-height: 200px;"/>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
