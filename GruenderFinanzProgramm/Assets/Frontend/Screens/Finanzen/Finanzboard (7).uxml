<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <Style src="project://database/Assets/Frontend/Sidebar/sidebar.uss?fileID=7433441132597879392&amp;guid=75a81b0b36c221f47b38dc27c4b347a9&amp;type=3#sidebar"/>
    <Style src="project://database/Assets/Frontend/Sidebar/Background.uss?fileID=7433441132597879392&amp;guid=e9732cc7f93bcd84490af24dc10b4fbb&amp;type=3#Background"/>
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/DashboardStyles.uss?fileID=7433441132597879392&amp;guid=fe9c9a54b138ecc469e247e562306177&amp;type=3#DashboardStyles"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/TransactionPopup.uss?fileID=7433441132597879392&amp;guid=701f9ef6a140abe468ef02fb200ea930&amp;type=3#TransactionPopup"/>

    <ui:VisualElement name="main-content" class="root fullscreen-bg grid-container"
        style="flex-direction: row; width: 100%; height: 100%; background-color: rgb(30, 30, 30);">

        <ui:VisualElement style="flex-grow: 0; width: 388px;"/>

        <ui:VisualElement name="hauptbereich"
            style="flex-grow: 1; padding-top: 40px; padding-right: 40px; padding-bottom: 20px; padding-left: 20px; flex-direction: column;">

            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
                <ui:Label text="Finanzdashboard" style="font-size: 32px; -unity-font-style: bold; color: rgb(255, 255, 255);"/>
            </ui:VisualElement>

            <!-- KPI Karten -->
            <ui:VisualElement name="stats-grid" style="flex-grow: 0; flex-direction: row; margin-bottom: 16px;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; flex-direction: column; margin-right: 12px;">
                    <ui:VisualElement name="Umsatz" class="stat-card" style="margin-bottom: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Gesamtumsatz" class="stat-title"/>
                            <ui:VisualElement style="flex-grow: 1;"/>
                            <ui:VisualElement name="btn-help-umsatz" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                        </ui:VisualElement>
                        <ui:Label text="0,00 €" name="Umsatzwert" class="stat-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; flex-direction: column; margin-right: 12px;">
                    <ui:VisualElement name="Auftragsquote" class="stat-card" style="margin-bottom: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Offene Rechnungen" class="stat-title"/>
                            <ui:VisualElement style="flex-grow: 1;"/>
                            <ui:VisualElement name="btn-help-rechnungen" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                        </ui:VisualElement>
                        <ui:Label text="0" name="OffeneRechnungen" class="stat-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; flex-direction: column; margin-right: 12px;">
                    <ui:VisualElement name="Gewinn" class="stat-card" style="margin-bottom: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Gewinn" class="stat-title"/>
                            <ui:VisualElement style="flex-grow: 1;"/>
                            <ui:VisualElement name="btn-help-gewinn" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                        </ui:VisualElement>
                        <ui:Label text="0,00 €" name="Gewinnwert" class="stat-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; flex-direction: column;">
                    <ui:VisualElement name="Liquiditaet" class="stat-card" style="margin-bottom: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="Liquidität" class="stat-title"/>
                            <ui:VisualElement style="flex-grow: 1;"/>
                            <ui:VisualElement name="btn-help-liquiditaet" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                        </ui:VisualElement>
                        <ui:Button text="Zum Kassenbuch →" name="Finanzen1" class="pfad-btn-primary" style="margin-top: 8px; background-color: rgb(128, 207, 149); color: rgb(20, 20, 20); border-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; padding-top: 10px; padding-bottom: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Mittlere Zeile: Top Dienstleistungen + Angebotsstatus -->
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; margin-bottom: 12px; min-height: 140px;">
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0; margin-right: 12px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Top Dienstleistungen" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-dienst" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Ranking" style="flex-grow: 1;"/>
                </ui:VisualElement>
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Status der Angebote" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-angebote" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="StatusAngebot" style="flex-grow: 1;"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Charts 2x2 Grid -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-bottom: 12px;">

                <!-- Finanzen im Überblick -->
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0; margin-right: 12px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Finanzen im Überblick" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-chart" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="chart-container" class="chart-container">
                        <ui:VisualElement name="chart-y-axis" class="chart-y-axis">
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="diagramm" class="chart-canvas"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="chart-x-axis" class="chart-x-axis">
                        <ui:Label text="Jan" class="chart-month-label"/>
                        <ui:Label text="Feb" class="chart-month-label"/>
                        <ui:Label text="Mär" class="chart-month-label"/>
                        <ui:Label text="Apr" class="chart-month-label"/>
                        <ui:Label text="Mai" class="chart-month-label"/>
                        <ui:Label text="Jun" class="chart-month-label"/>
                        <ui:Label text="Jul" class="chart-month-label"/>
                        <ui:Label text="Aug" class="chart-month-label"/>
                        <ui:Label text="Sep" class="chart-month-label"/>
                        <ui:Label text="Okt" class="chart-month-label"/>
                        <ui:Label text="Nov" class="chart-month-label"/>
                        <ui:Label text="Dez" class="chart-month-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Kapitalbedarf (Pie) -->
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Kapitalbedarf" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-kapital" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                        <ui:VisualElement name="Diagramm2" style="flex-grow: 1; position: relative;"/>
                        <ui:VisualElement name="pie-legende" style="flex-grow: 0; width: 120px; flex-direction: column; justify-content: center; padding-left: 8px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">

                <!-- Rohgewinn -->
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0; margin-right: 12px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Rohgewinn" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-rohgewinn" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="rohgewinn-container" class="chart-container">
                        <ui:VisualElement name="rohgewinn-y-axis" class="chart-y-axis">
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="diagramm3" class="chart-canvas"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="rohgewinn-x-axis" class="chart-x-axis">
                        <ui:Label text="Jan" class="chart-month-label"/>
                        <ui:Label text="Feb" class="chart-month-label"/>
                        <ui:Label text="Mär" class="chart-month-label"/>
                        <ui:Label text="Apr" class="chart-month-label"/>
                        <ui:Label text="Mai" class="chart-month-label"/>
                        <ui:Label text="Jun" class="chart-month-label"/>
                        <ui:Label text="Jul" class="chart-month-label"/>
                        <ui:Label text="Aug" class="chart-month-label"/>
                        <ui:Label text="Sep" class="chart-month-label"/>
                        <ui:Label text="Okt" class="chart-month-label"/>
                        <ui:Label text="Nov" class="chart-month-label"/>
                        <ui:Label text="Dez" class="chart-month-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Rentabilität (Bar) -->
                <ui:VisualElement class="panel-half" style="flex-grow: 1; flex-basis: 0;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:Label text="Rentabilität" class="panel-title"/>
                        <ui:VisualElement style="flex-grow: 1;"/>
                        <ui:VisualElement name="btn-help-rentab" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="rentab-container" class="chart-container">
                        <ui:VisualElement name="rentab-y-axis" class="chart-y-axis">
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                            <ui:Label text="€0" class="chart-axis-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="diagramm4" class="chart-canvas"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="rentab-x-axis" class="chart-x-axis">
                        <ui:Label text="Jahr 1" class="chart-month-label"/>
                        <ui:Label text="Jahr 2" class="chart-month-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
