<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Gruendungspfad.uss?fileID=7433441132597879392&amp;guid=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb&amp;type=3#Gruendungspfad"/>

    <ui:VisualElement name="root-container" style="flex-grow:1; background-color: rgb(30,30,30);">
        <ui:VisualElement name="main-content" style="flex:1; flex-direction:column; padding: 30px 40px 20px 430px;">

            <!-- Seitenheader -->
            <ui:VisualElement style="flex-direction:row; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <ui:VisualElement>
                    <ui:Label text="Gründungspfad" class="page-title"/>
                    <ui:Label text="Deine persönliche Roadmap von der Idee zur erfolgreichen Gründung" class="page-subtitle"/>
                </ui:VisualElement>
                <ui:Button text="+ Eigenen Schritt hinzufügen" name="btn-schritt-hinzufuegen" class="pfad-btn-primary"/>
            </ui:VisualElement>

            <!-- Gesamtfortschrittsbalken -->
            <ui:VisualElement class="gesamt-fortschritt-box">
                <ui:VisualElement style="flex-direction:row; justify-content:space-between; margin-bottom:8px;">
                    <ui:Label text="Gesamtfortschritt" class="fortschritt-header-label"/>
                    <ui:Label text="0% abgeschlossen" name="lbl-gesamtfortschritt" class="fortschritt-prozent-label"/>
                </ui:VisualElement>
                <ui:VisualElement class="fortschritt-balken-bg">
                    <ui:VisualElement name="fortschritt-balken-fill" class="fortschritt-balken-fill" style="width:0%;"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Phasenkarten (per Code befüllt) -->
            <ui:ScrollView style="flex-grow:1; margin-top:16px;">
                <ui:VisualElement name="main-container"/>
            </ui:ScrollView>

        </ui:VisualElement>

        <!-- Neuer-Schritt-Popup -->
        <ui:VisualElement name="neuer-schritt-popup" class="popup-overlay" style="display:none;">
            <ui:VisualElement class="pfad-popup-box">
                <ui:Label text="Eigenen Schritt hinzufügen" class="pfad-popup-title"/>

                <ui:VisualElement class="pfad-form-group">
                    <ui:Label text="Titel *" class="pfad-field-label"/>
                    <ui:TextField label="" placeholder-text="z.B. Logo erstellen" name="neuer-schritt-titel"/>
                </ui:VisualElement>

                <ui:VisualElement class="pfad-form-group">
                    <ui:Label text="Beschreibung (optional)" class="pfad-field-label"/>
                    <ui:TextField label="" placeholder-text="Kurze Erklärung..." name="neuer-schritt-beschreibung" multiline="true" style="min-height:64px;"/>
                </ui:VisualElement>

                <ui:VisualElement class="pfad-form-group">
                    <ui:Label text="Phase" class="pfad-field-label"/>
                    <ui:DropdownField label="" name="neuer-schritt-phase" class="pfad-dropdown"/>
                </ui:VisualElement>

                <ui:VisualElement style="flex-direction:row; justify-content:flex-end; gap:12px; margin-top:16px;">
                    <ui:Button text="Abbrechen" name="btn-neuer-schritt-abbrechen" class="pfad-btn-secondary"/>
                    <ui:Button text="Hinzufügen" name="btn-neuer-schritt-speichern" class="pfad-btn-primary"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
