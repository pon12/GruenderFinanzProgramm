<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Grid%20System/GridSystem.uss?fileID=7433441132597879392&amp;guid=d3dab0810f9c6274990ca4455b3a7372&amp;type=3#GridSystem"/>
    <Style src="project://database/Assets/Styles/USS-Main.uss?fileID=7433441132597879392&amp;guid=09df5e34da794d44e85d99fbe225ca8b&amp;type=3#USS-Main"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Dienstleistungen.uss?fileID=7433441132597879392&amp;guid=01fec56cd8896774fab0da40d32297db&amp;type=3#Dienstleistungen"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Helptooltip.uss?fileID=7433441132597879392&amp;guid=93ae44093179d5b4abba4a8128fdc6da&amp;type=3#Helptooltip"/>
    <ui:VisualElement name="root" style="width: 100%; height: 100%; flex-direction: column; background-color: rgb(30, 30, 30);">
        <ui:VisualElement name="main-content" style="flex-grow: 1; flex-direction: column; padding-left: 430px; padding-right: 40px; padding-top: 40px; padding-bottom: 40px;">
            <ui:VisualElement name="row-kopfzeile" style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                <ui:Label text="Dienstleistungen" name="label-titel" class="page-title" style="margin-bottom: 0;"/>
                <ui:VisualElement name="btn-help-seitentitel" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px; top: 6px; right: 7px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="row-neu-button" style="flex-direction: row; align-items: center; justify-content: flex-end; margin-bottom: 16px;">
                <ui:Button name="btn-neu" text="Neue Dienstleistung" emoji-fallback-support="false" class="add-btn" style="margin-bottom: 0;"/>
                <ui:VisualElement name="btn-help-neu" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 36px; height: 36px; min-width: 36px; min-height: 36px; flex-shrink: 0; margin-left: 8px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="tabelle-wrapper" class="tabelle-wrapper">
                <ui:VisualElement name="tabelle-header" class="tabelle-header" style="background-color: rgb(44, 44, 44);">
                    <ui:VisualElement name="col-titel" class="col-titel" style="flex-direction: row; align-items: center;">
                        <ui:Label text="Name" name="label-header-name" class="tabelle-header-zelle" style="flex-grow: 1; justify-content: center; align-self: center; align-content: center; align-items: center; -unity-text-align: middle-center; margin-right: -121px;"/>
                        <ui:VisualElement name="btn-help-name" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 4px; margin-right: 69px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="col-beschreibung" class="col-beschreibung" style="flex-direction: row; align-items: center; justify-content: center;">
                        <ui:Label text="Beschreibung" name="label-header-beschreibung" class="tabelle-header-zelle" style="-unity-text-align: middle-center;"/>
                        <ui:VisualElement name="btn-help-beschreibung" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 4px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="col-preismodell" class="col-preismodell" style="flex-direction: row; align-items: center; justify-content: center;">
                        <ui:Label text="Preismodell" name="label-header-preismodell" class="tabelle-header-zelle" style="-unity-text-align: middle-center;"/>
                        <ui:VisualElement name="btn-help-preismodell" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 4px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="col-betrag" class="col-betrag" style="flex-direction: row; align-items: center; justify-content: center;">
                        <ui:Label text="Betrag" name="label-header-betrag" class="tabelle-header-zelle" style="-unity-text-align: middle-center;"/>
                        <ui:VisualElement name="btn-help-betrag" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 4px;"/>
                    </ui:VisualElement>
                    <ui:Label text="Aktionen" name="label-header-aktionen" class="tabelle-header-zelle col-aktionen" style="-unity-text-align: middle-center; display: none;"/>
                </ui:VisualElement>
                <ui:ScrollView name="tabelle-body" style="flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="popup-overlay" class="popup-overlay" style="display: none;">
            <ui:VisualElement name="container-popup" class="popup-box">
                <ui:Button name="btn-close-popup" text="✕" class="close-btn"/>
                <ui:VisualElement name="row-popup-titel" style="flex-direction: row; align-items: center; margin-bottom: 8px; margin-right: 8px;">
                    <ui:Label text="Dienstleistung" name="label-popup-titel" class="popup-titel" style="margin-bottom: 0; margin-top: 0; margin-right: 16px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    <ui:VisualElement name="btn-help-popup" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 0; align-self: auto; align-items: stretch;"/>
                </ui:VisualElement>
                <ui:Label text="Name" name="label-feld-titel" class="popup-label"/>
                <ui:TextField name="feld-titel" placeholder-text="Name" hide-placeholder-on-focus="true" class="popup-input"/>
                <ui:Label text="Beschreibung" name="label-feld-beschreibung" class="popup-label"/>
                <ui:TextField name="feld-beschreibung" placeholder-text="Beschreibung" hide-placeholder-on-focus="true" class="popup-input"/>
                <ui:VisualElement name="row-preismodell" style="flex-direction: row; align-items: center; margin-right: 8px;">
                    <ui:Label text="Preismodell" name="label-feld-preismodell" class="popup-label" style="flex-grow: 1; margin-bottom: 0;"/>
                    <ui:VisualElement name="btn-help-preismodell-popup" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 8px; margin-bottom: 6px; margin-right: 0;"/>
                </ui:VisualElement>
                <ui:DropdownField name="feld-preismodell" choices="Festpreis,Stundensatz,Pauschal" index="0" class="popup-dropdown"/>
                <ui:Label text="Betrag" name="label-feld-betrag" class="popup-label"/>
                <ui:TextField name="feld-betrag" placeholder-text="Betrag" hide-placeholder-on-focus="true" class="popup-input"/>
                <ui:VisualElement name="row-popup-buttons" style="flex-grow: 1; flex-direction: row;">
                    <ui:Button name="btn-abbrechen" text="Abbrechen" class="popup-btn-abbrechen"/>
                    <ui:Button name="btn-fertig" text="Fertig" class="popup-btn-fertig"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

