.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    align-items: flex-start;
    align-content: flex-start;
    overflow: hidden;
}

.grid-item {
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 16px;
    overflow: hidden;
    flex-shrink: 1;
    flex-grow: 0;
    min-height: 40px;
}

.col-3 {
    width: 23%;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.col-4 {
    width: 30%;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.col-6 {
    width: 45%;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.col-8 {
    width: 63%;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.col-12 {
    width: 96%;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0;
    padding: 0;
}

.grid-item Label {
    white-space: normal;
    overflow: hidden;
}

