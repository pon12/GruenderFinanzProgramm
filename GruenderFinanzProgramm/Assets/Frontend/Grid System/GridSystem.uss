

/* GRID CONTAINER */
.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    align-items: flex-start;
    align-content: flex-start;
    overflow: hidden;
}

/* GRID ITEM -> Basis für alle Boxen */
.grid-item {
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 16px;
    overflow: hidden;
    flex-shrink: 1;
    flex-grow: 0;
    min-height: 40px;
}

/* SPALTEN */
.col-3  { width: 23%; flex-shrink: 0; flex-grow: 0; }
.col-4  { width: 30%; flex-shrink: 0; flex-grow: 0; }
.col-6  { width: 45%; flex-shrink: 0; flex-grow: 0; }
.col-8  { width: 63%; flex-shrink: 0; flex-grow: 0; }
.col-12 { width: 96%; flex-shrink: 0; flex-grow: 0; }

/* TEXT - Immer umbrechen, nie aus Box herauslaufen */
.grid-item Label {
    white-space: normal;
    overflow: hidden;
}

/* Volle Breite, wächst mit dem Fenster */
.responsive {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    position: relative;
}

/* Füllt den gesamten verfügbaren Platz */
.fill {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
}

/* Zentriert sich automatisch im Fenster */
.center {
    align-self: center;
    justify-content: center;
    align-items: center;
}

/* Klebt oben links */
.anchor-top-left {
    position: absolute;
    left: 0;
    top: 0;
}

/* Klebt oben rechts */
.anchor-top-right {
    position: absolute;
    right: 0;
    top: 0;
}

/* Klebt unten links */
.anchor-bottom-left {
    position: absolute;
    left: 0;
    bottom: 0;
}

/* Klebt unten rechts */
.anchor-bottom-right {
    position: absolute;
    right: 0;
    bottom: 0;
}

/* Volle Breite & Höhe -> z.B. für Hintergrund-Panels */
.fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

