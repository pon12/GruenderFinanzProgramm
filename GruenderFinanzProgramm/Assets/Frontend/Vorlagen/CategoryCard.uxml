<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/Helptooltip.uss?fileID=7433441132597879392&amp;guid=93ae44093179d5b4abba4a8128fdc6da&amp;type=3#Helptooltip"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Doc-Screen.uss?fileID=7433441132597879392&amp;guid=7f80ac4667a2566429f65c50cc73fc61&amp;type=3#Doc-Screen"/>
    <ui:VisualElement class="doc-card category-card" style="background-color: rgb(44, 44, 44);">
        <ui:VisualElement class="category-header-row">
            <ui:VisualElement name="Btn-Show-List" class="category-icon-tile">
                <ui:Label text="📁" class="category-icon-glyph"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
                <ui:VisualElement style="flex-direction: row; align-items: center; gap: 6px;">
                    <ui:Label text="Card Name" name="lblName" class="category-title"/>
                    <ui:VisualElement name="lock-badge" class="lock-badge" style="display: none;">
                        <ui:Label text="🔒" class="lock-badge-glyph"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="Kategorie" class="category-meta"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1;"/>

        </ui:VisualElement>
        <ui:VisualElement class="category-doc-grid-2x2">
            <ui:VisualElement name="Slot-0" class="doc-mini-slot">
                <ui:VisualElement name="Slot-0-Icon"    class="doc-mini-icon"/>
                <ui:VisualElement name="Slot-0-Content" class="doc-mini-content"/>
                <ui:Button        name="Slot-0-Plus" text="+" class="doc-mini-plus"/>
            </ui:VisualElement>
            <ui:VisualElement name="Slot-1" class="doc-mini-slot">
                <ui:VisualElement name="Slot-1-Icon"    class="doc-mini-icon"/>
                <ui:VisualElement name="Slot-1-Content" class="doc-mini-content"/>
                <ui:Button        name="Slot-1-Plus" text="+" class="doc-mini-plus"/>
            </ui:VisualElement>
            <ui:VisualElement name="Slot-2" class="doc-mini-slot">
                <ui:VisualElement name="Slot-2-Icon"    class="doc-mini-icon"/>
                <ui:VisualElement name="Slot-2-Content" class="doc-mini-content"/>
                <ui:Button        name="Slot-2-Plus" text="+" class="doc-mini-plus"/>
            </ui:VisualElement>
            <ui:VisualElement name="Slot-3" class="doc-mini-slot">
                <ui:VisualElement name="Slot-3-Icon"    class="doc-mini-icon"/>
                <ui:VisualElement name="Slot-3-Content" class="doc-mini-content"/>
                <ui:Button        name="Slot-3-Plus" text="+" class="doc-mini-plus"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Alle anzeigen" name="btnPlus" class="doc-btn-add-inline"/>
    </ui:VisualElement>
</ui:UXML>
