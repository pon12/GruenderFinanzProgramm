<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Frontend/Stylesheets/Helptooltip.uss?fileID=7433441132597879392&amp;guid=93ae44093179d5b4abba4a8128fdc6da&amp;type=3#Helptooltip"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Row-Template.uss?fileID=7433441132597879392&amp;guid=9678bb8acbf77654590b8c70e51f738c&amp;type=3#Row-Template"/>
    <Style src="project://database/Assets/Frontend/Stylesheets/Export.uss?fileID=7433441132597879392&amp;guid=e53311dd580cb0946819483f8bd7dc3b&amp;type=3#Export"/>
    <ui:VisualElement name="row-item" class="tabelle-zeile">
        <ui:Label text="Label" name="row-bezeichnung" class="col-bezeichnung tabelle-zelle"/>
        <ui:Label text="Label" name="row-art" class="col-art tabelle-zelle"/>
        <ui:Label text="Label" name="row-datum" class="col-datum tabelle-zelle"/>
        <ui:VisualElement name="format-container" class="col-format" style="flex-direction: row; align-items: center; justify-content: center;">
            <ui:DropdownField label="" name="format-dropdown" choices="PDF" class="format-dropdown"/>
        </ui:VisualElement>
        <ui:VisualElement name="actions-container" class="col-pfad" style="flex-direction: row; align-items: center; justify-content: flex-end;">
            <ui:Button text="" name="btn-open-folder" class="btn-folder" style="background-image: resource(&quot;Icons/folder&quot;); background-size: 60% 60%;"/>
            <ui:VisualElement name="btn-help-export-btn" class="help-icon" style="background-image: url(&quot;project://database/Assets/Frontend/Bilder/Help%20circle.png?fileID=2800000&amp;guid=1ea511ec5bd6a8148ab87a586b001f57&amp;type=3#Help circle&quot;); width: 28px; height: 28px; min-width: 28px; min-height: 28px; flex-shrink: 0; margin-left: 8px; margin-right: 8px;"/>
            <ui:Button text="Exportieren" name="btn-export" class="zeile-btn-bearbeiten" style="margin-right: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
