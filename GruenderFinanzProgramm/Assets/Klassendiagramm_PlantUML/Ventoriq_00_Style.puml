' Ventoriq_00_Style.puml
' Gemeinsamer Stil für alle Ventoriq-Klassendiagramme

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 160
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam handwritten false

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F2D3D
  ArrowColor #1F2D3D
  FontColor #111827
  HeaderBackgroundColor #F3F4F6
}

skinparam package {
  BorderColor #CBD5E1
  BackgroundColor #F8FAFC
  FontColor #0F172A
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
  FontColor #111827
}

skinparam stereotypeCBackgroundColor #FFFFFF

hide empty members
hide circle

' Legende:
' -->   direkte Beziehung / Aufruf / CRUD
' ..>   indirekte Abhängigkeit / Nutzung / Konvertierung
' <|--  Vererbung
' *--   Komposition
' o--   Aggregation