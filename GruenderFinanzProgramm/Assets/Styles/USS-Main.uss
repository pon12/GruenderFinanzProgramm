:root {
    --primary-color: rgb(128, 207, 149);
    --secondary-color: rgb(100, 100, 100);
}

.h1 {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=3621564315749d341aeb8593daa0ea7f&type=3#Poppins-Bold");
    -unity-font-style: bold;
    font-size: 32px;
    color: var(--primary-color);
    -unity-text-align: upper-left;
    margin-bottom: 20px;
    margin-top: 10px;
}

.h2 {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    font-size: 24px;
    color: var(--primary-color);
    margin-top: 20px;
    margin-bottom: 0;
}

.body {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=208850aa048ae4a4a897f2e5fb1d9380&type=3#Poppins-Regular");
    font-size: 14px;
    color: var(--primary-color);
}

.table-header {
    -unity-font-definition: url("project://database/Assets/Fonts/Poppins-SemiBold.ttf?fileID=12800000&guid=8cf7aafec04adfb46bae3114f5129d41&type=3#Poppins-SemiBold");
    font-size: 24px;
    font-weight: bold;
    color: var(--primary-color);
    width: 100%;
}

.table-row {
    width: 100%;
    border-color: #505050;
    border-bottom-width: 2px;
}

.col-name {
    width: 30%;
    flex: none;
    -unity-text-align: upper-center;
    overflow: hidden;
}

.col-datum {
    width: 20%;
    flex: none;
    -unity-text-align: upper-center;
    overflow: hidden;
}

.col-betrag {
    width: 20%;
    flex: none;
    -unity-text-align: upper-center;
    overflow: hidden;
}

.col-typ {
    width: 18%;
    flex: none;
    -unity-text-align: upper-center;
    overflow: hidden;
}

.col-action {
    width: 10%;
    flex: none;
    -unity-text-align: upper-center;
    overflow: hidden;
}

.unity-scroll-view__horizontal-scroller {
    display: none;
}

.unity-scroll-view__vertical-scroller {
    width: 2%;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(128, 207, 149);
    border-radius: 4px;
    min-height: 20px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(40, 40, 40);
}

/* =============================================
   Button-Hover-Klassen
   Nur Buttons mit explizit gesetzter Klasse.
   Grau  → grüner Rahmen
   Grün  → heller Hintergrund
   Rot   → heller Hintergrund
   ============================================= */

.btn-hover-outline,
.btn-hover-green,
.btn-hover-darkgreen,
.btn-hover-red {
    transition-property: background-color, border-color,
                         border-top-width, border-right-width,
                         border-bottom-width, border-left-width;
    transition-duration: 0.12s;
}

.btn-hover-outline:hover {
    border-top-color: rgb(128, 207, 149);
    border-right-color: rgb(128, 207, 149);
    border-bottom-color: rgb(128, 207, 149);
    border-left-color: rgb(128, 207, 149);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.btn-hover-green:hover,
.btn-hover-darkgreen:hover {
    background-color: rgb(160, 220, 175);
}

.btn-hover-red:hover {
    background-color: rgb(240, 100, 110);
}



